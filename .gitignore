# ReservaYa monorepo — ignores raíz
node_modules/
.next/
dist/
.astro/
.vercel/
out/
coverage/

# .NET
**/bin/
**/obj/
**/TestResults/

# env — nunca subir
.env
.env*.local
.env.local
.env.production

# TS / Next artifacts
*.tsbuildinfo
next-env.d.ts

# Uploads de usuarios (fotos de canchas) — no versionar, sí la carpeta
# (se ignora el contenido pero no los directorios, para que el !.gitkeep aplique)
apps/api-dotnet/wwwroot/uploads/*
!apps/api-dotnet/wwwroot/uploads/*/
apps/api-dotnet/wwwroot/uploads/*/*
!apps/api-dotnet/wwwroot/uploads/*/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
*.pem
npm-debug.log*

# Infraestructura del piso de agentes (Munder Difflin) — no es código de producto
.claude/
.idea/
hive/
roster.json
roster-backups/

# Estado local del harness de agentes; no es producto
restore-gate.json

# pnpm/Turborepo
.turbo/
.pnpm-store/
packages/db/prisma/generated/

# Artefactos/uploads de servicios legacy todavía en ejecución
apps/api/wwwroot/uploads/

# QA y secretos de cualquier carpeta
*.env
qa.env
.qa-env
!.env.example
!**/.env.example
