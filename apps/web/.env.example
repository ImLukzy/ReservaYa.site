# Base de datos PostgreSQL (usar Neon.tech gratis)
# DATABASE_URL: conexión POOLED para la app (transacciones por request)
DATABASE_URL="postgresql://user:password@host-pooler:5432/reservafacil?sslmode=require"

# DATABASE_URL_UNPOOLED: conexión directa (sin pooler); conservar esquema existente, sin migraciones ni seed en esta tarea
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/reservafacil?sslmode=require"

# JWT Secret (string aleatorio largo)
JWT_SECRET="tu_secreto_super_largo_aqui_minimo_32_caracteres"

# URL de producción (Vercel te la da)
NEXTAUTH_URL="https://tu-proyecto.vercel.app"

# URL interna de la API ASP.NET Core para Server Components
BACKEND_URL="http://localhost:5000"
FRONTEND_ORIGIN="http://localhost:3000"
# Compatibilidad: la navegación pública/panel usa rutas locales
NEXT_PUBLIC_PUBLIC_APP_URL=""
# Opcional: WhatsApp de soporte (solo dígitos con código de país, p. ej. 51987654321). Vacío = sin botón de WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=""
# Usar true cuando frontend y API se sirven exclusivamente por HTTPS
COOKIE_SECURE="false"

# Recuperación de contraseña (API). "log" escribe el enlace en la consola (solo Development).
EMAIL_PROVIDER="log"
RESEND_API_KEY=""
EMAIL_FROM="ReservaYa <no-reply@tu-dominio-verificado>"
PASSWORD_RESET_URL="http://localhost:3000/reset-password"

# Seed de desarrollo (opcionales; sin esto usa claves débiles locales)
# SEED_SUPERADMIN_PASSWORD="cambia-esto"
# SEED_ADMIN_PASSWORD="cambia-esto"
# SEED_USUARIO_PASSWORD="cambia-esto"
# SEED_TECNICO_PASSWORD="cambia-esto"
# Solo para seed en producción (nunca "true" en local)
# ALLOW_PROD_SEED="false"

# Web pública: solo valores públicos, opcionales; cambios requieren build nuevo.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_INBOXMEJIKAI_ENDPOINT=""
