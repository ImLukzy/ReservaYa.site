# Plantilla local compartida por Next y el runner de la API. Solo placeholders.
# En producción configura cada grupo en su plataforma; no subas el .env real.

# WEB — Vercel Root Directory: apps/web; Framework: Next.js.
# Producción: origen HTTPS de Render, sin /api ni barra final.
BACKEND_URL="http://localhost:5000"
# Debe ser EXACTAMENTE el mismo secreto privado de Render, mínimo 32 caracteres.
JWT_SECRET="REEMPLAZAR_POR_UN_SECRETO_PRIVADO_DE_32_O_MAS_CARACTERES"
# API crea las cookies; Next no lee esta variable. false local, true HTTPS/Render.
COOKIE_SECURE="false"

# Públicos opcionales de Next; cambios requieren nuevo build.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_INBOXMEJIKAI_ENDPOINT=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# API — Render. Estas conexiones NO se necesitan en la web de Vercel.
# Runtime: conexión pooled de Neon. Operaciones manuales de esquema: directa.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST-pooler:5432/BASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=require"
FRONTEND_ORIGIN="http://localhost:3000"
# Render: EMAIL_PROVIDER=resend y remitente de dominio verificado.
# log solo en Development; no envía correo real.
EMAIL_PROVIDER="log"
RESEND_API_KEY=""
EMAIL_FROM="ReservaYa <no-reply@example.com>"
PASSWORD_RESET_URL="http://localhost:3000/reset-password"

# Google OAuth opcional: las tres variables juntas habilitan el proveedor.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Registrar esta URL exacta en Google para local; producción usa reservaya.site.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
