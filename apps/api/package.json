{
  "name": "@reservaya/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-fastify": "11.1.6",
    "@reservaya/db": "workspace:*",
    "@reservaya/shared": "workspace:*",
    "fastify": "5.4.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/multipart": "9.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "bcryptjs": "3.0.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.15.32",
    "vitest": "3.2.4",
    "vite": "6.1.0",
    "@nestjs/testing": "11.1.6",
    "@reservaya/config": "workspace:*",
    "supertest": "7.1.4",
    "@types/supertest": "6.0.3"
  }
}
