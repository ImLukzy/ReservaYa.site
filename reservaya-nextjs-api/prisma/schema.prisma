generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// USUARIO=jugador B2C | PERSONAL=recepción (agenda + caja diaria, sin ganancias)
// ADMIN=dueño B2B | SUPERADMIN=plataforma
enum Rol {
  USUARIO
  PERSONAL
  ADMIN
  SUPERADMIN
  TECNICO
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  PARCIAL
  REEMBOLSADO
}

enum MetodoPago {
  EFECTIVO
  YAPE
  CULQI
  TARJETA
  TRANSFERENCIA
}

enum TipoCancha {
  FUTBOL
  FUTBOL5
  FUTBOL7
  PADEL
  TENIS
  BASQUET
  VOLLEYBALL
  LOZA
}

enum TipoMovimiento {
  RESERVA
  SNACK
  ALQUILER
  ABONO
  EGRESO
  AJUSTE
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum EstadoTorneo {
  BORRADOR
  INSCRIPCIONES_ABIERTAS
  EN_CURSO
  FINALIZADO
  CANCELADO
}

enum TipoDescuento {
  PORCENTAJE
  MONTO_FIJO
  PRECIO_ESPECIAL
}

enum TipoMeta {
  INGRESOS
  OCUPACION
  RESERVAS
}

enum TipoPlan {
  MENSUAL
  TRIMESTRAL
  ANUAL
}

enum EstadoSuscripcion {
  PENDIENTE
  ACTIVA
  VENCIDA
  CANCELADA
  RECHAZADA
}

enum NivelSancion {
  ADVERTENCIA
  BLOQUEO
}

model Usuario {
  id            String    @id @default(cuid())
  nombre        String
  email         String    @unique
  password      String
  rol           Rol       @default(USUARIO)
  activo        Boolean   @default(true)
  tokenVersion  Int       @default(0)
  creadoEn      DateTime  @default(now())
  fechaNacimiento DateTime? @db.Date
  username      String?   @unique
  usernameCambiadoEn DateTime?
  telefono      String?
  fotoUrl       String?

  reservas           Reserva[]
  resenas            Resena[]
  complejosPropios   Complejo[]          @relation("DuenoComplejos")
  membresias         ComplejoMiembro[]
  cajasAbiertas      CajaSesion[]        @relation("AperturaCaja")
  movimientosCreados MovimientoCaja[]
  validaciones       Reserva[]           @relation("ValidadorReservas")
  inscripciones      InscripcionTorneo[] @relation("CapitanInscripciones")
  sancionesRecibidas Sancion[]

  @@index([rol])
}

model Complejo {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  direccion     String
  distrito      String
  ciudad        String   @default("Arequipa")
  telefono      String?
  email         String?
  fotos         String[] @default([])
  publicado     Boolean  @default(false)
  slug          String   @unique
  duenoId       String
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  dueno       Usuario           @relation("DuenoComplejos", fields: [duenoId], references: [id], onDelete: Restrict)
  canchas     Cancha[]
  miembros    ComplejoMiembro[]
  productos   Producto[]
  cajas       CajaSesion[]
  movimientos MovimientoCaja[]
  promociones Promocion[]
  resenas     Resena[]
  torneos     Torneo[]
  metas       Meta[]
  reservas    Reserva[]
  suscripciones Suscripcion[]
  sanciones Sancion[]
  horarios  HorarioOperativo[]

  @@index([duenoId])
  @@index([publicado])
  @@index([distrito])
}

model ComplejoMiembro {
  id         String   @id @default(cuid())
  usuarioId  String
  complejoId String
  rolSede    Rol
  activo     Boolean  @default(true)
  creadoEn   DateTime @default(now())

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  complejo Complejo @relation(fields: [complejoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, complejoId])
  @@index([complejoId])
}

model Cancha {
  id            String     @id @default(cuid())
  nombre        String
  tipo          TipoCancha
  descripcion   String?
  precioPorHora Decimal    @db.Decimal(10, 2)
  capacidad     Int
  techada       Boolean    @default(false)
  superficie    String?
  activa        Boolean    @default(true)
  imagen        String?
  fotos         String[]   @default([])
  // Nullable para backfill de datos legacy. Tras migrar: volver NOT NULL.
  complejoId    String?
  creadoEn      DateTime   @default(now())

  complejo    Complejo?       @relation(fields: [complejoId], references: [id], onDelete: Restrict)
  reservas    Reserva[]
  promociones Promocion[]
  partidosTorneo PartidoTorneo[]

  @@index([tipo])
  @@index([activa])
  @@index([complejoId])
}

model Reserva {
  id          String        @id @default(cuid())
  codigo      String        @unique(map: "Reserva_codigo_idx") // QR recepción: "RF-8K2P", generado en API. Único con nombre vivo (no duplicar con @@index).
  usuarioId   String
  canchaId    String
  complejoId  String?
  fecha       DateTime      @db.Date
  // Minutos desde medianoche: 480 = "08:00". Evita comparaciones frágiles de texto.
  horaInicio  Int
  horaFin     Int
  estado      EstadoReserva @default(PENDIENTE)
  estadoPago  EstadoPago    @default(PENDIENTE)
  metodoPago  MetodoPago?
  total       Decimal       @db.Decimal(10, 2)
  montoPagado Decimal       @default(0) @db.Decimal(10, 2)
  notas       String?
  promocionId String?
  creadoEn    DateTime      @default(now())

  validadaEn    DateTime?
  validadaPorId String?

  validadaPor Usuario?   @relation("ValidadorReservas", fields: [validadaPorId], references: [id])
  usuario     Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  cancha      Cancha     @relation(fields: [canchaId], references: [id], onDelete: Restrict)
  complejo    Complejo?  @relation(fields: [complejoId], references: [id], onDelete: Restrict)
  promocion   Promocion? @relation(fields: [promocionId], references: [id], onDelete: SetNull)
  movimientos MovimientoCaja[]

  // Acelera el cruce de horarios y los reportes.
  @@index([canchaId, fecha])
  @@index([complejoId, fecha])
  @@index([usuarioId])
  @@index([estado])
}

model Producto {
  id         String  @id @default(cuid())
  complejoId String
  nombre     String
  categoria  String  @default("SNACK") // SNACK | ALQUILER | SERVICIO
  precio     Decimal @db.Decimal(10, 2)
  stock      Int?
  activo     Boolean @default(true)

  complejo Complejo @relation(fields: [complejoId], references: [id], onDelete: Cascade)
  movimientos MovimientoCaja[]

  @@index([complejoId, activo])
}

model CajaSesion {
  id           String     @id @default(cuid())
  complejoId   String
  abiertaPorId String
  cerradaPorId String?
  montoInicial Decimal    @db.Decimal(10, 2)
  montoFinal   Decimal?   @db.Decimal(10, 2)
  estado       EstadoCaja @default(ABIERTA)
  abiertaEn    DateTime   @default(now())
  cerradaEn    DateTime?

  complejo    Complejo         @relation(fields: [complejoId], references: [id], onDelete: Restrict)
  abiertaPor  Usuario          @relation("AperturaCaja", fields: [abiertaPorId], references: [id])
  movimientos MovimientoCaja[]

  @@index([complejoId, estado])
}

model MovimientoCaja {
  id          String         @id @default(cuid())
  complejoId  String
  cajaId      String
  tipo        TipoMovimiento
  metodoPago  MetodoPago     @default(EFECTIVO)
  monto       Decimal        @db.Decimal(10, 2)
  descripcion String
  creadoPorId String
  reservaId   String?
  productoId  String?
  creadoEn    DateTime       @default(now())

  complejo  Complejo   @relation(fields: [complejoId], references: [id], onDelete: Restrict)
  caja      CajaSesion @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  creadoPor Usuario    @relation(fields: [creadoPorId], references: [id])
  reserva   Reserva?   @relation(fields: [reservaId], references: [id], onDelete: SetNull)
  producto  Producto?  @relation(fields: [productoId], references: [id], onDelete: SetNull)

  @@index([cajaId])
  @@index([complejoId, creadoEn])
  @@index([tipo])
}

model Promocion {
  id           String        @id @default(cuid())
  complejoId   String?
  canchaId     String?
  nombre       String
  descripcion  String?
  tipo         TipoDescuento
  valor        Decimal       @db.Decimal(10, 2)
  horaDesde    Int?
  horaHasta    Int?
  diasSemana   Int[]         @default([])
  fechaInicio  DateTime?     @db.Date
  fechaFin     DateTime?     @db.Date
  precioDia    Decimal?      @db.Decimal(10, 2)
  precioTarde  Decimal?      @db.Decimal(10, 2)
  precioNoche  Decimal?      @db.Decimal(10, 2)
  inicioTarde  Int?
  inicioNoche  Int?
  repetirAnual Boolean       @default(false)
  codigo       String?       @unique
  usosMax      Int?
  usosActuales Int           @default(0)
  activa       Boolean       @default(true)
  creadoEn     DateTime      @default(now())

  complejo Complejo? @relation(fields: [complejoId], references: [id], onDelete: Cascade)
  cancha   Cancha?   @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  reservas Reserva[]

  @@index([complejoId, activa])
}

model Suscripcion {
  id          String            @id @default(cuid())
  complejoId  String
  plan        TipoPlan
  estado      EstadoSuscripcion @default(ACTIVA)
  fechaInicio DateTime          @db.Date
  fechaFin    DateTime          @db.Date
  creadoEn    DateTime          @default(now())

  complejo Complejo @relation(fields: [complejoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([complejoId])
}

model Sancion {
  id          String       @id @default(cuid())
  complejoId  String
  usuarioId   String
  nivel       NivelSancion
  motivo      String
  activa      Boolean      @default(true)
  creadoPorId String
  creadoEn    DateTime     @default(now())

  complejo Complejo @relation(fields: [complejoId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([complejoId])
  @@index([usuarioId])
}

model HorarioOperativo {
  id          String   @id @default(cuid())
  complejoId  String
  canchaId    String?
  diaSemana   Int
  aperturaMin Int
  cierreMin   Int
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  complejo Complejo @relation(fields: [complejoId], references: [id], onDelete: Cascade)

  @@index([complejoId])
  @@index([complejoId, canchaId, diaSemana])
  @@map("Horario")
}

model Resena {
  id             String   @id @default(cuid())
  complejoId     String
  usuarioId      String
  puntuacion     Int
  comentario     String?
  respuestaDueno String?
  creadoEn       DateTime @default(now())

  complejo Complejo @relation(fields: [complejoId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([complejoId, usuarioId])
  @@index([complejoId])
}

model Torneo {
  id               String       @id @default(cuid())
  complejoId       String
  nombre           String
  deporte          TipoCancha   @default(FUTBOL7)
  fechaInicio      DateTime     @db.Date
  fechaFin         DateTime?    @db.Date
  costoInscripcion Decimal      @db.Decimal(10, 2) @default(0)
  cupoMax          Int          @default(16)
  premio           String?
  reglamento       String?
  estado           EstadoTorneo @default(BORRADOR)
  creadoEn         DateTime     @default(now())

  complejo      Complejo            @relation(fields: [complejoId], references: [id], onDelete: Cascade)
  inscripciones InscripcionTorneo[]
  partidos      PartidoTorneo[]

  @@index([complejoId, estado])
}

model InscripcionTorneo {
  id        String   @id @default(cuid())
  torneoId  String
  equipo    String
  capitanId String
  telefono  String?
  pagado    Boolean  @default(false)
  creadoEn  DateTime @default(now())

  torneo  Torneo  @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  capitan Usuario @relation("CapitanInscripciones", fields: [capitanId], references: [id])

  @@unique([torneoId, equipo])
  @@index([torneoId])
}

model PartidoTorneo {
  id       String    @id @default(cuid())
  torneoId String
  fase     String
  equipoA  String
  equipoB  String
  golesA   Int?
  golesB   Int?
  fecha    DateTime?
  canchaId String?
  ganador  String?

  torneo Torneo  @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  cancha Cancha? @relation(fields: [canchaId], references: [id], onDelete: SetNull)

  @@index([torneoId, fase])
}

model Meta {
  id            String   @id @default(cuid())
  complejoId    String
  titulo        String
  tipo          TipoMeta
  objetivo      Decimal  @db.Decimal(12, 2)
  actual        Decimal  @default(0) @db.Decimal(12, 2)
  periodoInicio DateTime @db.Date
  periodoFin    DateTime @db.Date

  complejo Complejo @relation(fields: [complejoId], references: [id], onDelete: Cascade)

  @@index([complejoId])
}
