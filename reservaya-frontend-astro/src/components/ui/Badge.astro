---
// Etiqueta de estado. «libre» es el único tono verde. Mismas clases que usan los scripts.
import { INSIGNIA, INSIGNIA_BASE } from "../../lib/estilos";

interface Props {
  tono?: keyof typeof INSIGNIA;
  class?: string;
}

const { tono = "neutro", class: extra = "" } = Astro.props;
---

<span class={`${INSIGNIA_BASE} ${INSIGNIA[tono]} ${extra}`.trim()}><slot /></span>
