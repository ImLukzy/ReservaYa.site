---
// Firma visual compartida con el panel (spec 24/26): croquis de cancha en líneas de
// cal (perímetro, línea media, círculo central) para estados vacíos y de error (spec 31).
// Sin SVG ni imagen. Mismas proporciones que la miniatura de src/scripts/filas.ts.
interface Props {
  class?: string;
}

const { class: extra = "h-24 w-24" } = Astro.props;
---

<div class={`relative flex items-center justify-center overflow-hidden rounded-xl bg-cesped-suave ${extra}`.trim()} aria-hidden="true">
  <span class="absolute inset-4 rounded-sm border border-cesped/40"></span>
  <span class="absolute inset-y-4 left-1/2 w-px -translate-x-1/2 bg-cesped/40"></span>
  <span class="absolute left-1/2 top-1/2 h-10 w-10 -translate-x-1/2 -translate-y-1/2 rounded-full border border-cesped/40"></span>
</div>
