---
// Croquis táctico de cancha (spec 32 L1/L2): croquis a escala grande
// (perímetro, línea media, círculo central, áreas de penal y esquinas)
// colocado como textura ambiental detrás del tablero de libres hoy.
// Geometría pura en Tailwind, sin SVG ni imagen. Diseñado para contrastar
// sobre fondo noche con líneas de césped visibles y nítidas.
interface Props {
  variante?: "hero" | "centro" | "panel";
  deporte?: "FUTBOL" | "FUTBOL5" | "FUTBOL7" | "VOLLEYBALL" | "BASQUET" | "PADEL" | "TENIS" | "LOZA";
}

const { variante = "hero", deporte = "FUTBOL" } = Astro.props;
const tintas = {
  FUTBOL: "text-cesped", FUTBOL5: "text-cesped", FUTBOL7: "text-cesped",
  VOLLEYBALL: "text-mar", BASQUET: "text-miel", PADEL: "text-lima",
  TENIS: "text-arcilla", LOZA: "text-losa",
};
const tinta = tintas[deporte];
// «centro» (spec 49): cancha a todo el ancho detrás de un héroe centrado, como el de Universo.
const caja = variante === "centro"
  ? "hero-patron absolute inset-x-0 -bottom-4 top-6 rounded-surface border-2 border-current/40"
  : "hero-patron absolute -bottom-6 right-0 h-80 w-full max-w-xl rounded-surface border-2 border-current/55 sm:h-96 lg:-bottom-4 lg:left-[19rem] lg:right-0 lg:top-8 lg:h-auto lg:w-auto lg:max-w-none";
---

<div class={`pointer-events-none absolute inset-0 overflow-hidden ${tinta}`} data-deporte={deporte} aria-hidden="true">
  {variante !== "panel" ? (
    <div class="mx-auto h-full max-w-page px-4 md:px-6">
      <div class="relative h-full w-full">
        <!-- Cancha táctica detrás del tablero de libres hoy -->
        <div class={caja}>
          <!-- Línea perimetral interior -->
          <div class="absolute inset-3 rounded-surface border border-current/40 sm:inset-5"></div>
          <!-- Línea media de cal -->
          <div class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-current/50"></div>
          <!-- Círculo central -->
          <div class="absolute left-1/2 top-1/2 h-36 w-36 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-current/60 sm:h-48 sm:w-48 lg:h-60 lg:w-60"></div>
          <!-- Punto de penal central -->
          <div class="absolute left-1/2 top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-current/70"></div>
          <!-- Área grande izquierda -->
          <div class="absolute inset-y-1/4 left-0 w-20 rounded-r-surface border-y-2 border-r-2 border-current/45 sm:w-28 lg:w-40"></div>
          <!-- Área chica izquierda -->
          <div class="absolute inset-y-1/3 left-0 w-8 rounded-r-control border-y border-r border-current/35 sm:w-12 lg:w-16"></div>
          <!-- Área grande derecha -->
          <div class="absolute inset-y-1/4 right-0 w-20 rounded-l-surface border-y-2 border-l-2 border-current/45 sm:w-28 lg:w-40"></div>
          <!-- Área chica derecha -->
          <div class="absolute inset-y-1/3 right-0 w-8 rounded-l-control border-y border-l border-current/35 sm:w-12 lg:w-16"></div>
          <!-- Arcos de esquina -->
          <div class="absolute left-0 top-0 h-5 w-5 rounded-br-full border-b-2 border-r-2 border-current/45"></div>
          <div class="absolute bottom-0 left-0 h-5 w-5 rounded-tr-full border-r-2 border-t-2 border-current/45"></div>
          <div class="absolute right-0 top-0 h-5 w-5 rounded-bl-full border-b-2 border-l-2 border-current/45"></div>
          <div class="absolute bottom-0 right-0 h-5 w-5 rounded-tl-full border-l-2 border-t-2 border-current/45"></div>
        </div>
      </div>
    </div>
  ) : (
    <div class="hero-patron absolute inset-4 rounded-surface border-2 border-current/45 sm:inset-6">
      <div class="absolute inset-3 rounded-control border border-current/35"></div>
      <div class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-current/40"></div>
      <div class="absolute left-1/2 top-1/2 h-32 w-32 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-current/50"></div>
      <div class="absolute left-1/2 top-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-current/60"></div>
      <div class="absolute inset-y-1/4 left-0 w-16 rounded-r-control border-y-2 border-r-2 border-current/40"></div>
      <div class="absolute inset-y-1/4 right-0 w-16 rounded-l-control border-y-2 border-l-2 border-current/40"></div>
    </div>
  )}
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-patron {
      animation: hero-patron-entra var(--dur-resorte) var(--ease-resorte) both;
    }
  }
  @keyframes hero-patron-entra {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
