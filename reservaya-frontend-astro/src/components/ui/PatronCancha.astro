---
// Firma visual del hero (spec 32): el mismo croquis de cancha de spec 24/31
// (perímetro, línea media, círculo central) escalado como textura ambiental
// detrás del buscador. Geometría pura, sin SVG ni imagen — misma familia
// visual que CroquisCancha.astro, solo a otra escala y con menor opacidad
// para no competir con el formulario ni con el tablero de "libres ahora".
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-patron absolute -right-10 -bottom-20 h-[30rem] w-[30rem] rounded-full border border-cesped/25 sm:-right-8 sm:-bottom-24 sm:h-[38rem] sm:w-[38rem] lg:-right-4 lg:-bottom-28 lg:h-[46rem] lg:w-[46rem]">
    <div class="absolute inset-10 rounded-full border border-cesped/25"></div>
    <div class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-cesped/25"></div>
    <div class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-cesped/25"></div>
    <div class="absolute left-1/2 top-1/2 h-28 w-28 -translate-x-1/2 -translate-y-1/2 rounded-full border border-cesped/35"></div>
  </div>
  <div class="hero-patron absolute -left-16 top-1/4 hidden h-40 w-40 rounded-full border border-cesped/15 xl:block"></div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-patron {
      animation: hero-patron-entra 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }
  @keyframes hero-patron-entra {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
