---
// Campo con etiqueta visible y nota opcional. El slot va dentro del contenedor
// relativo (p. ej. el botón para mostrar la contraseña).
import { CAMPO, ETIQUETA } from "../../lib/estilos";

interface Props {
  id: string;
  etiqueta: string;
  nota?: string;
  multilinea?: boolean;
  filas?: number;
  class?: string;
  /** Clases extra del propio campo (p. ej. espacio para un botón a la derecha). */
  claseCampo?: string;
  [atributo: string]: unknown;
}

const { id, etiqueta, nota, multilinea = false, filas = 4, class: extra = "", claseCampo = "", ...resto } = Astro.props;
const notaId = nota ? `${id}-nota` : undefined;
---

<div class={extra}>
  <label for={id} class={ETIQUETA}>{etiqueta}</label>
  <div class="relative">
    {multilinea ? (
      <textarea id={id} rows={filas} class={`${CAMPO} resize-y py-2.5 ${claseCampo}`} aria-describedby={notaId} {...resto} />
    ) : (
      <input id={id} class={`${CAMPO} h-11 ${claseCampo}`} aria-describedby={notaId} {...resto} />
    )}
    <slot />
  </div>
  {nota && <p id={notaId} class="mt-1.5 text-sm text-pizarra">{nota}</p>}
</div>
