---
// Tablero reducido para la columna derecha de las páginas de cuenta (spec 24, L2).
// Mismo tablero real que la home (tablero.ts), pero solo se inicia desde xl (1280px):
// probado en vivo que a lg (1024px) el panel de 6 columnas del tablero se recorta
// igual (columna de ~512px, no alcanza), así que esta columna no se pinta antes de
// xl y tampoco se pide la API.
import { BOTON } from "../lib/estilos";
---

<section id="tablero-auth" aria-labelledby="tablero-auth-titulo" class="hidden flex-col overflow-hidden rounded-surface border border-cal bg-tiza xl:flex">
  <div class="flex flex-wrap items-end justify-between gap-x-4 border-b border-cal px-4 pt-3 sm:px-6">
    <h2 id="tablero-auth-titulo" data-titulo class="pb-3 text-2xl">Libres hoy</h2>
    <div role="tablist" aria-label="Hora de inicio" class="-mb-px flex">
      {[0, 1, 2].map((i) => (
        <button
          type="button"
          role="tab"
          data-hora=""
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls="tablero-auth-panel"
          tabindex={i === 0 ? 0 : -1}
          class="h-12 w-20 border-b-2 border-transparent font-display text-lg font-semibold tabular-nums text-pizarra transition-colors hover:text-basalto aria-selected:border-cesped aria-selected:text-basalto"
        >--:--</button>
      ))}
    </div>
  </div>

  <div id="tablero-auth-panel" data-panel role="tabpanel" aria-labelledby="tablero-auth-titulo" class="h-80 overflow-hidden">
    <ul aria-hidden="true">
      {[0, 1, 2].map(() => (
        <li class="grid h-16 grid-cols-[4rem_3.5rem_minmax(0,1fr)_5rem] items-center gap-x-3 border-b border-cal px-4 sm:px-6">
          <span class="esqueleto h-9 w-16 rounded-control"></span>
          <span class="esqueleto h-6 w-12"></span>
          <span class="esqueleto h-5 w-3/4"></span>
          <span class="esqueleto h-9 w-20 justify-self-end"></span>
        </li>
      ))}
    </ul>
  </div>
  <p data-estado class="sr-only" aria-live="polite"></p>

  <div class="border-t border-cal px-4 sm:px-6">
    <a data-todas href="/canchas" class={BOTON.texto}>Buscar otro día u hora</a>
  </div>
</section>

<script>
  import { iniciarTablero } from "../scripts/tablero.ts";
  const raiz = document.getElementById("tablero-auth");
  if (raiz && matchMedia("(min-width: 1280px)").matches) iniciarTablero(raiz);
</script>
