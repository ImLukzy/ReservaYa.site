---
// Fila de función como FeatureRows de Universo (spec 47): panel ilustrado + texto,
// dos puntos con check y un CTA. El panel reserva su alto con aspect-ratio (CLS 0).
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  titulo: string;
  texto: string;
  puntos: string[];
  href: string;
  accion: string;
  tinta: string;
  invertir?: boolean;
}

const { titulo, texto, puntos, href, accion, tinta, invertir = false } = Astro.props;
---

<article class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12 lg:gap-16">
  <div class={`panel-tactil flex aspect-[4/3] items-center justify-center p-6 sm:p-10 ${tinta} ${invertir ? "md:order-2" : ""}`.trim()} aria-hidden="true">
    <slot />
  </div>
  <div>
    <h3 class="font-display text-3xl font-extrabold leading-[1.05] text-basalto lg:text-4xl">{titulo}</h3>
    <p class="mt-3 text-lg text-pizarra">{texto}</p>
    <ul class="mt-5 space-y-2.5">
      {puntos.map((punto) => (
        <li class="flex items-center gap-3 font-semibold text-basalto">
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-basalto bg-cesped text-tiza">
            <Icon nombre="ok" class="h-3.5 w-3.5" />
          </span>
          {punto}
        </li>
      ))}
    </ul>
    <Button href={href} class="mt-7">{accion}</Button>
  </div>
</article>
