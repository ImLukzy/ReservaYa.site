---
// Ilustración esquemática de un cuadro de torneo: 4 → 2 → campeón.
import Icon from "../ui/Icon.astro";

const caja = "flex h-8 items-center rounded-control border-2 border-basalto bg-tiza px-2";
---

<div class="card-tactil w-full max-w-xs p-5">
  <span class="inline-flex items-center rounded-full border-2 border-basalto bg-miel-suave px-3 py-0.5 text-xs font-bold text-basalto">Torneo</span>
  <div class="mt-4 grid grid-cols-[1fr_1fr_auto] items-center gap-3">
    <div class="space-y-2">
      {["w-14", "w-10", "w-12", "w-9"].map((ancho) => (
        <div class={caja}><span class={`h-2 rounded-full bg-piedra ${ancho}`}></span></div>
      ))}
    </div>
    <div class="space-y-9">
      {["w-12", "w-10"].map((ancho) => (
        <div class={caja}><span class={`h-2 rounded-full bg-piedra ${ancho}`}></span></div>
      ))}
    </div>
    <span class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-basalto bg-sol text-basalto shadow-dura-sm">
      <Icon nombre="trofeo" class="h-6 w-6" />
    </span>
  </div>
</div>
