---
// Cabecera de sección como en Universo (spec 47): antetítulo, título grande y bajada.
// `nivel={1}` la usa como cabecera de página (h1).
interface Props {
  id: string;
  antetitulo: string;
  titulo: string;
  bajada?: string;
  alinear?: "centro" | "izquierda";
  tono?: "claro" | "oscuro";
  nivel?: 1 | 2;
}

const { id, antetitulo, titulo, bajada, alinear = "centro", tono = "claro", nivel = 2 } = Astro.props;
const centro = alinear === "centro";
const oscuro = tono === "oscuro";
const Titulo = nivel === 1 ? "h1" : "h2";
---

<div class={centro ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}>
  <p class={`eyebrow ${oscuro ? "text-tiza/80" : ""}`.trim()}>{antetitulo}</p>
  <Titulo id={id} class={`mt-3 font-display text-3xl font-extrabold leading-[1.05] md:text-4xl lg:text-5xl ${oscuro ? "text-tiza" : "text-basalto"}`}>
    {titulo}
  </Titulo>
  {bajada && <p class={`mt-4 text-lg ${oscuro ? "text-tiza/75" : "text-pizarra"}`}>{bajada}</p>}
</div>
