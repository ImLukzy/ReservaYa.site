---
// Ilustración esquemática de un partido abierto: cupos ocupados y libres, sin datos inventados.
import CroquisCancha from "../ui/CroquisCancha.astro";
import Icon from "../ui/Icon.astro";

const cupos = [true, true, true, true, false, false];
---

<div class="card-tactil w-full max-w-xs p-5">
  <div class="flex items-center justify-between gap-3">
    <span class="inline-flex items-center rounded-full border-2 border-basalto bg-cesped-suave px-3 py-0.5 text-xs font-bold text-cesped-hondo">Partido abierto</span>
    <span class="h-2.5 w-16 rounded-full bg-piedra"></span>
  </div>
  <CroquisCancha class="mt-4 h-20 w-full" />
  <div class="mt-4 flex gap-2">
    {cupos.map((ocupado) => (
      ocupado ? (
        <span class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-basalto bg-basalto text-tiza">
          <Icon nombre="usuario" class="h-4 w-4" />
        </span>
      ) : (
        <span class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-dashed border-basalto bg-tiza text-basalto">
          <Icon nombre="mas" class="h-4 w-4" />
        </span>
      )
    ))}
  </div>
  <span class="mt-5 flex h-10 items-center justify-center rounded-full border-2 border-basalto bg-cesped text-sm font-bold text-tiza shadow-dura-sm">Sumarme</span>
</div>
