---
// Cabecera clara: marca, navegación y cuenta. La sesión la resuelve scripts/sesion.ts.
import Marca from "./Marca.astro";
import Icon from "./ui/Icon.astro";
import { BOTON } from "../lib/estilos";
import { APP } from "../lib/entorno";

const actual = Astro.url.pathname.replace(/\/$/, "") || "/";
const activo = (href: string) => actual === href || actual.startsWith(`${href}/`);
const enlaceMenu = "flex min-h-11 items-center gap-3 rounded-control px-3 text-basalto hover:bg-piedra focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-basalto";
const enlaceFondo = "text-pizarra hover:text-basalto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-basalto rounded px-1";

const desplegables = [
  {
    id: "jugar-menu",
    boton: "Jugar",
    items: [
      { href: "/completar-cuadro", texto: "Partidos abiertos", help: "Une a un grupo" },
      { href: "/sortear", texto: "Armar equipos", help: "Forma tu equipo" },
      { href: "/torneos", texto: "Torneos", help: "Compete y gana" },
    ],
  },
  {
    id: "duenos-menu",
    boton: "Dueños",
    items: [
      { href: "/duenos", texto: "Publicar mis canchas" },
      { href: "/duenos#planes", texto: "Planes y precios" },
      { href: "/login", texto: "Entrar al panel" },
    ],
  },
];
---

<header class="sticky top-0 z-40 border-b-2 border-basalto bg-tiza">
  <nav class="mx-auto flex h-16 max-w-page items-center justify-between gap-4 px-4 md:px-6" aria-label="Principal">
    <Marca />

    <ul class="hidden items-center gap-1 lg:flex">
      <li>
        <a
          href="/canchas"
          data-astro-prefetch
          aria-current={activo("/canchas") ? "page" : undefined}
          class="inline-flex min-h-11 items-center border-b-2 border-transparent px-3 font-semibold text-pizarra hover:text-basalto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-basalto focus-visible:rounded-control aria-[current=page]:border-cesped aria-[current=page]:text-basalto"
        >Canchas</a>
      </li>

      {desplegables.map((menu) => (
        <li class="relative">
          <button
            id={`${menu.id}-btn`}
            data-menu-desplegable
            aria-expanded="false"
            aria-controls={menu.id}
            class="inline-flex min-h-11 items-center border-b-2 border-transparent px-3 font-semibold text-pizarra hover:text-basalto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-basalto focus-visible:rounded-control aria-[current=page]:border-cesped aria-[current=page]:text-basalto"
          >
            {menu.boton}
            <Icon nombre="abajo" class="ml-1 h-3.5 w-3.5" />
          </button>

          <div
            id={menu.id}
            hidden
            class="absolute top-14 left-0 min-w-56 card-tactil p-2 shadow-dura animation-safe:animate-in animation-safe:fade-in animation-safe:slide-in-from-top-1"
          >
            <ul class="space-y-1">
              {menu.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    data-astro-prefetch
                    aria-current={activo(item.href) ? "page" : undefined}
                    class="block rounded-control px-3 py-2 text-basalto hover:bg-piedra aria-[current=page]:bg-cesped-suave aria-[current=page]:font-semibold"
                  >
                    {item.texto}
                    {"help" in item && <p class="text-xs text-pizarra">{item.help}</p>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}

      <li>
        <a
          href="/ayuda"
          data-astro-prefetch
          aria-current={activo("/ayuda") ? "page" : undefined}
          class="inline-flex min-h-11 items-center border-b-2 border-transparent px-3 font-semibold text-pizarra hover:text-basalto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-basalto focus-visible:rounded-control aria-[current=page]:border-cesped aria-[current=page]:text-basalto"
        >Ayuda</a>
      </li>
    </ul>

    <div class="flex items-center gap-2">
      <div data-solo="usuario" hidden class="relative hidden lg:block">
        <button id="cuenta-boton" type="button" class="flex min-h-11 items-center gap-2 rounded-full border border-basalto px-2.5 hover:bg-piedra cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-basalto focus-visible:ring-offset-2" aria-haspopup="true" aria-expanded="false" aria-controls="cuenta-menu">
          <span data-iniciales class="flex h-7 w-7 items-center justify-center rounded-full bg-basalto text-xs font-bold text-tiza"></span>
          <span data-nombre-corto class="hidden max-w-32 truncate font-bold text-xs lg:block"></span>
          <Icon nombre="abajo" class="h-3.5 w-3.5 text-pizarra" />
        </button>
        <div id="cuenta-menu" hidden class="absolute right-0 top-12 w-64 card-tactil p-2 shadow-dura animation-safe:animate-in animation-safe:fade-in animation-safe:slide-in-from-top-1">
          <div class="border-b border-cal px-3 pb-2">
            <p data-nombre class="truncate font-semibold"></p>
            <p data-correo class="truncate text-sm text-pizarra"></p>
          </div>
          <a href={`${APP}/dashboard/perfil`} class={`${enlaceMenu} mt-2`}><Icon nombre="usuario" class="h-4 w-4 text-pizarra" />Mi perfil</a>
          <a href={`${APP}/dashboard/reservas`} class={enlaceMenu}><Icon nombre="reloj" class="h-4 w-4 text-pizarra" />Mis reservas</a>
          <a href={`${APP}/dashboard`} class={enlaceMenu}><Icon nombre="lugar" class="h-4 w-4 text-pizarra" />Mi panel</a>
          <button type="button" data-salir class={`${enlaceMenu} w-full border-t border-cal text-left`}><Icon nombre="salir" class="h-4 w-4 text-pizarra" />Salir</button>
        </div>
      </div>

      <button id="menu-boton-movil" type="button" class="flex h-11 w-11 items-center justify-center rounded-control hover:bg-piedra lg:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-basalto focus-visible:ring-offset-2" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil-principal">
        <Icon nombre="menu" class="h-6 w-6" />
      </button>
    </div>
  </nav>

  <div id="menu-movil-principal" hidden class="border-t border-cal px-4 pb-4 lg:hidden">
    <div class="space-y-4 py-4">
      <a href="/canchas" aria-current={activo("/canchas") ? "page" : undefined} class="flex min-h-11 items-center rounded-control px-3 font-semibold text-basalto hover:bg-piedra aria-[current=page]:bg-cesped-suave">Canchas</a>
      <div>
        <h2 class="px-3 py-2 text-sm font-semibold text-pizarra">Jugar</h2>
        <ul class="space-y-1">
          <li><a href="/completar-cuadro" aria-current={activo("/completar-cuadro") ? "page" : undefined} class="block rounded-control px-3 py-2 text-basalto hover:bg-piedra aria-[current=page]:bg-cesped-suave aria-[current=page]:font-semibold">Partidos abiertos</a></li>
          <li><a href="/sortear" aria-current={activo("/sortear") ? "page" : undefined} class="block rounded-control px-3 py-2 text-basalto hover:bg-piedra aria-[current=page]:bg-cesped-suave aria-[current=page]:font-semibold">Armar equipos</a></li>
          <li><a href="/torneos" aria-current={activo("/torneos") ? "page" : undefined} class="block rounded-control px-3 py-2 text-basalto hover:bg-piedra aria-[current=page]:bg-cesped-suave aria-[current=page]:font-semibold">Torneos</a></li>
        </ul>
      </div>

      <div>
        <h2 class="px-3 py-2 text-sm font-semibold text-pizarra">Dueños</h2>
        <ul class="space-y-1">
          <li><a href="/duenos" aria-current={activo("/duenos") ? "page" : undefined} class="block rounded-control px-3 py-2 text-basalto hover:bg-piedra aria-[current=page]:bg-cesped-suave aria-[current=page]:font-semibold">Publicar mis canchas</a></li>
          <li><a href="/duenos#planes" class="block rounded-control px-3 py-2 text-basalto hover:bg-piedra">Planes y precios</a></li>
          <li><a href="/login" class="block rounded-control px-3 py-2 text-basalto hover:bg-piedra">Entrar al panel</a></li>
        </ul>
      </div>

      <a href="/ayuda" aria-current={activo("/ayuda") ? "page" : undefined} class="flex min-h-11 items-center rounded-control px-3 font-semibold text-basalto hover:bg-piedra aria-[current=page]:bg-cesped-suave">Ayuda</a>

      <div data-solo="usuario" hidden class="border-t border-cal pt-4">
        <div class="px-3 pb-2">
          <p data-nombre class="truncate font-semibold"></p>
          <p data-correo class="truncate text-sm text-pizarra"></p>
        </div>
        <ul class="space-y-1">
          <li><a href={`${APP}/dashboard/perfil`} class="block rounded-control px-3 py-2 text-basalto hover:bg-piedra">Mi perfil</a></li>
          <li><a href={`${APP}/dashboard/reservas`} class="block rounded-control px-3 py-2 text-basalto hover:bg-piedra">Mis reservas</a></li>
          <li><a href={`${APP}/dashboard`} class="block rounded-control px-3 py-2 text-basalto hover:bg-piedra">Mi panel</a></li>
          <li><button type="button" data-salir class="block w-full rounded-control px-3 py-2 text-left text-basalto hover:bg-piedra">Salir</button></li>
        </ul>
      </div>

      <div data-solo="invitado" hidden class="border-t border-cal pt-4">
        <a href="/login" data-astro-prefetch class={`${BOTON.secundario} w-full block text-center text-xs py-2`}>Entrar al panel</a>
      </div>
    </div>
  </div>
</header>

<script>
  import "../scripts/sesion.ts";
  import "../scripts/menu.ts";
</script>
