---
// Marca: cancha vista desde arriba (líneas de cal) + nombre en letra de señalética.
interface Props {
  class?: string;
}
const { class: extra = "" } = Astro.props;
---

<a href="/" class={`inline-flex min-h-11 items-center gap-2 text-basalto ${extra}`.trim()} aria-label="ReservaYa, inicio">
  <svg class="h-7 w-7 shrink-0 text-cesped" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <rect x="3" y="5" width="22" height="18" rx="2" />
    <path d="M14 5v18" />
    <circle cx="14" cy="14" r="3.5" />
  </svg>
  <span class="font-display text-2xl font-bold leading-none">ReservaYa</span>
</a>
