---
// Pie: marca, contacto y legal. Compacto y accesible.
import Marca from "./Marca.astro";
import Icon from "./ui/Icon.astro";
import { EMAIL, INSTAGRAM, WHATSAPP_VISIBLE, whatsappUrl } from "../lib/contacto";

const enlaceLegal = "text-pizarra hover:text-basalto hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-basalto rounded px-1";
---

<footer class="border-t-2 border-basalto bg-tiza">
  <div class="mx-auto max-w-page px-4 py-8 md:px-6">
    <!-- Fila 1: marca + descripción / contacto -->
    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
      <div>
        <Marca />
        <p class="mt-2 max-w-xs text-sm text-pizarra">Reservas de canchas deportivas en Arequipa.</p>
      </div>
      <ul class="flex items-center gap-3">
        <li>
          <a
            href={whatsappUrl()}
            target="_blank"
            rel="noopener"
            aria-label="WhatsApp"
            class="flex min-h-11 min-w-11 items-center justify-center rounded-control hover:bg-cesped-suave focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-basalto"
          >
            <Icon nombre="mensaje" class="h-5 w-5 text-cesped-hondo" />
          </a>
        </li>
        <li>
          <a
            href={`mailto:${EMAIL}`}
            aria-label="Correo"
            class="flex min-h-11 min-w-11 items-center justify-center rounded-control hover:bg-piedra focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-basalto"
          >
            <Icon nombre="correo" class="h-5 w-5 text-pizarra" />
          </a>
        </li>
        <li>
          <a
            href={INSTAGRAM}
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
            class="flex min-h-11 min-w-11 items-center justify-center rounded-control hover:bg-piedra focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-basalto"
          >
            <Icon nombre="instagram" class="h-5 w-5 text-pizarra" />
          </a>
        </li>
      </ul>
    </div>

    <!-- Fila 2: legal -->
    <div class="border-t border-basalto/15 mt-6 pt-6">
      <ul class="flex flex-wrap items-center gap-2 text-xs text-pizarra md:gap-4 md:text-sm">
        <li>© {new Date().getFullYear()} ReservaYa</li>
        <li class="hidden md:inline text-basalto/30">·</li>
        <li><a href="/legal/terms" data-astro-prefetch class={enlaceLegal}>Términos</a></li>
        <li class="hidden md:inline text-basalto/30">·</li>
        <li><a href="/legal/privacy" data-astro-prefetch class={enlaceLegal}>Privacidad</a></li>
        <li class="hidden md:inline text-basalto/30">·</li>
        <li><a href="/libro-reclamaciones" data-astro-prefetch class={enlaceLegal}>Libro de reclamaciones</a></li>
        <li class="hidden md:inline text-basalto/30">·</li>
        <li><a href="/mejoras" data-astro-prefetch class={enlaceLegal}>Sugerencias</a></li>
      </ul>
    </div>
  </div>
</footer>
