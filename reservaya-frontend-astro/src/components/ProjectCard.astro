---
// Component: ProjectCard
import { Image } from "astro:assets";

interface Props {
  title: string;
  tech?: string;
  description?: string;
  image: ImageMetadata;
  url?: string;
}

const { title, tech, description, image, url = "#" } = Astro.props;
---

<article
  class="group relative rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-2xl hover:-translate-y-1"
  style="background: var(--bg-card); border: 1px solid var(--border-card);"
>
  {url ? (
    <a
      href={url}
      target={url.startsWith("http") ? "_blank" : "_self"}
      rel="noopener noreferrer"
      class="block h-full rounded-2xl focus:outline-none focus-visible:ring-2"
      style="--tw-ring-color: var(--ring-card-focus, var(--border-card));"
    >
      <div class="relative overflow-hidden aspect-[4/3]">
        <Image
          src={image}
          alt={`Vista previa del proyecto ${title}`}
          width={800}
          format="webp"
          quality={85}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
        <div
          class="absolute inset-0 transition-colors duration-500"
          style="background: var(--card-image-overlay, transparent);"
          aria-hidden="true"
        ></div>
      </div>
      <div class="p-6 flex flex-col gap-3">
        <h3
          class="text-xl font-semibold tracking-tight group-hover:underline underline-offset-4"
          style="color: var(--text-main);"
        >
          {title}
        </h3>
        {tech && (
          <span
            class="inline-block text-xs font-medium uppercase tracking-wide"
            style="color: var(--text-secondary);"
          >
            {tech}
          </span>
        )}
        {description && (
          <p class="text-sm leading-relaxed line-clamp-3" style="color: var(--text-secondary);">
            {description}
          </p>
        )}
        <div class="mt-2 inline-flex items-center gap-2 text-sm font-medium" style="color: var(--text-main);">
          Ver proyecto
          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
            &rarr;
          </span>
        </div>
      </div>
    </a>
  ) : null}
</article>


