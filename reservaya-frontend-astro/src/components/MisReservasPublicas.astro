---
const apiUrl = import.meta.env.PUBLIC_RESERVAYA_API_URL || "http://localhost:5000";
const appUrl = import.meta.env.PUBLIC_RESERVAYA_APP_URL || "http://localhost:3000";
---

<section class="py-16" aria-labelledby="mis-reservas-title">
  <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#4ADE80]">Tu actividad</p>
      <h1 id="mis-reservas-title" class="mt-2 text-3xl font-black text-white md:text-4xl">Mis reservas</h1>
      <p class="mt-2 text-white/75">Consulta el estado y los detalles de cada solicitud.</p>
    </div>
    <div id="mis-reservas-filters" class="hidden flex-wrap gap-2" role="tablist" aria-label="Filtrar por estado">
      <button type="button" data-filter="TODAS" class="rounded-full bg-[#22C55E] px-4 py-1.5 text-sm font-bold text-white">Todas</button>
      <button type="button" data-filter="PENDIENTE" class="rounded-full border border-white/15 px-4 py-1.5 text-sm font-semibold text-white/70 transition hover:border-[#22C55E]/60 hover:text-white">Pendientes</button>
      <button type="button" data-filter="CONFIRMADA" class="rounded-full border border-white/15 px-4 py-1.5 text-sm font-semibold text-white/70 transition hover:border-[#22C55E]/60 hover:text-white">Confirmadas</button>
      <button type="button" data-filter="COMPLETADA" class="rounded-full border border-white/15 px-4 py-1.5 text-sm font-semibold text-white/70 transition hover:border-[#22C55E]/60 hover:text-white">Completadas</button>
      <button type="button" data-filter="CANCELADA" class="rounded-full border border-white/15 px-4 py-1.5 text-sm font-semibold text-white/70 transition hover:border-[#22C55E]/60 hover:text-white">Canceladas</button>
    </div>
  </div>

  <div id="mis-reservas-status" class="rounded-2xl border border-white/10 bg-[#060A08] p-8 text-center text-white/75">
    Cargando tus reservas...
  </div>
  <div id="mis-reservas-grid" class="hidden space-y-4"></div>
</section>

<script define:vars={{ apiUrl, appUrl }}>
  type Reserva = {
    id: string;
    codigo?: string | null;
    fecha: string;
    horaInicio: number;
    horaFin: number;
    estado: "PENDIENTE" | "CONFIRMADA" | "CANCELADA" | "COMPLETADA";
    total: string;
    notas: string | null;
    cancha: { nombre: string; tipo: string };
  };

  const status = document.getElementById("mis-reservas-status");
  const grid = document.getElementById("mis-reservas-grid");
  const filters = document.getElementById("mis-reservas-filters");
  let todas: Reserva[] = [];
  let filtro = "TODAS";

  const formatDate = (value: string) => {
    const [year, month, day] = value.slice(0, 10).split("-").map(Number);
    return new Intl.DateTimeFormat("es-PE", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(new Date(year, month - 1, day));
  };

  const formatTime = (minutes: number) =>
    `${String(Math.floor(minutes / 60)).padStart(2, "0")}:${String(minutes % 60).padStart(2, "0")}`;

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    })[character] || character);

  const stateStyles: Record<Reserva["estado"], string> = {
    PENDIENTE: "border-amber-300/30 bg-amber-400/10 text-amber-200",
    CONFIRMADA: "border-emerald-300/30 bg-emerald-400/10 text-emerald-200",
    CANCELADA: "border-rose-300/30 bg-rose-400/10 text-rose-200",
    COMPLETADA: "border-sky-300/30 bg-sky-400/10 text-sky-200",
  };

  const showStatus = (message: string, isError = false, actions?: { loginUrl: string; registerUrl: string }) => {
    if (!status) return;
    status.innerHTML = "";
    status.classList.remove("hidden");
    status.className = isError
      ? "rounded-2xl border border-rose-400/30 bg-rose-500/10 p-8 text-center text-rose-200"
      : "rounded-2xl border border-white/10 bg-[#060A08] p-8 text-center text-white/75";

    if (actions) {
      const title = document.createElement("p");
      title.className = "text-lg font-bold text-white";
      title.textContent = message;
      status.appendChild(title);

      const desc = document.createElement("p");
      desc.className = "mx-auto mt-2 max-w-md text-sm text-white/60";
      desc.textContent = "Tus solicitudes y códigos QR aparecen aquí cuando entras con tu cuenta.";
      status.appendChild(desc);

      const div = document.createElement("div");
      div.className = "mt-5 flex flex-wrap justify-center gap-3";

      const loginLink = document.createElement("a");
      loginLink.href = actions.loginUrl;
      loginLink.className = "rounded-xl bg-[#22C55E] px-5 py-2.5 text-sm font-bold text-white transition hover:bg-[#16A34A]";
      loginLink.textContent = "Iniciar sesión";
      div.appendChild(loginLink);

      const registerLink = document.createElement("a");
      registerLink.href = actions.registerUrl;
      registerLink.className = "rounded-xl border border-[#22C55E]/40 px-5 py-2.5 text-sm font-semibold text-[#4ADE80] transition hover:bg-[#22C55E]/10";
      registerLink.textContent = "Crear cuenta";
      div.appendChild(registerLink);

      status.appendChild(div);
    } else {
      const p = document.createElement("p");
      p.innerHTML = message; // message is pre-escaped or static
      status.appendChild(p);
    }
  };

  const showLogin = () => {
    const back = encodeURIComponent(window.location.href);
    showStatus("", false, {
      loginUrl: `${appUrl}/login?returnUrl=${back}`,
      registerUrl: `${appUrl}/register?returnUrl=${back}`
    });
    // Override the title
    const title = status.querySelector("p");
    if (title) title.textContent = "Inicia sesión para ver tus reservas";
  };

  const codigoDe = (reserva: Reserva) =>
    reserva.codigo && reserva.codigo.trim() !== ""
      ? reserva.codigo.trim().toUpperCase()
      : reserva.id.slice(-6).toUpperCase();

const renderReservation = (reserva: Reserva) => {
    const card = document.createElement("article");
    card.className = "rounded-2xl border border-white/10 bg-[#060A08] p-5 shadow-lg md:p-6";
    const canchaTipo = escapeHtml(reserva.cancha.tipo);
    const canchaNombre = escapeHtml(reserva.cancha.nombre);
    const total = escapeHtml(reserva.total);
    const codigo = escapeHtml(codigoDe(reserva));
    const notas = reserva.notas ? escapeHtml(reserva.notas) : "";
    const cancelable = reserva.estado === "PENDIENTE" || reserva.estado === "CONFIRMADA";

    const topDiv = document.createElement("div");
    topDiv.className = "flex flex-col gap-4 md:flex-row md:items-start md:justify-between";

    const leftDiv = document.createElement("div");
    const tipoP = document.createElement("p");
    tipoP.className = "text-xs font-semibold uppercase tracking-[0.2em] text-[#4ADE80]";
    tipoP.textContent = canchaTipo;
    const nombreH2 = document.createElement("h2");
    nombreH2.className = "mt-1 text-xl font-bold text-white";
    nombreH2.textContent = canchaNombre;
    const fechaP = document.createElement("p");
    fechaP.className = "mt-2 text-sm capitalize text-white/60";
    fechaP.textContent = formatDate(reserva.fecha);
    leftDiv.append(tipoP, nombreH2, fechaP);

    const estadoSpan = document.createElement("span");
    estadoSpan.className = `w-fit rounded-full border px-3 py-1 text-xs font-bold ${stateStyles[reserva.estado]}`;
    estadoSpan.textContent = reserva.estado;

    topDiv.append(leftDiv, estadoSpan);

    const gridDiv = document.createElement("div");
    gridDiv.className = "mt-5 grid gap-3 border-t border-white/10 pt-4 text-sm sm:grid-cols-3";

    const horarioDiv = document.createElement("div");
    const horarioLabel = document.createElement("p");
    horarioLabel.className = "text-xs uppercase tracking-wide text-white/50";
    horarioLabel.textContent = "Horario";
    const horarioValue = document.createElement("p");
    horarioValue.className = "mt-1 font-semibold text-white";
    horarioValue.textContent = `${formatTime(reserva.horaInicio)} - ${formatTime(reserva.horaFin)}`;
    horarioDiv.append(horarioLabel, horarioValue);

    const totalDiv = document.createElement("div");
    const totalLabel = document.createElement("p");
    totalLabel.className = "text-xs uppercase tracking-wide text-white/50";
    totalLabel.textContent = "Total";
    const totalValue = document.createElement("p");
    totalValue.className = "mt-1 font-semibold text-white";
    totalValue.textContent = `S/ ${total}`;
    totalDiv.append(totalLabel, totalValue);

    const codigoDiv = document.createElement("div");
    const codigoLabel = document.createElement("p");
    codigoLabel.className = "text-xs uppercase tracking-wide text-white/50";
    codigoLabel.textContent = "Código de ingreso";
    const codigoValue = document.createElement("p");
    codigoValue.className = "mt-1 font-mono font-semibold tracking-widest text-[#4ADE80]";
    codigoValue.textContent = codigo;
    codigoDiv.append(codigoLabel, codigoValue);

    gridDiv.append(horarioDiv, totalDiv, codigoDiv);

    card.append(topDiv, gridDiv);

    if (reserva.estado === "CONFIRMADA") {
      const confirmP = document.createElement("p");
      confirmP.className = "mt-4 rounded-xl bg-emerald-400/10 px-4 py-3 text-sm text-emerald-200";
      const strong = document.createElement("strong");
      strong.className = "font-mono tracking-widest";
      strong.textContent = codigo;
      confirmP.append("Muestra este código al llegar: ", strong);
      card.appendChild(confirmP);
    }

    if (notas) {
      const notasP = document.createElement("p");
      notasP.className = "mt-4 rounded-xl bg-white/5 px-4 py-3 text-sm text-white/75";
      const strong = document.createElement("strong");
      strong.className = "text-white";
      strong.textContent = "Nota: ";
      notasP.append(strong, notas);
      card.appendChild(notasP);
    }

    if (cancelable) {
      const cancelBtn = document.createElement("button");
      cancelBtn.type = "button";
      cancelBtn.dataset.cancelId = escapeHtml(reserva.id);
      cancelBtn.className = "mt-5 rounded-lg border border-rose-300/30 px-3 py-2 text-sm font-semibold text-rose-200 transition hover:bg-rose-400/10";
      cancelBtn.textContent = "Cancelar solicitud";
      card.appendChild(cancelBtn);
    }

    return card;
  };

  const pintarFiltro = () => {
    filters?.querySelectorAll("button").forEach((b) => {
      const activo = b.dataset.filter === filtro;
      b.className = activo
        ? "rounded-full bg-[#22C55E] px-4 py-1.5 text-sm font-bold text-white"
        : "rounded-full border border-white/15 px-4 py-1.5 text-sm font-semibold text-white/70 transition hover:border-[#22C55E]/60 hover:text-white";
    });
  };

  const renderReservations = (reservas: Reserva[]) => {
    if (!status || !grid) return;
    const lista = reservas
      .filter((r) => filtro === "TODAS" || r.estado === filtro)
      .sort((a, b) => `${b.fecha}-${String(b.horaInicio).padStart(4, "0")}`.localeCompare(`${a.fecha}-${String(a.horaInicio).padStart(4, "0")}`));
    status.classList.add("hidden");
    filters?.classList.remove("hidden");
    filters?.classList.add("flex");
    if (lista.length === 0) {
      grid.replaceChildren();
      grid.classList.add("hidden");
      if (reservas.length === 0) {
        showStatus("Todavía no tienes reservas", false);
        const p1 = document.createElement("p");
        p1.className = "mt-2 text-sm text-white/60";
        p1.textContent = "Explora las canchas disponibles para solicitar un horario.";
        status.appendChild(p1);
        const link = document.createElement("a");
        link.href = "/canchas";
        link.className = "mt-5 inline-block rounded-xl bg-[#22C55E] px-5 py-2.5 text-sm font-bold text-white transition hover:bg-[#16A34A]";
        link.textContent = "Ver canchas";
        status.appendChild(link);
      } else {
        showStatus("Sin reservas en esta categoría", false);
        const p1 = document.createElement("p");
        p1.className = "mt-2 text-sm text-white/60";
        p1.textContent = "Prueba con otro filtro.";
        status.appendChild(p1);
      }
      return;
    }
    grid.replaceChildren(...lista.map(renderReservation));
    grid.classList.remove("hidden");
  };

  const loadReservations = async () => {
    const response = await fetch(`${apiUrl}/api/reservas`, { mode: "cors", credentials: "include" });
    if (response.status === 401 || response.status === 403) {
      showLogin();
      return null;
    }
    const body = await response.json().catch(() => null);
    if (!response.ok) throw new Error(body?.error || "No se pudieron cargar tus reservas.");
    return body?.reservas as Reserva[];
  };

  const recargar = async () => {
    try {
      const reservas = await loadReservations();
      if (reservas) {
        todas = reservas;
        renderReservations(todas);
      }
    } catch (error) {
      showStatus("No se pudieron cargar tus reservas", true);
      const p1 = document.createElement("p");
      p1.className = "mt-2 text-sm";
      p1.textContent = escapeHtml(error instanceof Error ? error.message : "Inténtalo de nuevo.");
      status.appendChild(p1);
      const retryBtn = document.createElement("button");
      retryBtn.type = "button";
      retryBtn.id = "mis-reservas-retry";
      retryBtn.className = "mt-5 rounded-xl bg-[#22C55E] px-5 py-2.5 text-sm font-bold text-white transition hover:bg-[#16A34A]";
      retryBtn.textContent = "Reintentar";
      status.appendChild(retryBtn);
      retryBtn.addEventListener("click", recargar);
    }
  };

  filters?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    filtro = target.dataset.filter || "TODAS";
    pintarFiltro();
    renderReservations(todas);
  });

  grid?.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    const reservationId = target.dataset.cancelId;
    if (!reservationId || !window.confirm("¿Quieres cancelar esta solicitud?")) return;

    target.disabled = true;
    target.textContent = "Cancelando...";
    try {
      const response = await fetch(`${apiUrl}/api/reservas/${encodeURIComponent(reservationId)}`, {
        method: "PATCH",
        mode: "cors",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ estado: "CANCELADA" }),
      });
      const body = await response.json().catch(() => null);
      if (response.status === 401 || response.status === 403) {
        showLogin();
        return;
      }
      if (!response.ok) throw new Error(body?.error || "No se pudo cancelar la solicitud.");
      await recargar();
    } catch (error) {
      target.disabled = false;
      target.textContent = "Cancelar solicitud";
      showStatus(escapeHtml(error instanceof Error ? error.message : "No se pudo cancelar la solicitud."), true);
    }
  });

  pintarFiltro();
  void recargar();
</script>
