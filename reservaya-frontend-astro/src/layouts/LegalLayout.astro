---
// Páginas legales en Markdown (src/pages/legal/*.md).
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: { title: string; description?: string };
}
const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} | ReservaYa`} description={frontmatter.description ?? frontmatter.title}>
  <section class="mx-auto max-w-texto px-4 py-8 md:px-6 lg:py-12">
    <div class="card-tactil p-6 md:p-10">
      <article class="prosa">
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>
