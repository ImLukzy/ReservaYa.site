---
// Layout de la landing (spec 20): cabecera y pie claros, tipografías propias y SEO.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { EMAIL, INSTAGRAM } from "../lib/contacto";
import "../styles/tailwind.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
  /** false en páginas con datos sensibles en la URL (p. ej. /reset-password): no carga GA. */
  analytics?: boolean;
}

const {
  title = "ReservaYa",
  description = "Canchas deportivas libres en Arequipa: elige hora y reserva.",
  image = "/og-default.png",
  robots = "index, follow",
  analytics = true,
} = Astro.props;

const siteURL = Astro.site?.toString() || "https://reservaya.com";
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImageURL = new URL(image, siteURL);
const gaId = import.meta.env.PUBLIC_GA_ID;
const inboxEndpoint = import.meta.env.PUBLIC_INBOXMEJIKAI_ENDPOINT;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "ReservaYa",
    url: siteURL,
    logo: `${siteURL}/favicon.svg`,
    sameAs: [INSTAGRAM],
    contactPoint: { "@type": "ContactPoint", email: EMAIL, contactType: "customer service", areaServed: "PE", availableLanguage: "Spanish" },
  },
  { "@context": "https://schema.org", "@type": "WebSite", name: "ReservaYa", url: siteURL },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "ReservaYa",
    url: siteURL,
    description: "Reserva de canchas deportivas en Arequipa: fútbol, vóley, básquet, pádel y tenis en los distritos de la ciudad.",
    applicationCategory: "SportsApplication",
    operatingSystem: "Web",
    areaServed: { "@type": "City", name: "Arequipa", addressCountry: "PE" },
  },
];
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {/* Títulos h1–h3 en Barlow Condensed 700–900 → archivo 700 (spec 47: evita el salto al cambiar de fuente). */}
  {["barlow-400", "barlow-condensed-700"].map((f) => (
    <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />
  ))}

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:site_name" content="ReservaYa" />
  <meta property="og:locale" content="es_PE" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
  <script>
    if (location.protocol === "http:" && location.hostname !== "localhost" && location.hostname !== "127.0.0.1") {
      location.replace(`https://${location.host}${location.pathname}${location.search}${location.hash}`);
    }
  </script>
  {gaId && analytics && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline>{`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${gaId}', { anonymize_ip: true });`}</script>
    </>
  )}
  <slot name="head" />
</head>

<body class="flex min-h-screen flex-col" data-inbox-endpoint={inboxEndpoint || undefined}>
  <a href="#contenido" class="skip-link">Saltar al contenido</a>
  <Header />
  <!-- El pie empieza fuera de la pantalla: si el contenido crece al cargar datos, no hay salto visible (spec 49). -->
  <main id="contenido" tabindex="-1" class="min-h-[calc(100svh-4rem)] flex-1 focus:outline-none">
    <slot />
  </main>
  <Footer />

  <script>
    import "../scripts/bandeja.ts";
    import "../scripts/revelar.ts";
  </script>
</body>
</html>
