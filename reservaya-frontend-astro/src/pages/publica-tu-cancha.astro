---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BOTON } from "../lib/estilos";
---

<BaseLayout title="Publica tu cancha | ReservaYa" description="Publica tu complejo y recibe reservas." robots="noindex, follow">
  <meta http-equiv="refresh" content="0; url=/duenos" slot="head" />
  <section class="mx-auto max-w-texto px-4 py-16 text-center">
    <p class="text-pizarra">Te llevamos a la página de dueños.</p>
    <a href="/duenos" class={`${BOTON.primario} mt-4`}>Ir a la página de dueños</a>
  </section>
</BaseLayout>

<script is:inline>
  window.location.replace("/duenos");
</script>
