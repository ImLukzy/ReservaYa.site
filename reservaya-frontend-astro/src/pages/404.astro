---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Página no encontrada | ReservaYa" robots="noindex, follow">
  <section class="mx-auto max-w-texto px-4 py-16 md:px-6 lg:py-24">
    <p class="font-display text-4xl font-bold tabular-nums text-pizarra">404</p>
    <h1 class="mt-2 text-3xl lg:text-4xl">No encontramos esta página</h1>
    <p class="mt-3 text-lg text-pizarra">Puede que el enlace esté mal escrito o que la página ya no exista.</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <Button href="/canchas">Buscar canchas</Button>
      <Button href="/" variante="secundario">Ir al inicio</Button>
    </div>
  </section>
</BaseLayout>
