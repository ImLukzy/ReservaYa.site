---
// Perfil del jugador. Solo se muestran y guardan datos que la API persiste
// (PATCH /api/usuarios/me: telefono, username, fechaNacimiento una vez; foto aparte).
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import Field from "../../components/ui/Field.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import { API, APP } from "../../lib/entorno";
import { AVISO, BOTON, INSIGNIA, INSIGNIA_BASE } from "../../lib/estilos";

const apiUrl = API;
const pestana = "min-h-11 border-b-2 border-transparent px-4 font-semibold text-pizarra hover:text-basalto aria-selected:border-cesped aria-selected:text-basalto";
const tonos = {
  CONFIRMADA: `${INSIGNIA_BASE} ${INSIGNIA.libre}`,
  PENDIENTE: `${INSIGNIA_BASE} ${INSIGNIA.neutro}`,
  COMPLETADA: `${INSIGNIA_BASE} ${INSIGNIA.neutro}`,
  CANCELADA: `${INSIGNIA_BASE} ${INSIGNIA.error}`,
};
---

<BaseLayout title="Mi perfil | ReservaYa" description="Tus datos, tus reservas y tu usuario de ReservaYa." robots="noindex, follow">
  <section class="mx-auto grid max-w-page gap-8 px-4 pb-16 pt-8 md:px-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:pt-12">
    <aside class="space-y-4">
      <div class="rounded-surface border border-cal bg-tiza p-5">
        <div class="flex items-center gap-3">
          <span id="avatar" class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full bg-basalto font-display text-2xl font-bold text-tiza"></span>
          <div class="min-w-0">
            <p id="p-nombre" class="truncate font-semibold">Cargando…</p>
            <p id="p-email" class="truncate text-sm text-pizarra"></p>
          </div>
        </div>
        <p id="login-aviso" hidden class={`mt-4 ${AVISO.error}`}>Entra a tu cuenta para ver tu perfil. <a href="/login?returnUrl=/jugador/perfil" class="underline">Entrar</a></p>
        <div class="mt-4 grid gap-2">
          <Button id="btn-edit" variante="secundario" class="w-full">Editar mis datos</Button>
          <Button href={`${APP}/dashboard/carne`} variante="secundario" class="w-full">Ver mi carné</Button>
          <Button href="/canchas" class="w-full">Buscar canchas</Button>
        </div>
      </div>
      <dl class="rounded-surface border border-cal bg-tiza px-5 py-2">
        {[["st-total", "Reservas"], ["st-conf", "Confirmadas"], ["st-comp", "Completadas"], ["st-pend", "Pendientes"]].map(([id, t]) => (
          <div class="flex items-center justify-between border-b border-cal py-2 last:border-b-0">
            <dt class="text-pizarra">{t}</dt><dd id={id} class="font-display text-lg font-semibold tabular-nums">–</dd>
          </div>
        ))}
      </dl>
    </aside>

    <div id="view-reservas">
      <h1 class="text-3xl">Mis reservas</h1>
      <div class="mt-4 flex border-b border-cal" role="tablist" aria-label="Reservas">
        <button type="button" role="tab" data-tab="activas" aria-selected="true" class={`tab ${pestana}`}>Activas</button>
        <button type="button" role="tab" data-tab="historial" aria-selected="false" class={`tab ${pestana}`}>Historial</button>
        <button type="button" role="tab" data-tab="todas" id="tab-todas" aria-selected="false" class={`tab ${pestana}`}>Todas</button>
      </div>
      <EmptyState id="res-vacio" class="mt-4" titulo="No tienes reservas activas" texto="Busca una cancha libre y resérvala.">
        <Button href="/canchas">Buscar canchas</Button>
      </EmptyState>
      <ul id="res-lista" hidden class="mt-4 overflow-hidden rounded-surface border border-cal bg-tiza"></ul>
    </div>

    <div id="view-edit" hidden>
      <button id="btn-back" type="button" class={`${BOTON.texto} text-sm`}>Volver a mis reservas</button>
      <h1 class="mt-2 text-3xl">Mis datos</h1>
      <div class="mt-4 rounded-surface border border-cal bg-tiza p-5 sm:p-6">
        <div class="flex items-center gap-4">
          <span id="avatar-big" class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full bg-basalto font-display text-3xl font-bold text-tiza"></span>
          <div>
            <p class="font-semibold">Foto de perfil</p>
            <p class="text-sm text-pizarra">Sale en tu carné y en los sorteos de equipos. Hasta 3 MB.</p>
            <button id="btn-foto" type="button" class={`${BOTON.texto} text-sm`}>Subir foto</button>
            <input id="f-foto" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="sr-only" />
          </div>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <Field id="f-nombre" etiqueta="Nombre completo" disabled nota="No se puede cambiar." />
          <Field id="f-email" etiqueta="Correo" disabled nota="No se puede cambiar." />
          <Field id="f-tel" etiqueta="Teléfono" type="tel" autocomplete="tel" placeholder="999 888 777" />
          <Field id="f-fecha" etiqueta="Fecha de nacimiento" type="date" disabled nota="No se puede cambiar." />
          <Field id="f-user" etiqueta="Tu usuario" autocomplete="username" class="sm:col-span-2" nota="De 3 a 20 caracteres: letras, números, _ . o -. Se puede cambiar una vez al año." />
        </div>
        <p id="save-msg" hidden role="status" class={`mt-5 ${AVISO.ok}`}>Cambios guardados.</p>
        <p id="save-err" hidden role="alert" class={`mt-5 ${AVISO.error}`}></p>
        <div class="mt-5 flex gap-3">
          <Button id="btn-save">Guardar cambios</Button>
          <Button id="btn-cancel" variante="secundario">Cancelar</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ apiUrl, tonos }}>
(function () {
  var base = String(apiUrl);
  const $ = (id) => document.getElementById(id);
  const vRes = $("view-reservas");
  const vEdit = $("view-edit");
  const show = (edit) => {
    vRes.hidden = edit;
    vEdit.hidden = !edit;
    window.scrollTo({ top: 0 });
  };
  $("btn-edit")?.addEventListener("click", () => show(true));
  $("btn-back")?.addEventListener("click", () => show(false));
  $("btn-cancel")?.addEventListener("click", () => show(false));

  const ESTADO = { CONFIRMADA: "Confirmada", PENDIENTE: "Pendiente", COMPLETADA: "Completada", CANCELADA: "Cancelada" };
  let reservas = [];
  let tab = "activas";
  let perfil = null;

  const fmtFecha = (iso) => {
    const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso || "");
    return m ? `${m[3]}/${m[2]}/${m[1]}` : "";
  };
  const fmtHora = (min) => `${String(Math.floor(min / 60)).padStart(2, "0")}:${String(min % 60).padStart(2, "0")}`;

  function pintarReservas() {
    const lista = $("res-lista");
    const vacio = $("res-vacio");
    const items = reservas.filter((r) =>
      tab === "todas" ? true :
      tab === "historial" ? (r.estado === "COMPLETADA" || r.estado === "CANCELADA") :
      (r.estado === "PENDIENTE" || r.estado === "CONFIRMADA"));
    $("tab-todas").textContent = `Todas (${reservas.length})`;
    vacio.hidden = items.length > 0;
    lista.hidden = items.length === 0;
    lista.replaceChildren(...items.map((r) => {
      const li = document.createElement("li");
      li.className = "grid grid-cols-[5.5rem_minmax(0,1fr)_auto] items-center gap-x-3 border-b border-cal px-4 py-3 last:border-b-0 sm:px-5";
      const cuando = document.createElement("div");
      cuando.className = "font-display tabular-nums";
      const f = document.createElement("p");
      f.className = "text-lg font-semibold";
      f.textContent = fmtHora(r.horaInicio);
      const d = document.createElement("p");
      d.className = "text-sm text-pizarra";
      d.textContent = fmtFecha(r.fecha);
      cuando.append(f, d);
      const mid = document.createElement("div");
      mid.className = "min-w-0";
      const t = document.createElement("p");
      t.className = "truncate font-semibold";
      t.textContent = r.cancha?.nombre || "Cancha";
      const s = document.createElement("p");
      s.className = "truncate text-sm text-pizarra";
      s.textContent = `${fmtHora(r.horaInicio)} a ${fmtHora(r.horaFin)}${r.codigo ? `, código ${r.codigo}` : ""}`;
      mid.append(t, s);
      const est = document.createElement("span");
      est.className = tonos[r.estado] || tonos.PENDIENTE;
      est.textContent = ESTADO[r.estado] || r.estado || "";
      li.append(cuando, mid, est);
      return li;
    }));
  }

  document.querySelectorAll(".tab").forEach((b) =>
    b.addEventListener("click", () => {
      tab = b.getAttribute("data-tab") || "activas";
      document.querySelectorAll(".tab").forEach((x) => x.setAttribute("aria-selected", x === b ? "true" : "false"));
      pintarReservas();
    })
  );

  function pintarAvatar(u) {
    const src = u.fotoUrl ? (u.fotoUrl.indexOf("http") === 0 ? u.fotoUrl : base + u.fotoUrl) : null;
    ["avatar", "avatar-big"].forEach((id) => {
      const el = $(id);
      if (!el) return;
      if (src) {
        // DOM API, no innerHTML: fotoUrl viene de la API.
        const img = document.createElement("img");
        img.setAttribute("src", src);
        img.alt = "Foto de perfil";
        img.className = "h-full w-full object-cover";
        el.replaceChildren(img);
      } else {
        el.textContent = (u.nombre || "?").trim().charAt(0).toUpperCase();
      }
    });
  }

  function pintarPerfil(u) {
    perfil = u;
    pintarAvatar(u);
    $("p-nombre").textContent = u.nombre.length > 24 ? u.nombre.slice(0, 24) + "…" : u.nombre;
    $("p-email").textContent = u.email || "";
    $("f-nombre").value = u.nombre || "";
    $("f-email").value = u.email || "";
    $("f-tel").value = u.telefono || "";
    // Fecha: fija para siempre; si está vacía se puede fijar una sola vez.
    const fFecha = $("f-fecha");
    const fNota = $("f-fecha-nota");
    fFecha.value = u.fechaNacimiento ? u.fechaNacimiento.slice(0, 10) : "";
    fFecha.disabled = Boolean(u.fechaNacimiento);
    if (fNota) fNota.textContent = u.fechaNacimiento ? "No se puede cambiar." : "Fíjala una vez: luego no se puede cambiar.";
    // Usuario: un cambio por año.
    const fUser = $("f-user");
    const uNota = $("f-user-nota");
    fUser.value = u.username || "";
    if (u.username && u.proximoCambioUsername) {
      fUser.disabled = true;
      if (uNota) uNota.textContent = `Podrás cambiarlo el ${new Date(u.proximoCambioUsername).toLocaleDateString("es-PE")}. Se puede cambiar una vez al año.`;
    } else {
      fUser.disabled = false;
      if (uNota) uNota.textContent = u.username ? "Puedes cambiarlo ahora; luego, una vez al año." : "De 3 a 20 caracteres: letras, números, _ . o -. Se puede cambiar una vez al año.";
    }
  }

  function pintarStats() {
    const cuenta = (e) => String(reservas.filter((r) => r.estado === e).length);
    $("st-total").textContent = String(reservas.length);
    $("st-conf").textContent = cuenta("CONFIRMADA");
    $("st-comp").textContent = cuenta("COMPLETADA");
    $("st-pend").textContent = cuenta("PENDIENTE");
  }

  async function cargar() {
    try {
      const res = await fetch(`${base}/api/auth/me`, { credentials: "include" });
      if (res.status === 401) {
        $("login-aviso").hidden = false;
        $("p-nombre").textContent = "Sin sesión";
        return;
      }
      const body = await res.json().catch(() => null);
      if (!res.ok || !body?.usuario) throw new Error("No se pudo cargar tu perfil");
      pintarPerfil(body.usuario);
      const res2 = await fetch(`${base}/api/reservas`, { credentials: "include" });
      const b2 = await res2.json().catch(() => null);
      reservas = Array.isArray(b2?.reservas) ? b2.reservas : [];
      pintarStats();
      pintarReservas();
    } catch {
      $("p-nombre").textContent = "Sin conexión";
      $("p-email").textContent = "Inténtalo de nuevo en unos minutos.";
    }
  }

  const okMsg = $("save-msg");
  const errMsg = $("save-err");
  const avisar = (msg) => {
    okMsg.hidden = true;
    errMsg.textContent = msg || "";
    errMsg.hidden = !msg;
  };

  $("btn-foto")?.addEventListener("click", () => $("f-foto").click());
  $("f-foto")?.addEventListener("change", async () => {
    const input = $("f-foto");
    avisar("");
    if (!perfil) return avisar("Entra a tu cuenta para subir tu foto.");
    if (!input.files || !input.files[0]) return;
    if (input.files[0].size > 3 * 1024 * 1024) {
      input.value = "";
      return avisar("La imagen no puede superar 3 MB.");
    }
    try {
      const fd = new FormData();
      fd.append("archivo", input.files[0]);
      const res = await fetch(base + "/api/usuarios/me/foto", { method: "POST", credentials: "include", body: fd });
      const body = await res.json().catch(() => null);
      if (!res.ok) throw new Error(body?.error || "No se pudo subir la foto");
      perfil.fotoUrl = body.fotoUrl;
      pintarAvatar(perfil);
      okMsg.textContent = "Foto actualizada.";
      okMsg.hidden = false;
    } catch (e) {
      avisar(e instanceof Error ? e.message : "No se pudo subir la foto");
    } finally {
      input.value = "";
    }
  });

  $("btn-save")?.addEventListener("click", async () => {
    avisar("");
    if (!perfil) return avisar("Entra a tu cuenta para guardar cambios.");
    const payload = {};
    const nuevoUser = $("f-user").value.trim().toLowerCase();
    if (nuevoUser && nuevoUser !== (perfil.username || "")) payload.username = nuevoUser;
    const fFecha = $("f-fecha");
    if (!perfil.fechaNacimiento && fFecha.value) payload.fechaNacimiento = fFecha.value;
    const tel = $("f-tel").value.trim();
    if (tel !== (perfil.telefono || "")) payload.telefono = tel;
    if (Object.keys(payload).length === 0) return avisar("No hay cambios para guardar.");
    try {
      const res = await fetch(`${base}/api/usuarios/me`, {
        method: "PATCH",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const body = await res.json().catch(() => null);
      if (!res.ok) throw new Error(body?.error || "No se pudo guardar");
      if (body?.usuario) pintarPerfil({ ...perfil, ...body.usuario });
      okMsg.textContent = "Cambios guardados.";
      okMsg.hidden = false;
    } catch (e) {
      avisar(e instanceof Error ? e.message : "No se pudo guardar");
    }
  });

  cargar();
})();
</script>
