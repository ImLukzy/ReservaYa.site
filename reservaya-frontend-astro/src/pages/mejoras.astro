---
// Sugerencias: se envían a la bandeja (PUBLIC_INBOXMEJIKAI_ENDPOINT). Sin bandeja o si
// falla, se ofrece el correo con el texto listo; nunca se da por enviada una idea que no salió.
import BaseLayout from "../layouts/BaseLayout.astro";
import Field from "../components/ui/Field.astro";
import Button from "../components/ui/Button.astro";
import { EMAIL } from "../lib/contacto";
import { AVISO } from "../lib/estilos";
---

<BaseLayout title="Envía una sugerencia | ReservaYa" description="¿Qué mejorarías de ReservaYa? Cuéntanos tu idea.">
  <section class="mx-auto max-w-texto px-4 pb-16 pt-8 md:px-6 lg:pt-12">
    <div class="flex items-center gap-2">
      <span class="font-display text-xs font-bold uppercase tracking-wider text-cesped-hondo">Ideas de la comunidad</span>
      <span class="text-xs text-pizarra">·</span>
      <span class="font-display text-xs font-bold uppercase tracking-wider text-pizarra">Mejoremos juntos</span>
    </div>
    <h1 class="mt-2 font-display text-4xl font-black tracking-tight text-basalto sm:text-5xl">Envía una sugerencia</h1>
    <p class="mt-3 text-base text-pizarra sm:text-lg">¿Qué te falta o qué mejorarías? Leemos cada mensaje.</p>

    <form id="idea-form" class="card-tactil mt-8 space-y-4 bg-tiza p-5 shadow-dura sm:p-7" novalidate>
      <div class="flex flex-wrap items-center justify-between gap-2 border-b-2 border-cal pb-3">
        <p class="font-display text-xl font-black text-basalto">Describe tu propuesta</p>
        <p class="text-sm text-pizarra">Envías como <strong id="idea-user" class="font-semibold text-basalto">invitado</strong>.</p>
      </div>
      <Field id="idea-distrito" name="distrito" etiqueta="Distrito (opcional)" maxlength="80" placeholder="Cayma" />
      <Field id="idea-text" name="idea" etiqueta="Tu idea" multilinea filas={6} maxlength="1000" placeholder="Cuéntanos qué te gustaría ver en ReservaYa." nota="Mínimo 10 caracteres." />
      <p class="text-right text-sm text-pizarra"><span id="idea-count" class="tabular-nums">0</span> de 1000</p>
      <p id="idea-status" hidden role="alert" class={AVISO.error}></p>
      <a id="idea-mail" hidden class="inline-flex min-h-11 items-center font-semibold text-cesped-hondo underline" href={`mailto:${EMAIL}`}>Enviarla por correo</a>
      <Button type="submit" id="idea-submit" disabled class="w-full shadow-dura-sm">Enviar sugerencia</Button>
    </form>

    <div id="success-card" hidden role="status" class="card-tactil mt-8 bg-cesped-suave p-6 text-center shadow-dura">
      <p class="font-display text-2xl font-black text-basalto">Recibimos tu idea</p>
      <p class="mx-auto mt-2 max-w-sm text-pizarra">Gracias por ayudarnos a mejorar ReservaYa.</p>
      <div class="mt-5 flex flex-col justify-center gap-3 sm:flex-row">
        <Button id="otra-idea" variante="secundario">Enviar otra idea</Button>
        <Button href="/canchas">Buscar canchas</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { API } from "../lib/entorno";
  import { EMAIL } from "../lib/contacto";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const userEl = $("idea-user");
  const area = $<HTMLTextAreaElement>("idea-text");
  const count = $("idea-count");
  const submit = $<HTMLButtonElement>("idea-submit");
  const form = $<HTMLFormElement>("idea-form");
  const status = $("idea-status");
  const mail = $<HTMLAnchorElement>("idea-mail");
  const exito = $("success-card");

  fetch(`${API}/api/auth/me`, { credentials: "include" })
    .then((r) => (r.ok ? r.json() : null))
    .then((b: { usuario?: { nombre?: string } } | null) => { if (userEl && b?.usuario?.nombre) userEl.textContent = b.usuario.nombre.trim(); })
    .catch(() => {});

  const validar = () => {
    if (count) count.textContent = String(area?.value.length ?? 0);
    if (submit) submit.disabled = (area?.value.trim().length ?? 0) < 10;
  };
  area?.addEventListener("input", validar);
  validar();

  $("otra-idea")?.addEventListener("click", () => {
    form?.reset();
    validar();
    if (exito) exito.hidden = true;
    if (form) form.hidden = false;
    area?.focus();
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!area || area.value.trim().length < 10) return;
    const distrito = $<HTMLInputElement>("idea-distrito")?.value.trim() ?? "";
    const payload = { nombre: userEl?.textContent ?? "invitado", distrito, idea: area.value.trim(), page: location.pathname, fecha: new Date().toISOString() };
    const endpoint = document.body.dataset.inboxEndpoint ?? "";
    if (submit) submit.disabled = true;
    if (status) status.hidden = true;
    let enviada = false;
    if (endpoint) {
      try {
        const res = await fetch(endpoint, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
        enviada = res.ok;
      } catch {
        enviada = false;
      }
    }
    if (submit) submit.disabled = false;
    if (enviada) {
      if (form) form.hidden = true;
      if (exito) exito.hidden = false;
      return;
    }
    if (status) {
      status.textContent = `No pudimos enviarla desde aquí. Mándala a ${EMAIL} con el botón de abajo.`;
      status.hidden = false;
    }
    if (mail) {
      const cuerpo = `${payload.idea}${distrito ? `\n\nDistrito: ${distrito}` : ""}`;
      mail.href = `mailto:${EMAIL}?subject=${encodeURIComponent("Sugerencia para ReservaYa")}&body=${encodeURIComponent(cuerpo)}`;
      mail.hidden = false;
    }
  });
</script>
