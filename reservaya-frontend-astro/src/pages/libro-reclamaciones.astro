---
import BaseLayout from "../layouts/BaseLayout.astro";
import Field from "../components/ui/Field.astro";
import Select from "../components/ui/Select.astro";
import Button from "../components/ui/Button.astro";
import { EMAIL } from "../lib/contacto";
import { AVISO } from "../lib/estilos";

const tipos = [
  { valor: "Queja", etiqueta: "Queja" },
  { valor: "Reclamo", etiqueta: "Reclamo" },
];
const clases = AVISO;
---

<BaseLayout title="Libro de reclamaciones | ReservaYa" description="Registra tu queja o reclamo. Respondemos en un plazo máximo de 15 días hábiles." robots="noindex, follow">
  <section class="mx-auto max-w-texto px-4 pb-16 pt-8 md:px-6 lg:pt-12">
    <h1 class="text-3xl lg:text-4xl">Libro de reclamaciones</h1>
    <p class="mt-3 text-pizarra">Registra tu queja o reclamo. Respondemos en un plazo máximo de 15 días hábiles, según el Código de Protección y Defensa del Consumidor (Ley N.º 29571).</p>

    <form data-inbox="inboxMejikai" class="mt-8 space-y-4 rounded-surface border border-cal bg-tiza p-5 sm:p-6" novalidate>
      <div class="grid gap-4 sm:grid-cols-2">
        <Field id="lr-nombre" name="nombre" etiqueta="Nombre completo" required autocomplete="name" />
        <Field id="lr-email" name="email" type="email" etiqueta="Correo" required autocomplete="email" placeholder="tu@correo.com" />
      </div>
      <Select id="lr-tipo" name="tipo" etiqueta="Tipo" opciones={tipos} />
      <p class="text-sm text-pizarra">Queja: malestar por la atención. Reclamo: desacuerdo con el servicio o el cobro.</p>
      <Field id="lr-detalle" name="detalle" etiqueta="Qué pasó" multilinea filas={5} required minlength="10" placeholder="Fecha, complejo y lo que ocurrió." />
      <Field id="lr-pedido" name="pedido" etiqueta="Qué pides" multilinea filas={3} required minlength="5" />
      <p data-status hidden role="status"></p>
      <Button type="submit" data-submit class="w-full">Enviar reclamo</Button>
      <p class="text-center text-sm text-pizarra">También puedes escribir a <a href={`mailto:${EMAIL}`} class="font-semibold text-cesped-hondo underline">{EMAIL}</a>.</p>
    </form>
  </section>
</BaseLayout>

<script is:inline define:vars={{ clases, correo: EMAIL }}>
(function () {
  // Sin bandeja configurada (el envío global de BaseLayout no actúa): se valida
  // y se ofrece mandarlo por correo con el texto listo.
  if (document.body.dataset.inboxEndpoint) return;
  var form = document.querySelector('form[data-inbox="inboxMejikai"]');
  if (!form) return;
  form.addEventListener("submit", function (e) {
    e.preventDefault();
    var status = form.querySelector("[data-status]");
    var data = new FormData(form);
    var nombre = String(data.get("nombre") || "").trim();
    var email = String(data.get("email") || "").trim();
    var detalle = String(data.get("detalle") || "").trim();
    var pedido = String(data.get("pedido") || "").trim();
    function msg(t, ok) {
      if (!status) return;
      status.textContent = t;
      status.className = ok ? clases.ok : clases.error;
      status.hidden = false;
    }
    if (nombre.length < 3 || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) || detalle.length < 10 || pedido.length < 5) {
      msg("Revisa los datos: nombre, correo válido, qué pasó (mínimo 10 caracteres) y qué pides.");
      return;
    }
    var body = "Nombre: " + nombre + "\nCorreo: " + email + "\nTipo: " + String(data.get("tipo") || "") + "\n\nQué pasó:\n" + detalle + "\n\nQué pido:\n" + pedido;
    msg("Tu reclamo está listo. Envíalo a " + correo + " con el botón de abajo para registrarlo.", true);
    var prev = form.querySelector("[data-correo]");
    if (prev) prev.remove();
    var mail = document.createElement("a");
    mail.setAttribute("data-correo", "");
    mail.href = "mailto:" + correo + "?subject=" + encodeURIComponent("Reclamo - Libro de reclamaciones") + "&body=" + encodeURIComponent(body);
    mail.className = "inline-flex min-h-11 items-center font-semibold text-cesped-hondo underline";
    mail.textContent = "Abrir mi correo con el reclamo";
    if (status && status.parentNode) status.parentNode.insertBefore(mail, status.nextSibling);
  });
})();
</script>
