---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthCard from "../components/AuthCard.astro";
import BotonGoogle from "../components/ui/BotonGoogle.astro";
import Field from "../components/ui/Field.astro";
import Button from "../components/ui/Button.astro";
import { API, APP } from "../lib/entorno";
import { BOTON } from "../lib/estilos";

const apiUrl = API;
const appUrl = APP;
---

<BaseLayout title="Crear cuenta | ReservaYa" description="Crea tu cuenta de ReservaYa para reservar canchas en Arequipa." robots="noindex, follow">
  <AuthCard titulo="Crea tu cuenta" texto="Te pedimos lo justo para reservar y para que te agreguen a los partidos.">
    <p slot="arriba" id="rg-paso" class="mb-2 text-sm font-medium text-pizarra">Paso 1 de 2</p>

    <div class="reg-step space-y-4" data-step="1">
      <Field id="rg-nombre" type="text" etiqueta="Nombre completo" autocomplete="name" placeholder="Nombre y apellido" />
      <Field id="rg-fecha" type="date" etiqueta="Fecha de nacimiento" nota="No se puede cambiar después." />
      <Field id="rg-user" type="text" etiqueta="Tu usuario" autocomplete="username" placeholder="tucrack10" nota="Con él te agregan a sorteos y partidos. Lo sugerimos desde tu nombre." />
      <p hidden class="text-sm font-medium text-error" data-err role="alert"></p>
      <Button id="to-step2" class="w-full">Continuar</Button>
      <div class="relative my-6 flex items-center">
        <div class="flex-grow border-t border-cal"></div>
        <span class="mx-4 text-sm text-pizarra">o</span>
        <div class="flex-grow border-t border-cal"></div>
      </div>
      <BotonGoogle id="rg-google" />
    </div>

    <div class="reg-step space-y-4" data-step="2" hidden>
      <Field id="rg-email" type="email" etiqueta="Correo" autocomplete="email" placeholder="tu@correo.com" />
      <Field id="rg-pass" type="password" etiqueta="Contraseña" autocomplete="new-password" nota="Mínimo 6 caracteres." />
      <Field id="rg-pass2" type="password" etiqueta="Repite la contraseña" autocomplete="new-password" />
      <p hidden class="text-sm font-medium text-error" data-err role="alert"></p>
      <div class="flex gap-3">
        <Button id="back-step1" variante="secundario">Atrás</Button>
        <Button id="rg-submit" class="flex-1">Crear mi cuenta</Button>
      </div>
    </div>

    <p slot="pie" class="text-pizarra">¿Ya tienes cuenta? <a href="/login" class={BOTON.texto}>Entrar</a></p>
  </AuthCard>
</BaseLayout>

<script is:inline define:vars={{ apiUrl, appUrl }}>
  const steps = [...document.querySelectorAll(".reg-step")];
  const pasoLabel = document.getElementById("rg-paso");
  const nombre = document.getElementById("rg-nombre");
  const fecha = document.getElementById("rg-fecha");
  const user = document.getElementById("rg-user");
  const email = document.getElementById("rg-email");
  const pass = document.getElementById("rg-pass");
  const pass2 = document.getElementById("rg-pass2");
  const submit = document.getElementById("rg-submit");
  const googleBtn = document.getElementById("rg-google");

  function getSafeReturnUrl(rawUrl, fallbackUrl) {
    if (!rawUrl) return fallbackUrl;
    try {
      if (rawUrl.startsWith("/") && !rawUrl.startsWith("//") && !rawUrl.startsWith("/\\")) {
        const parsed = new URL(rawUrl, window.location.origin);
        if (parsed.origin === window.location.origin) {
          return parsed.pathname + parsed.search + parsed.hash;
        }
      }
      const parsed = new URL(rawUrl);
      const allowedOrigins = [window.location.origin];
      try {
        if (appUrl) allowedOrigins.push(new URL(appUrl).origin);
      } catch {}
      if (allowedOrigins.includes(parsed.origin)) {
        return parsed.href;
      }
    } catch {}
    return fallbackUrl;
  }

  googleBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    const returnUrl = new URLSearchParams(window.location.search).get("returnUrl");
    const safeUrl = returnUrl ? getSafeReturnUrl(returnUrl, "") : "";
    window.location.href = `${apiUrl}/api/auth/google${safeUrl ? `?returnUrl=${encodeURIComponent(safeUrl)}` : ""}`;
  });

  function goStep(n) {
    steps.forEach((s) => { s.hidden = s.dataset.step !== String(n); });
    if (pasoLabel) pasoLabel.textContent = `Paso ${n} de 2`;
    const primero = document.querySelector(`.reg-step[data-step="${n}"] input`);
    if (primero) primero.focus();
  }
  function err(step, msg) {
    const p = document.querySelector(`.reg-step[data-step="${step}"] [data-err]`);
    if (!p) return;
    p.textContent = msg || "";
    p.hidden = !msg;
  }

  // Sugerir @usuario desde el nombre
  nombre?.addEventListener("input", () => {
    if (document.activeElement === user) return;
    const base = nombre.value.trim().toLowerCase()
      .normalize("NFD").replace(/[̀-ͯ]/g, "")
      .replace(/[^a-z0-9]+/g, "");
    if (base.length >= 3 && !user.dataset.touched) {
      user.value = base.slice(0, 14) + Math.floor(10 + Math.random() * 90);
    }
  });
  user?.addEventListener("input", () => { user.dataset.touched = "1"; });

  document.getElementById("to-step2")?.addEventListener("click", () => {
    if (nombre.value.trim().length < 3) return err(1, "Escribe tu nombre completo.");
    if (!fecha.value) return err(1, "Elige tu fecha de nacimiento.");
    if (!/^[a-zA-Z0-9_.]{3,20}$/.test(user.value.trim())) return err(1, "Tu usuario: de 3 a 20 caracteres (letras, números, _ o .).");
    err(1, "");
    goStep(2);
  });
  document.getElementById("back-step1")?.addEventListener("click", () => goStep(1));

  submit?.addEventListener("click", async () => {
    const mail = email.value.trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail)) return err(2, "Escribe un correo válido.");
    if (pass.value.length < 6) return err(2, "La contraseña debe tener al menos 6 caracteres.");
    if (pass.value !== pass2.value) return err(2, "Las contraseñas no coinciden.");
    err(2, "");
    submit.disabled = true;
    submit.textContent = "Creando cuenta...";
    try {
      const response = await fetch(`${apiUrl}/api/auth/register`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          nombre: nombre.value.trim(),
          email: mail,
          password: pass.value,
          fechaNacimiento: fecha.value,
          username: user.value.trim().toLowerCase(),
        }),
      });
      const body = await response.json().catch(() => null);
      if (!response.ok) throw new Error(body?.error || "No se pudo crear la cuenta");
      window.location.href = `${appUrl}/dashboard`;
    } catch (error) {
      err(2, error instanceof TypeError
        ? "No se pudo conectar con el servidor. Inténtalo de nuevo en unos minutos."
        : error instanceof Error ? error.message : "No se pudo crear la cuenta");
      submit.disabled = false;
      submit.textContent = "Crear mi cuenta";
    }
  });
</script>
