---
// La tabla de planes vive en /duenos#planes (spec 20: una sola tabla).
import BaseLayout from "../layouts/BaseLayout.astro";
import { BOTON } from "../lib/estilos";
---

<BaseLayout title="Planes y precios | ReservaYa para dueños" description="Planes para publicar y gestionar tu complejo deportivo." robots="noindex, follow">
  <meta http-equiv="refresh" content="0; url=/duenos#planes" slot="head" />
  <section class="mx-auto max-w-texto px-4 py-16 text-center">
    <p class="text-pizarra">Los planes están en la página de dueños.</p>
    <a href="/duenos#planes" class={`${BOTON.primario} mt-4`}>Ver planes y precios</a>
  </section>
</BaseLayout>

<script is:inline>
  window.location.replace("/duenos#planes");
</script>
