---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Precios | ReservaYa para dueños"
  description="Planes simples para tu complejo: publicación gratis, gestión total y red de sedes."
  announcement="🎾 ReservaYa ya está en Google Play — Descarga la app gratis"
>
  <section class="relative left-1/2 w-screen -translate-x-1/2 bg-[#F5F5F3] px-4 py-14 md:px-8">
    <div class="mx-auto max-w-6xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-[#BBF7D0] bg-[#DCFCE7]/60 px-4 py-1.5 text-xs font-bold text-[#15803D]">Precios simples, sin letra chica</span>
      <h1 class="reveal mx-auto mt-4 max-w-2xl text-4xl font-black tracking-tight text-[#101613] md:text-6xl">Un plan para cada <span class="text-[#16A34A]">cancha.</span></h1>
      <p class="mx-auto mt-3 max-w-xl text-[#5B6660]">Empieza gratis. Sube de plan cuando tus reservas despeguen.</p>
      <div class="mt-6 flex justify-center rounded-full bg-[#EDEEEC] p-1 text-sm font-semibold w-fit mx-auto">
        <button id="btn-men" type="button" class="rounded-full bg-[#060A08] px-4 py-2 text-white">Mensual</button>
        <button id="btn-anu" type="button" class="rounded-full px-4 py-2 text-[#5B6660]">Anual −20%</button>
      </div>

      <div class="mt-8 grid gap-5 text-left md:grid-cols-3">
        {[
          ["Publicación", "0", "Para aparecer en el marketplace", ["Perfil público + QR WhatsApp", "Reservas online 24/7", "1 complejo · 2 canchas"]],
          ["Gestión Total", "89.90", "Agenda + caja + equipo", ["Todo lo de Publicación", "Agenda sin solapamientos", "Caja POS + Yape/Culqi", "Roles para tu personal"]],
          ["Red de Sedes", "199", "Multi-sede + reportes", ["Todo lo de Gestión Total", "Sedes ilimitadas", "Reportes y metas globales", "Soporte prioritario"]],
        ].map(([n, p, d, feats], i) => (
          <div class={`reveal rounded-2xl border bg-white p-7 ${i === 1 ? "border-[#22C55E] shadow-[0_8px_30px_rgba(34,197,94,0.18)]" : "border-[#E7E5E4]"}`} data-reveal-delay={String(i * 100)}>
            <h2 class="font-bold text-[#101613]">{n}</h2>
            <p class="mt-2 text-4xl font-black text-[#101613]">S/ <span class="precio" data-men={p} data-anu={p === "0" ? "0" : String((parseFloat(p) * 0.8).toFixed(2))}>{p}</span><small class="text-sm font-normal text-[#8A938D]">/mes</small></p>
            <p class="mt-1 text-sm text-[#5B6660]">{d}</p>
            <ul class="mt-4 space-y-2 text-sm text-[#3F4A44]">
              {(feats as string[]).map((f) => <li>✓ {f}</li>)}
            </ul>
            <a href="/register?plan=dueno" class={`mt-6 block rounded-xl py-3 text-center font-bold transition ${i === 1 ? "bg-[#22C55E] text-white hover:bg-[#16A34A]" : "border border-[#E7E5E4] text-[#101613] hover:border-[#22C55E]"}`}>Empezar gratis</a>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm text-[#5B6660]">¿Tienes un complejo? <a href="/publica-tu-cancha" class="font-bold text-[#16A34A] hover:underline">Publícalo gratis →</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  const bm = document.getElementById("btn-men");
  const ba = document.getElementById("btn-anu");
  const precios = [...document.querySelectorAll<HTMLElement>(".precio")];
  function modo(anual: boolean) {
    precios.forEach((p) => (p.textContent = anual ? p.dataset.anu ?? "" : p.dataset.men ?? ""));
    bm!.className = `rounded-full px-4 py-2 ${!anual ? "bg-[#060A08] text-white" : "text-[#5B6660]"}`;
    ba!.className = `rounded-full px-4 py-2 ${anual ? "bg-[#060A08] text-white" : "text-[#5B6660]"}`;
  }
  bm?.addEventListener("click", () => modo(false));
  ba?.addEventListener("click", () => modo(true));
</script>
