---
// Page: login
import BaseLayout from "../layouts/BaseLayout.astro";
import LoginForm from "../components/LoginForm.astro";
---

<BaseLayout title="Iniciar sesi&oacute;n" robots="noindex, follow">
  <section class="relative -mx-10 flex min-h-[calc(100vh-9rem)] items-center justify-center overflow-hidden px-4 py-12 md:-mx-16" style="background: radial-gradient(circle at center, color-mix(in srgb, var(--accent-main) 12%, transparent), transparent 46%), color-mix(in srgb, var(--bg-main) 92%, #000);">
    <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="login-title"
      class="relative z-10 w-full max-w-[470px] rounded-2xl p-7 shadow-2xl md:p-9"
      style="background: var(--bg-card); border: 1px solid var(--border-main);"
    >
      <a href="/" aria-label="Cerrar inicio de sesión" class="absolute right-5 top-5 flex h-9 w-9 items-center justify-center rounded-full text-xl transition hover:bg-[var(--bg-muted)]" style="color: var(--text-muted);">
        &times;
      </a>
      <div class="text-center">
        <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl text-3xl shadow-lg" style="background: linear-gradient(135deg, var(--accent-main), #211112);">🏟️</div>
        <h1 id="login-title" class="text-2xl md:text-3xl font-bold tracking-tight" style="color: var(--text-main);">
          Inicia sesi&oacute;n
        </h1>
        <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed" style="color: var(--text-muted);">Contin&uacute;a para gestionar tus solicitudes y jugar confirmado.</p>
      </div>
      <LoginForm />
    </div>
  </section>
</BaseLayout>
