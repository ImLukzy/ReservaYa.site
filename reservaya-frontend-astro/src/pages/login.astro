---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthCard from "../components/AuthCard.astro";
import BotonGoogle from "../components/ui/BotonGoogle.astro";
import Field from "../components/ui/Field.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import { API, APP } from "../lib/entorno";
import { AVISO, BOTON } from "../lib/estilos";

const apiUrl = API;
const appUrl = APP;
const claseError = AVISO.error;
---

<BaseLayout title="Entrar | ReservaYa" description="Entra a tu cuenta de ReservaYa para reservar canchas y ver tus partidos." robots="noindex, follow">
  <AuthCard titulo="Entrar a tu cuenta" texto="Con tu cuenta reservas canchas y ves tus partidos.">
    <form id="login-page-form" class="space-y-4" novalidate>
      <Field id="lp-email" name="email" type="email" etiqueta="Correo" required autocomplete="email" placeholder="tu@correo.com" />
      <Field id="lp-pass" name="password" type="password" etiqueta="Contraseña" required autocomplete="current-password" claseCampo="pr-12">
        <button id="lp-eye" type="button" aria-label="Mostrar contraseña" aria-pressed="false" class="absolute right-0 top-0 flex h-11 w-11 items-center justify-center rounded-control text-pizarra hover:text-basalto">
          <Icon nombre="ojo" />
        </button>
      </Field>
      <a href="/forgot-password" class={`${BOTON.texto} text-sm`}>¿Olvidaste tu contraseña?</a>
      <p id="lp-status" hidden role="alert" class={claseError}></p>
      <Button type="submit" id="lp-submit" class="w-full">Entrar</Button>
      <div class="relative my-6 flex items-center">
        <div class="flex-grow border-t border-cal"></div>
        <span class="mx-4 text-sm text-pizarra">o</span>
        <div class="flex-grow border-t border-cal"></div>
      </div>
      <BotonGoogle id="lp-google" />
    </form>
    <p slot="pie" class="text-pizarra">¿No tienes cuenta? <a href="/register" class={BOTON.texto}>Crear una cuenta</a></p>
  </AuthCard>
</BaseLayout>

<script is:inline define:vars={{ apiUrl, appUrl }}>
  const form = document.getElementById("login-page-form");
  const status = document.getElementById("lp-status");
  const submit = document.getElementById("lp-submit");
  const pass = document.getElementById("lp-pass");
  const googleBtn = document.getElementById("lp-google");

  function getSafeReturnUrl(rawUrl, fallbackUrl) {
    if (!rawUrl) return fallbackUrl;
    try {
      if (rawUrl.startsWith("/") && !rawUrl.startsWith("//") && !rawUrl.startsWith("/\\")) {
        const parsed = new URL(rawUrl, window.location.origin);
        if (parsed.origin === window.location.origin) {
          return parsed.pathname + parsed.search + parsed.hash;
        }
      }
      const parsed = new URL(rawUrl);
      const allowedOrigins = [window.location.origin];
      try {
        if (appUrl) allowedOrigins.push(new URL(appUrl).origin);
      } catch {}
      if (allowedOrigins.includes(parsed.origin)) {
        return parsed.href;
      }
    } catch {}
    return fallbackUrl;
  }

  // Espejo de fallbackPorRol (reservaya-nextjs-api/lib/permissions.ts).
  const inicioPorRol = { TECNICO: "/tecnico", SUPERADMIN: "/admin", ADMIN: "/admin/agenda" };
  const query = new URLSearchParams(window.location.search);

  if (query.get("error") === "google" && status) {
    status.textContent = "No pudimos entrar con Google. Inténtalo de nuevo o usa tu correo y contraseña.";
    status.hidden = false;
  }

  // La API vuelve aquí con ?google=ok tras crear la sesión; se lleva a cada rol a su inicio.
  if (query.get("google") === "ok") {
    fetch(`${apiUrl}/api/auth/me`, { credentials: "include" })
      .then((r) => (r.ok ? r.json() : null))
      .then((body) => {
        const role = body?.usuario?.rol ?? body?.rol;
        if (!role) return;
        window.location.href = getSafeReturnUrl(query.get("returnUrl"), appUrl + (inicioPorRol[role] || "/dashboard"));
      })
      .catch(() => {});
  }

  googleBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    const returnUrl = query.get("returnUrl");
    const safeUrl = returnUrl ? getSafeReturnUrl(returnUrl, "") : "";
    window.location.href = `${apiUrl}/api/auth/google${safeUrl ? `?returnUrl=${encodeURIComponent(safeUrl)}` : ""}`;
  });

  document.getElementById("lp-eye")?.addEventListener("click", (e) => {
    const btn = e.currentTarget;
    const show = pass.type === "password";
    pass.type = show ? "text" : "password";
    btn.setAttribute("aria-label", show ? "Ocultar contraseña" : "Mostrar contraseña");
    btn.setAttribute("aria-pressed", String(show));
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(submit instanceof HTMLButtonElement) || !status) return;
    submit.disabled = true;
    submit.textContent = "Entrando...";
    status.hidden = true;
    const data = new FormData(form);
    try {
      const response = await fetch(`${apiUrl}/api/auth/login`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: data.get("email"), password: data.get("password") }),
      });
      const body = await response.json().catch(() => null);
      if (!response.ok) {
        if (response.status === 429) {
          throw new Error("Demasiados intentos. Espera 15 minutos antes de reintentar.");
        }
        throw new Error(body?.error || "No se pudo entrar. Revisa tu correo y contraseña.");
      }
      const role = body?.usuario?.rol;
      const params = new URLSearchParams(window.location.search);
      // Espejo de fallbackPorRol (reservaya-nextjs-api/lib/permissions.ts).
      const inicio = { TECNICO: "/tecnico", SUPERADMIN: "/admin", ADMIN: "/admin/agenda" };
      const defaultUrl = appUrl + (inicio[role] || "/dashboard");
      window.location.href = getSafeReturnUrl(params.get("returnUrl"), defaultUrl);
    } catch (error) {
      status.textContent = error instanceof TypeError
        ? "No se pudo conectar con el servidor. Inténtalo de nuevo en unos minutos."
        : error instanceof Error ? error.message : "No se pudo entrar";
      status.hidden = false;
      submit.disabled = false;
      submit.textContent = "Entrar";
    }
  });
</script>
