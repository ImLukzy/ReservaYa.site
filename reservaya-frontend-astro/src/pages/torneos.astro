---
// La API no publica torneos para jugadores (TorneosController exige ADMIN/SUPERADMIN/TECNICO):
// sin lista pública no se muestran torneos. BLOQUEO-API anotado en la spec 20.
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Torneos | ReservaYa" description="Torneos organizados por complejos deportivos de Arequipa con ReservaYa.">
  <section class="mx-auto max-w-page px-4 pb-12 pt-8 md:px-6 lg:pt-12">
    <h1 class="text-3xl lg:text-4xl">Torneos</h1>
    <p class="mt-3 max-w-xl text-lg text-pizarra">Los complejos de Arequipa organizan sus torneos en ReservaYa: inscripción de equipos, partidos y resultados.</p>
    <EmptyState
      class="mt-8"
      titulo="Todavía no hay torneos con inscripción en línea"
      texto="Por ahora te inscribes en el complejo que organiza el torneo. Pregunta en tu cancha de siempre."
    >
      <Button href="/canchas" variante="secundario">Buscar canchas</Button>
    </EmptyState>
  </section>

  <section aria-labelledby="organiza-titulo" class="border-t-2 border-basalto bg-tiza">
    <div class="mx-auto flex max-w-page flex-col gap-6 px-4 py-12 md:flex-row md:items-center md:justify-between md:px-6">
      <div>
        <h2 id="organiza-titulo" class="text-2xl lg:text-3xl">¿Organizas un torneo en tu complejo?</h2>
        <p class="mt-2 max-w-xl text-pizarra">Desde el panel inscribes a los equipos, armas los partidos y registras los resultados.</p>
      </div>
      <Button href="/duenos#torneos" class="shrink-0">Ver cómo funciona</Button>
    </div>
  </section>
</BaseLayout>
