---
import BaseLayout from "../layouts/BaseLayout.astro";

const torneos = [
  { nombre: "TORNEO DE BIENVENIDA", deporte: "Fútbol 7", fechas: "6 ago. – 8 ago.", lugar: "Av. Ejército 123, Cayma, Arequipa", cupo: "Cupo: 8 equipos", precio: "Gratis", por: "por equipo", inscritos: 5 },
  { nombre: "TORNEO MISTIANO", deporte: "Fútbol 7", fechas: "12 jul.", lugar: "Av. Universidad 170, Yanahuara, Arequipa", cupo: "Cupo: 8 equipos", precio: "S/ 280", por: "por equipo", inscritos: 8 },
];
---

<BaseLayout
  title="Del barrio a la gloria | Torneos ReservaYa"
  description="Inscribe tu equipo, compite contra los mejores de Arequipa y llévate la copa."
  announcement="⨯ Arma equipos parejos — ¿nadie quiere elegir? Sórtalos gratis"
>
  <section id="torneos-hero" class="relative left-1/2 w-screen -translate-x-1/2 overflow-hidden bg-white px-4 pt-14 pb-40 md:px-8">
    <p class="pointer-events-none absolute inset-x-0 top-8 text-center font-black leading-none text-[#101613]/[0.07] select-none" style="font-size: clamp(120px, 24vw, 340px);" aria-hidden="true">TORNEO</p>
    <canvas id="confetti" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

    <div class="relative mx-auto max-w-5xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-[#BBF7D0] bg-[#DCFCE7]/70 px-4 py-1.5 text-xs font-bold text-[#15803D]">🏆 Temporada 2026</span>
      <h1 class="reveal mt-5 text-5xl font-black tracking-tight text-[#101613] md:text-6xl">Del barrio a la <span class="text-[#16A34A]">gloria.</span></h1>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-[#5B6660]">Inscribe tu equipo, compite contra los mejores del Perú y llévate la copa. Cupos limitados.</p>

      <div id="torneos-grid" class="mx-auto mt-16 grid max-w-3xl gap-5 text-left md:grid-cols-2" aria-live="polite">
        {torneos.map((t) => (
          <article class="overflow-hidden rounded-2xl border border-[#E7E5E4] bg-white shadow-[0_2px_8px_rgba(0,0,0,0.05)]">
            <div class="relative bg-gradient-to-b from-[#0A3D22] to-[#060A08] p-5 pb-8 text-center">
              <span class="absolute top-3 left-3 rounded-full bg-[#DCFCE7] px-3 py-1 text-[11px] font-bold text-[#15803D]">Inscripciones abiertas</span>
              <p class="mt-6 text-6xl text-white/90">🏆</p>
              <h2 class="mt-3 text-lg font-black tracking-wide text-white">{t.nombre}</h2>
            </div>
            <div class="space-y-2 p-5 text-sm text-[#5B6660]">
              <span class="inline-block rounded-md bg-[#F5F5F3] px-2 py-0.5 text-xs font-bold text-[#3F4A44]">{t.deporte}</span>
              <p>📅 {t.fechas}</p>
              <p>📍 {t.lugar}</p>
              <p>◔ {t.cupo}</p>
              <div class="h-1.5 overflow-hidden rounded-full bg-[#EDEEEC]"><div class="h-full rounded-full bg-[#22C55E]" style={`width: ${(t.inscritos / 8) * 100}%`}></div></div>
              <p class="text-xs"><span class="inscritos-n" data-n={t.inscritos}>{t.inscritos}</span>/8 equipos inscritos</p>
            </div>
            <div class="flex items-center justify-between border-t border-gray-100 bg-[#FAFAF9] p-4">
              <p class="text-lg font-black text-[#101613]">{t.precio} <small class="text-xs font-normal text-[#8A938D]">{t.por}</small></p>
              <button type="button" data-torneo={t.nombre} class="inscribir btn-press rounded-xl bg-[#22C55E] px-4 py-2 text-sm font-bold text-white transition hover:bg-[#16A34A]">Inscribirse →</button>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Trofeo -->
    <svg class="pointer-events-none absolute -bottom-10 -left-10 w-56 opacity-90 md:w-72" viewBox="0 0 200 220" fill="none" aria-hidden="true">
      <path d="M55 20 h90 v10 c0 45 -18 78 -45 90 c27 12 45 45 45 90 v10 h-90 v-10 c0 -45 18 -78 45 -90 c-27 -12 -45 -45 -45 -90 z" fill="#FBE3A7" opacity="0.55"/>
      <ellipse cx="100" cy="30" rx="45" ry="12" fill="#FDF3D7"/>
      <ellipse cx="100" cy="30" rx="32" ry="7" fill="#FBE3A7"/>
      <path d="M55 45 C20 45 15 85 40 105 C50 113 62 116 72 115 L68 100 C60 100 52 96 48 88 C40 72 45 60 58 58 Z" fill="#FBE3A7" opacity="0.55"/>
      <path d="M145 45 C180 45 185 85 160 105 C150 113 138 116 128 115 L132 100 C140 100 148 96 152 88 C160 72 155 60 142 58 Z" fill="#FBE3A7" opacity="0.55"/>
      <rect x="88" y="118" width="24" height="40" rx="4" fill="#FBE3A7" opacity="0.55"/>
      <rect x="70" y="158" width="60" height="16" rx="6" fill="#FBE3A7" opacity="0.55"/>
      <rect x="60" y="174" width="80" height="14" rx="6" fill="#FBE3A7" opacity="0.45"/>
    </svg>

    <!-- Balón -->
    <svg class="pointer-events-none absolute -right-16 -bottom-20 w-72 md:w-[420px]" viewBox="0 0 200 200" fill="none" aria-hidden="true">
      <circle cx="100" cy="100" r="96" fill="#D9D9DE"/>
      <polygon points="100,72 127,92 117,124 83,124 73,92" fill="#A9ADB6"/>
      <polygon points="100,72 127,92 138,70 120,52 88,54" fill="#B9BDC6"/>
      <polygon points="73,92 83,124 60,132 44,108 52,80" fill="#B9BDC6"/>
      <polygon points="127,92 138,116 162,110 168,84 148,66" fill="#B9BDC6"/>
      <polygon points="83,124 117,124 118,152 100,168 82,152" fill="#B9BDC6"/>
      <g stroke="#F4F4F6" stroke-width="3">
        <line x1="100" y1="72" x2="100" y2="48"/><line x1="127" y1="92" x2="150" y2="80"/>
        <line x1="73" y1="92" x2="50" y2="80"/><line x1="83" y1="124" x2="70" y2="148"/>
        <line x1="117" y1="124" x2="130" y2="148"/>
      </g>
    </svg>
  </section>
</BaseLayout>

<script>
  // Confeti verde/oscuro/dorado al cargar
  (() => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const canvas = document.getElementById("confetti") as HTMLCanvasElement | null;
    const hero = document.getElementById("torneos-hero");
    if (!canvas || !hero) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const resize = () => {
      canvas.width = hero.clientWidth;
      canvas.height = hero.clientHeight;
    };
    resize();
    window.addEventListener("resize", resize);

    const colors = ["#22C55E", "#16A34A", "#0B132B", "#EAB308", "#4ADE80"];
    const parts = Array.from({ length: 130 }, () => {
      const left = Math.random() < 0.72;
      const ox = left ? canvas.width * (0.15 + Math.random() * 0.25) : canvas.width * (0.62 + Math.random() * 0.25);
      const oy = canvas.height * (0.1 + Math.random() * 0.35);
      const ang = Math.random() * Math.PI * 2;
      const sp = 2 + Math.random() * 4;
      return {
        x: ox, y: oy,
        vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp - 1.5,
        len: 5 + Math.random() * 9, rot: Math.random() * Math.PI,
        vr: (Math.random() - 0.5) * 0.25,
        color: colors[Math.floor(Math.random() * colors.length)],
        life: 1,
      };
    });

    let frames = 0;
    const tick = () => {
      frames++;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const fade = frames > 110 ? Math.max(0, 1 - (frames - 110) / 40) : 1;
      parts.forEach((p) => {
        p.x += p.vx; p.y += p.vy; p.vy += 0.09; p.rot += p.vr;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.globalAlpha = 0.9 * fade;
        ctx.strokeStyle = p.color;
        ctx.lineWidth = 2.4;
        ctx.beginPath();
        ctx.moveTo(-p.len / 2, 0);
        ctx.lineTo(p.len / 2, 0);
        ctx.stroke();
        ctx.restore();
      });
      if (frames < 150) requestAnimationFrame(tick);
      else ctx.clearRect(0, 0, canvas.width, canvas.height);
    };
    requestAnimationFrame(tick);
  })();

  // Pre-inscripción funcional
  document.querySelectorAll(".inscribir").forEach((b) =>
    b.addEventListener("click", () => {
      const btn = b as HTMLButtonElement;
      const card = btn.closest("article");
      const badge = card?.querySelector(".inscritos-n");
      if (badge) badge.textContent = String(Math.min(8, +badge.textContent! + 1));
      btn.textContent = "✓ Pre-inscrito";
      btn.disabled = true;
      btn.classList.add("opacity-70");
      showToast("Pre-inscripción registrada. Te contactaremos por WhatsApp para el pago.");
    })
  );

  function showToast(msg: string) {
    const toast = document.createElement("div");
    toast.className = "fixed bottom-4 right-4 z-50 rounded-xl bg-[#060A08] px-4 py-3 text-sm font-medium text-white shadow-xl animate-slide-up";
    toast.textContent = msg;
    document.body.appendChild(toast);
    setTimeout(() => { toast.classList.add("opacity-0", "transition-opacity", "duration-300"); setTimeout(() => toast.remove(), 300); }, 2500);
  }
</script>
