---
import BaseLayout from "../layouts/BaseLayout.astro";
const apiUrl = import.meta.env.PUBLIC_RESERVAYA_API_URL || "http://localhost:5000";
---

<BaseLayout
  title="Recupera tu contraseña | ReservaYa"
  description="Escribe tu correo y te enviamos un enlace para crear una nueva."
  robots="noindex, follow"
>
  <section class="relative left-1/2 flex min-h-[calc(100vh-7rem)] w-screen -translate-x-1/2 items-center justify-center bg-[#060A08] px-4 py-16">
    <div class="reveal w-full max-w-md text-center">
      <p class="text-2xl font-black tracking-tight text-white">Reserva<span class="text-[#22C55E]">Ya</span></p>
      <h1 class="mt-6 text-2xl font-extrabold text-white">¿Olvidaste tu contraseña?</h1>
      <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-white/50">Escribe tu correo y te enviamos un enlace para crear una nueva.</p>

      <form id="forgot-form" class="mt-8 text-left" novalidate>
        <label for="fp-email" class="mb-1.5 block text-[11px] font-bold tracking-wider text-white/50">CORREO ELECTRÓNICO</label>
        <div class="relative">
          <span class="absolute top-1/2 left-4 -translate-y-1/2 text-white/35" aria-hidden="true">✉</span>
          <input id="fp-email" name="email" type="email" required autocomplete="email" placeholder="tu@correo.com"
            class="w-full rounded-xl border border-white/10 bg-white/[0.06] py-3 pr-4 pl-11 text-sm text-white placeholder:text-white/30 focus:border-[#22C55E] focus:outline-none focus:ring-2 focus:ring-[#22C55E]/30" />
        </div>
        <p id="fp-status" class="hidden rounded-xl px-4 py-3 text-sm" role="alert"></p>
        <button id="fp-submit" type="submit" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-[#15803D] py-3.5 font-bold text-white transition hover:bg-[#16A34A] disabled:opacity-60">
          <span aria-hidden="true">→</span> Enviarme el enlace
        </button>
      </form>

      <div id="fp-done" class="hidden">
        <div class="mx-auto mt-8 flex h-14 w-14 items-center justify-center rounded-full bg-[#22C55E]/15 text-2xl text-[#4ADE80]">✓</div>
        <h2 class="mt-4 text-xl font-extrabold text-white">Revisa tu correo</h2>
        <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-white/50">Si existe una cuenta con ese correo, te enviamos un enlace para crear una nueva contraseña.</p>
      </div>

      <p class="mt-5 text-center"><a href="/login" class="text-xs font-bold text-[#4ADE80] hover:underline"><span aria-hidden="true">←</span> Volver a iniciar sesión</a></p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ apiUrl }}>
  const form = document.getElementById("forgot-form");
  const done = document.getElementById("fp-done");
  const status = document.getElementById("fp-status");
  const submit = document.getElementById("fp-submit");
  const email = document.getElementById("fp-email");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(submit instanceof HTMLButtonElement) || !status || !(email instanceof HTMLInputElement)) return;
    const mail = email.value.trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail)) {
      status.textContent = "Escribe un correo válido.";
      status.className = "rounded-xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-300";
      return;
    }
    submit.disabled = true;
    submit.innerHTML = "Enviando...";
    status.className = "hidden";
    try {
      await fetch(`${apiUrl.replace(/\/$/, "")}/api/auth/forgot-password`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: mail }),
      }).catch(() => null);
    } finally {
      // Respuesta genérica: no revelar si el correo existe o no.
      form.classList.add("hidden");
      done?.classList.remove("hidden");
    }
  });
</script>
