---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import { API } from "../lib/entorno";
import SeccionTitulo from "../components/inicio/SeccionTitulo.astro";
import PreguntasTactiles, { type Pregunta } from "../components/inicio/PreguntasTactiles.astro";
import { BOTON, CAMPO, ETIQUETA, NUMERO_PASO } from "../lib/estilos";

const apiUrl = API;
const preguntas = [
  ["¿Cómo se reparten los equipos?", "Los jugadores se mezclan al azar y se distribuyen entre los equipos elegidos. Primero agregas los nombres, seleccionas cuántos equipos quieres y pulsas Sortear equipos. La herramienta coloca a cada jugador por turnos en los equipos resultantes. Si la cantidad no divide exacto, algunos equipos quedan con una persona más."],
  ["¿Puedo separar en 2, 3 o 4 equipos?", "Sí, puedes elegir entre dos, tres o cuatro equipos. Agrega por lo menos dos jugadores, pulsa el número de equipos que quieres y luego usa Sortear equipos. El resultado aparece separado en tarjetas para cada equipo. La cantidad de integrantes depende del total de jugadores que hayas agregado."],
  ["¿Cómo agrego a muchos de una vez?", "Puedes ingresar varios invitados en una sola acción. Pulsa Agregar invitado sin cuenta, escribe los nombres separados por comas y presiona Agregar. La herramienta limpia cada nombre, evita repetir uno que ya esté en la lista y crea los jugadores. Después puedes revisar los chips antes de hacer el sorteo."],
  ["¿Necesito cuenta?", "No, puedes completar todo el sorteo como invitado. Abre la opción para agregar invitados, escribe uno o varios nombres y elige entre dos, tres o cuatro equipos. Si tienes una cuenta, también puedes buscar personas por su usuario y agregarlas desde las sugerencias. El resultado se genera en la misma página."],
  ["¿Qué pasa si los jugadores no se dividen exacto?", "El sorteo mantiene la diferencia lo más pequeña posible al repartir por turnos. Agregas a todos, eliges la cantidad de equipos y ejecutas el sorteo normalmente. Cuando sobra una o más personas, los primeros equipos reciben una adicional. Por eso algunos equipos pueden quedar con un integrante más que otros."],
  ["¿Puedo quitar a alguien antes del sorteo?", "Sí, cada jugador agregado aparece como un chip con un botón para retirarlo. Revisa la lista, pulsa el botón de quitar junto al nombre que no participará y confirma visualmente que el contador cambió. Luego eliges la cantidad de equipos y sorteas. La distribución usa únicamente los jugadores que permanezcan en la lista."],
  ["¿Puedo volver a sortear?", "Sí, puedes ejecutar el sorteo otra vez con la misma lista. Mantén los jugadores, elige la cantidad de equipos que deseas y vuelve a pulsar Sortear equipos. La herramienta mezcla nuevamente el orden antes de repartirlos. Como el proceso es aleatorio, el nuevo resultado puede cambiar respecto del anterior."],
  ["¿Puedo copiar el resultado?", "Sí, cada equipo generado incluye su propio botón Copiar. Después de sortear, ubica la tarjeta del equipo que quieres compartir y pulsa ese botón. La herramienta intenta copiar el nombre del equipo y su lista de jugadores al portapapeles. El botón indica si se copió o si el navegador no permitió hacerlo."],
];
// Categoría e icono de cada pregunta, en el mismo orden (spec 47).
const temas = [["Reparto", "mezclar"], ["Equipos", "grupo"], ["Invitados", "mas"], ["Cuenta", "usuario"], ["Reparto", "grupo"], ["Lista", "cerrar"], ["Sorteo", "mezclar"], ["Resultado", "copiar"]] as const;
const tarjetas: Pregunta[] = preguntas.map(([pregunta, respuesta], i) => ({ categoria: temas[i][0], icono: temas[i][1], pregunta, respuesta }));
---

<BaseLayout title="Arma equipos parejos | ReservaYa" description="Escribe los nombres de los jugadores y repártelos al azar en 2, 3 o 4 equipos.">
  <section class="mx-auto max-w-texto px-4 pb-12 pt-8 md:px-6 lg:pt-12">
    <SeccionTitulo
      id="sortear-titulo"
      nivel={1}
      alinear="izquierda"
      antetitulo="Sorteo rápido"
      titulo="Arma los equipos"
      bajada="Ingresa los nombres de los jugadores, elige 2, 3 o 4 equipos, y sortea parejos sin discusiones. No necesitas cuenta."
    />

    <div class="card-tactil mt-8 bg-tiza p-5 shadow-dura-cesped sm:p-6">
      <p class="mb-4 flex items-center gap-3 font-display text-xl font-black text-basalto"><span class={NUMERO_PASO}>1</span>Agrega jugadores</p>
      <label for="add-input" class={ETIQUETA}>Agrega jugadores</label>
      <div id="search-wrap" class="relative">
        <Icon nombre="buscar" class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-pizarra" />
        <input id="add-input" placeholder="@usuario o nombre" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="suggest" aria-autocomplete="list" class={`${CAMPO} h-11 pl-10`} />
        <div id="suggest" role="listbox" aria-label="Usuarios encontrados" hidden class="absolute inset-x-0 z-20 mt-2 max-h-64 overflow-y-auto card-tactil bg-tiza p-2 shadow-dura"></div>
      </div>
      <div id="draft-row" hidden class="mt-3">
        <label for="draft-input" class={ETIQUETA}>Invitados sin cuenta</label>
        <div class="flex gap-2">
          <input id="draft-input" placeholder="Juan, Pedro, Luis" autocomplete="off" class={`${CAMPO} h-11 flex-1`} />
          <Button id="draft-add" class="shrink-0">Agregar</Button>
          <button id="draft-close" type="button" aria-label="Descartar invitados" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-pizarra hover:bg-piedra"><Icon nombre="cerrar" /></button>
        </div>
        <p class="mt-1.5 text-sm text-pizarra">Separa varios con comas y se agregan todos.</p>
      </div>
      <Button id="add-guest" variante="secundario" class="mt-3 w-full"><Icon nombre="mas" class="h-4 w-4" />Agregar invitado sin cuenta</Button>
    </div>

    <div class="card-tactil mt-4 bg-tiza p-5 shadow-dura-sm sm:p-6">
      <h2 class="flex items-center gap-3 font-display text-xl font-black text-basalto"><span class={NUMERO_PASO}>2</span>Jugadores <span id="jcount" class="font-display font-extrabold tabular-nums text-pizarra">(0)</span></h2>
      <div id="chips" class="mt-3 flex flex-wrap gap-2"></div>
      <p id="jempty" class="py-6 text-center text-pizarra">Todavía no hay jugadores.</p>
    </div>

    <div class="card-tactil mt-4 flex flex-col gap-4 bg-sillar/40 p-5 shadow-dura sm:flex-row sm:items-end sm:justify-between sm:p-6">
      <fieldset>
        <legend class="mb-3 flex items-center gap-3 font-display text-xl font-black text-basalto"><span class={NUMERO_PASO}>3</span>¿Cuántos equipos?</legend>
        <div id="tnums" class="flex gap-2">
          {[2, 3, 4].map((n) => (
            <button type="button" data-n={n} aria-pressed={n === 2 ? "true" : "false"} class="tnum h-11 w-12 rounded-full border-2 border-basalto bg-tiza font-display text-lg font-extrabold tabular-nums aria-pressed:bg-basalto aria-pressed:text-tiza cursor-pointer">{n}</button>
          ))}
        </div>
      </fieldset>
      <Button id="sortear" disabled class="shadow-dura-sm sm:px-10">Sortear equipos</Button>
    </div>

    <div id="out" class="mt-4 grid gap-4 sm:grid-cols-2" aria-live="polite"></div>

    <div class="revelar mt-16">
      <SeccionTitulo id="preguntas-titulo" antetitulo="Ayuda" titulo="Preguntas frecuentes" />
      <PreguntasTactiles preguntas={tarjetas} />
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ apiUrl, claseTexto: BOTON.texto }}>
(function () {
  var base = String(apiUrl);
  var jugadores = [];
  var nEquipos = 2;
  var encontrados = [];
  var suggestTimer = null;
  var suggestCtrl = null;
  var suggestSeq = 0;
  var activeIdx = -1;

  function $(id) { return document.getElementById(id); }
  var addInput = $("add-input");
  var suggest = $("suggest");
  var draftRow = $("draft-row");
  var draftInput = $("draft-input");
  var chips = $("chips");
  var jcount = $("jcount");
  var jempty = $("jempty");
  var out = $("out");
  var sortBtn = $("sortear");
  var tnums = Array.prototype.slice.call(document.querySelectorAll(".tnum"));
  if (!addInput || !suggest || !draftRow || !draftInput || !chips || !jcount || !jempty || !out || !sortBtn) return;

  function nodo(tag, clase, texto) {
    var n = document.createElement(tag);
    if (clase) n.className = clase;
    if (texto !== undefined) n.textContent = texto;
    return n;
  }

  function hideSuggest() {
    if (suggestCtrl) suggestCtrl.abort();
    suggestCtrl = null;
    suggest.hidden = true;
    suggest.replaceChildren();
    encontrados = [];
    activeIdx = -1;
    addInput.setAttribute("aria-expanded", "false");
    addInput.removeAttribute("aria-activedescendant");
  }

  // Sin resultados o sin conexión: siempre una acción (agregar como invitado), nunca texto muerto.
  function showSuggestAction(hint, raw) {
    var query = String(raw || "").trim().replace(/^@/, "");
    suggest.replaceChildren(nodo("p", "px-4 pt-3 text-sm text-pizarra", hint));
    if (query) {
      var btn = nodo("button", "m-2 flex min-h-11 w-[calc(100%-1rem)] items-center gap-2 rounded-control bg-cesped-suave px-3 text-left font-semibold text-cesped-hondo", 'Agregar "' + query + '" como invitado');
      btn.type = "button";
      btn.setAttribute("role", "option");
      btn.addEventListener("mousedown", function (e) { e.preventDefault(); addMuchos(query); closeDraft(); hideSuggest(); });
      suggest.append(btn);
    }
    suggest.hidden = false;
    addInput.setAttribute("aria-expanded", "true");
  }

  function pickUser(nombre) {
    var limpio = String(nombre || "").trim().replace(/^@/, "");
    if (limpio && jugadores.indexOf(limpio) === -1) jugadores.push(limpio);
    render();
    hideSuggest();
    closeDraft();
  }

  function paintSuggest() {
    if (!encontrados.length) { hideSuggest(); return; }
    suggest.replaceChildren();
    encontrados.forEach(function (u, idx) {
      var b = nodo("button", "flex min-h-11 w-full items-center gap-3 px-4 py-2 text-left hover:bg-sillar" + (idx === activeIdx ? " bg-sillar" : ""));
      b.type = "button";
      b.id = "suggest-opt-" + idx;
      b.setAttribute("role", "option");
      b.setAttribute("aria-selected", idx === activeIdx ? "true" : "false");
      var av = nodo("span", "flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-basalto text-sm font-semibold text-tiza", ((u.nombre || "").charAt(0) || "?").toUpperCase());
      av.setAttribute("aria-hidden", "true");
      b.append(av, nodo("span", "font-semibold", u.nombre));
      b.addEventListener("mousedown", function (e) { e.preventDefault(); pickUser(u.nombre); });
      suggest.appendChild(b);
    });
    suggest.hidden = false;
    addInput.setAttribute("aria-expanded", "true");
  }

  function setActive(idx) {
    if (!encontrados.length) return;
    activeIdx = (idx + encontrados.length) % encontrados.length;
    paintSuggest();
    addInput.setAttribute("aria-activedescendant", "suggest-opt-" + activeIdx);
  }

  async function buscarUsuarios(term) {
    var q = String(term || "").trim().replace(/^@/, "");
    if (q.length < 2) { hideSuggest(); return; }
    var mySeq = ++suggestSeq;
    if (suggestCtrl) suggestCtrl.abort();
    suggestCtrl = new AbortController();
    try {
      var res = await fetch(base + "/api/usuarios/buscar?q=" + encodeURIComponent(q), { signal: suggestCtrl.signal });
      if (mySeq !== suggestSeq) return;
      if (!res.ok) {
        encontrados = [];
        showSuggestAction(res.status === 429 ? "Demasiadas búsquedas; espera un momento." : "No pudimos buscar usuarios.", q);
        return;
      }
      var body = await res.json().catch(function () { return null; });
      var lista = body && Array.isArray(body.usuarios) ? body.usuarios : [];
      encontrados = lista.filter(function (u) { return u && typeof u.nombre === "string" && jugadores.indexOf(u.nombre) === -1; });
      activeIdx = -1;
      if (!encontrados.length) { showSuggestAction("Sin resultados.", q); return; }
      paintSuggest();
    } catch (err) {
      if (err && err.name === "AbortError") return;
      if (mySeq !== suggestSeq) return;
      encontrados = [];
      showSuggestAction("Sin conexión con el servidor.", String(term || "").trim());
    }
  }

  document.addEventListener("mousedown", function (e) {
    var wrap = $("search-wrap");
    if (wrap && e.target instanceof Node && !wrap.contains(e.target)) hideSuggest();
  }, true);

  function render() {
    chips.replaceChildren();
    jugadores.forEach(function (j, i) {
      var s = nodo("span", "inline-flex min-h-9 items-center gap-2 rounded-full bg-sillar py-1 pl-3 pr-1 font-medium", j);
      var rm = nodo("button", "flex h-8 w-8 items-center justify-center rounded-full text-pizarra hover:bg-piedra hover:text-basalto");
      var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      svg.setAttribute("viewBox", "0 0 24 24");
      svg.setAttribute("class", "h-4 w-4");
      svg.setAttribute("fill", "none");
      svg.setAttribute("stroke", "currentColor");
      svg.setAttribute("stroke-width", "2");
      svg.setAttribute("aria-hidden", "true");
      var trazo = document.createElementNS("http://www.w3.org/2000/svg", "path");
      trazo.setAttribute("d", "M18 6 6 18M6 6l12 12");
      svg.append(trazo);
      rm.append(svg);
      rm.type = "button";
      rm.setAttribute("aria-label", "Quitar a " + j);
      rm.addEventListener("click", function () { jugadores.splice(i, 1); render(); });
      s.append(rm);
      chips.appendChild(s);
    });
    jcount.textContent = "(" + jugadores.length + ")";
    jempty.hidden = jugadores.length > 0;
    sortBtn.disabled = jugadores.length < 2;
  }

  function addMuchos(raw) {
    String(raw || "").split(",").map(function (s) { return s.trim().replace(/^@/, ""); }).filter(Boolean).forEach(function (n) {
      if (jugadores.indexOf(n) === -1) jugadores.push(n);
    });
    encontrados = encontrados.filter(function (u) { return jugadores.indexOf(u.nombre) === -1; });
    paintSuggest();
    render();
  }

  function openDraft(seed, focus) {
    draftRow.hidden = false;
    if (document.activeElement !== draftInput) draftInput.value = seed;
    if (focus !== false) draftInput.focus();
  }
  function closeDraft() {
    draftRow.hidden = true;
    draftInput.value = "";
    addInput.value = "";
    addInput.focus();
  }

  addInput.addEventListener("input", function () {
    if (addInput.value.trim()) openDraft(addInput.value, false);
    else draftRow.hidden = true;
    if (suggestTimer) clearTimeout(suggestTimer);
    suggestTimer = setTimeout(function () { buscarUsuarios(addInput.value); }, 250);
  });
  addInput.addEventListener("keydown", function (e) {
    if (e.key === "Escape") { hideSuggest(); return; }
    if (e.key === "ArrowDown" && encontrados.length) { e.preventDefault(); setActive(activeIdx + 1); return; }
    if (e.key === "ArrowUp" && encontrados.length) { e.preventDefault(); setActive(activeIdx - 1); return; }
    if (e.key === "Enter" && addInput.value.trim()) {
      if (activeIdx >= 0 && encontrados[activeIdx]) pickUser(encontrados[activeIdx].nombre);
      else if (encontrados.length && addInput.value.indexOf(",") === -1) pickUser(encontrados[0].nombre);
      else { addMuchos(addInput.value); closeDraft(); hideSuggest(); }
    }
  });
  addInput.addEventListener("blur", function () { setTimeout(hideSuggest, 150); });
  draftInput.addEventListener("keydown", function (e) {
    if (e.key === "Enter" && draftInput.value.trim()) { addMuchos(draftInput.value); closeDraft(); }
  });
  $("draft-add")?.addEventListener("click", function () {
    if (draftInput.value.trim()) { addMuchos(draftInput.value); closeDraft(); }
  });
  $("draft-close")?.addEventListener("click", closeDraft);
  $("add-guest")?.addEventListener("click", function () { openDraft(""); });

  tnums.forEach(function (b) {
    b.addEventListener("click", function () {
      nEquipos = parseInt(b.getAttribute("data-n") || "2", 10) || 2;
      tnums.forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
    });
  });

  sortBtn.addEventListener("click", function () {
    var sh = jugadores.slice();
    for (var k = sh.length - 1; k > 0; k--) {
      var r = Math.floor(Math.random() * (k + 1));
      var t = sh[k]; sh[k] = sh[r]; sh[r] = t;
    }
    out.replaceChildren();
    for (var i = 0; i < nEquipos; i++) {
      (function (i) {
        var ms = sh.filter(function (_, j) { return j % nEquipos === i; });
        var d = nodo("div", "fila-entra card-tactil p-5 shadow-dura");
        d.style.animationDelay = i * 60 + "ms";
        var head = nodo("div", "flex items-center justify-between");
        var copyBtn = nodo("button", claseTexto + " text-sm", "Copiar");
        copyBtn.type = "button";
        copyBtn.addEventListener("click", function () {
          var txt = "Equipo " + (i + 1) + ": " + ms.join(", ");
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(txt).then(function () {
              copyBtn.textContent = "Copiado";
              setTimeout(function () { copyBtn.textContent = "Copiar"; }, 2000);
            }, function () { copyBtn.textContent = "No se pudo copiar"; });
          } else {
            copyBtn.textContent = "No se pudo copiar";
          }
        });
        head.append(nodo("h3", "text-xl", "Equipo " + (i + 1)), copyBtn);
        var ul = nodo("ul", "mt-2 border-t border-cal");
        ms.forEach(function (m) { ul.append(nodo("li", "border-b border-cal py-2 font-medium last:border-b-0", m)); });
        d.append(head, ul);
        out.appendChild(d);
      })(i);
    }
    out.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });

  render();
})();
</script>
