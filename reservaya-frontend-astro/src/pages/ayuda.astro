---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import SeccionTitulo from "../components/inicio/SeccionTitulo.astro";
import PreguntasTactiles from "../components/inicio/PreguntasTactiles.astro";
import { EMAIL } from "../lib/contacto";
import { NUMERO_PASO } from "../lib/estilos";
import { PREGUNTAS_JUGADOR } from "../lib/preguntas";

const pasos = [
  ["Crea tu cuenta", "Con tu nombre, correo, fecha de nacimiento y una contraseña."],
  ["Busca una cancha libre", "En Canchas eliges distrito, deporte, día y hora. Solo ves las que están libres, con su precio."],
  ["Envía la reserva", "Pulsas Reservar y la confirmas desde tu cuenta. Puedes dejar una nota para el complejo."],
  ["Espera la confirmación", "El complejo tiene que confirmarla. Cuando lo hace, ves tu código en Mi partido."],
  ["Juega con tu código", "Con la reserva confirmada ves tu código en Mi partido. Lo muestras al llegar a la cancha."],
];
---

<BaseLayout title="Cómo reservar | ReservaYa" description="Guía para reservar una cancha en ReservaYa, paso a paso.">
  <section class="mx-auto max-w-texto px-4 pb-16 pt-8 md:px-6 lg:pt-12">
    <SeccionTitulo
      id="ayuda-titulo"
      nivel={1}
      alinear="izquierda"
      antetitulo="Guía rápida"
      titulo="Cómo reservar una cancha"
      bajada="De la búsqueda al código confirmado: 5 pasos claros para que juegues sin estrés. Crea cuenta, busca, reserva, espera confirmación, recibe tu código."
    />
    <ol class="mt-8 grid gap-4">
      {pasos.map(([t, d], i) => (
        <li class="card-tactil grid grid-cols-[3rem_minmax(0,1fr)] gap-3 bg-tiza p-5 shadow-dura-sm">
          <span class={NUMERO_PASO}>{i + 1}</span>
          <div>
            <h2 class="font-display text-xl font-black text-basalto">{t}</h2>
            <p class="mt-1 leading-relaxed text-pizarra">{d}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="revelar mt-16">
      <SeccionTitulo id="preguntas-titulo" antetitulo="Ayuda" titulo="Preguntas frecuentes" />
      <PreguntasTactiles preguntas={PREGUNTAS_JUGADOR} />
    </div>
    <div class="card-tactil mt-12 flex flex-col gap-4 bg-sillar/40 p-6 shadow-dura sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-bold text-basalto">¿Dudas o problemas?</p>
        <p class="mt-0.5 text-sm text-pizarra">Escríbenos a <a href={`mailto:${EMAIL}`} class="font-bold text-cesped-hondo underline">{EMAIL}</a>.</p>
      </div>
      <Button href="/canchas" class="shrink-0 shadow-dura-sm">Buscar canchas</Button>
    </div>
  </section>
</BaseLayout>
