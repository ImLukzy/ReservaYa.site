---
import BaseLayout from "../layouts/BaseLayout.astro";
import Select from "../components/ui/Select.astro";
import Field from "../components/ui/Field.astro";
import Icon from "../components/ui/Icon.astro";
import { DISTRITOS, TIPOS } from "../lib/arequipa";
import { APERTURA, ULTIMA, etiquetaHora } from "../lib/horario";
import { APP } from "../lib/entorno";
import { BOTON } from "../lib/estilos";

const distritos = [{ valor: "", etiqueta: "Todo Arequipa" }, ...DISTRITOS.map((d) => ({ valor: d, etiqueta: d }))];
const tipos = [{ valor: "", etiqueta: "Todo deporte" }, ...TIPOS];
const dias = [{ valor: "hoy", etiqueta: "Hoy" }, { valor: "manana", etiqueta: "Mañana" }];
const horas = Array.from({ length: ULTIMA - APERTURA + 1 }, (_, i) => ({ valor: String(APERTURA + i), etiqueta: etiquetaHora(APERTURA + i) }));
const orden = [
  { valor: "precio", etiqueta: "Menor precio" },
  { valor: "precio-desc", etiqueta: "Mayor precio" },
  { valor: "valoracion", etiqueta: "Mejor valoradas" },
];
---

<BaseLayout
  title="Buscar canchas libres | ReservaYa"
  description="Canchas libres en Arequipa por distrito, deporte, día y hora, con su precio real."
>
  <section class="mx-auto max-w-page px-4 pt-8 md:px-6 lg:pt-12">
    <h1 class="text-3xl lg:text-4xl">Buscar canchas</h1>
    <p id="resumen" class="mt-2 min-h-7 text-lg text-pizarra">Canchas libres en Arequipa</p>

    <form id="filtros" action="/canchas" method="get" role="search" class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-[minmax(0,1.3fr)_repeat(4,minmax(0,1fr))]">
      <Field id="f-q" name="q" type="search" etiqueta="Complejo o cancha" placeholder="Nombre" autocomplete="off" class="col-span-2 lg:col-span-1" />
      <Select id="f-distrito" name="distrito" etiqueta="Distrito" opciones={distritos} />
      <Select id="f-tipo" name="tipo" etiqueta="Deporte" opciones={tipos} />
      <Select id="f-fecha" name="fecha" etiqueta="Día" opciones={dias} />
      <Select id="f-hora" name="hora" etiqueta="Hora" opciones={horas} />
      <noscript><button type="submit" class={BOTON.primario}>Buscar</button></noscript>
    </form>
  </section>

  <section class="mx-auto max-w-page px-4 pb-16 pt-6 md:px-6" aria-labelledby="resumen">
    <div class="mb-3 flex justify-end">
      <Select id="f-orden" etiqueta="Ordenar por" opciones={orden} class="flex items-center gap-2 [&_label]:mb-0" />
    </div>
    <div class="overflow-hidden rounded-surface border border-cal bg-tiza">
      <div class="hidden h-11 grid-cols-[4rem_minmax(0,1.2fr)_minmax(0,1fr)_4.5rem_6.5rem] items-center gap-x-4 border-b border-cal px-6 font-display font-semibold text-pizarra sm:grid" aria-hidden="true">
        <span>Hora</span><span>Complejo y cancha</span><span>Deporte y distrito</span><span class="text-right">Precio</span><span></span>
      </div>
      <ul id="resultados" aria-live="polite" aria-busy="true">
        {[0, 1, 2, 3].map(() => (
          <li class="grid h-24 grid-cols-[3.5rem_minmax(0,1fr)_5rem] items-center gap-x-3 border-b border-cal px-4 sm:h-16 sm:px-6" aria-hidden="true">
            <span class="esqueleto h-6 w-12"></span><span class="esqueleto h-5 w-3/4"></span><span class="esqueleto h-9 w-20 justify-self-end"></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog id="opiniones" aria-labelledby="opiniones-titulo" class="m-auto w-[min(32rem,calc(100%-2rem))] rounded-surface bg-tiza p-0 text-basalto shadow-pop">
    <div class="flex items-start justify-between gap-4 border-b border-cal px-5 py-4">
      <h2 id="opiniones-titulo" class="text-xl">Opiniones</h2>
      <button type="button" data-cerrar class="flex h-11 w-11 shrink-0 items-center justify-center rounded-control hover:bg-piedra" aria-label="Cerrar opiniones">
        <Icon nombre="cerrar" />
      </button>
    </div>
    <ul id="opiniones-lista" class="max-h-[60vh] overflow-y-auto px-5"></ul>
    <div class="border-t border-cal px-5 py-4 text-sm text-pizarra">
      ¿Jugaste aquí? Califica desde tu reserva completada.
      <a href={`${APP}/dashboard/reservas`} class={`${BOTON.texto} text-sm`}>Ir a mis reservas</a>
    </div>
  </dialog>
</BaseLayout>

<script>
  import "../scripts/canchas.ts";
</script>
