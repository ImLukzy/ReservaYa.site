---
import BaseLayout from "../layouts/BaseLayout.astro";
import Select from "../components/ui/Select.astro";
import Field from "../components/ui/Field.astro";
import Icon from "../components/ui/Icon.astro";
import { DISTRITOS, TIPOS } from "../lib/arequipa";
import { APERTURA, ULTIMA, etiquetaHora } from "../lib/horario";
import { APP } from "../lib/entorno";
import { BOTON } from "../lib/estilos";

const distritos = [{ valor: "", etiqueta: "Todo Arequipa" }, ...DISTRITOS.map((d) => ({ valor: d, etiqueta: d }))];
const tipos = [{ valor: "", etiqueta: "Todo deporte" }, ...TIPOS];
const dias = [{ valor: "hoy", etiqueta: "Hoy" }, { valor: "manana", etiqueta: "Mañana" }];
const horas = Array.from({ length: ULTIMA - APERTURA + 1 }, (_, i) => ({ valor: String(APERTURA + i), etiqueta: etiquetaHora(APERTURA + i) }));
const orden = [
  { valor: "precio", etiqueta: "Menor precio" },
  { valor: "precio-desc", etiqueta: "Mayor precio" },
  { valor: "valoracion", etiqueta: "Mejor valoradas" },
];
---

<BaseLayout
  title="Buscar canchas libres | ReservaYa"
  description="Canchas libres en Arequipa por distrito, deporte, día y hora, con su precio real."
>
  <section class="mx-auto max-w-page px-4 pt-8 md:px-6 lg:pt-12">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-cesped/40 bg-cesped-suave px-3 py-0.5 font-display text-xs font-bold text-cesped-hondo">
            <span class="h-2 w-2 rounded-full bg-cesped motion-safe:animate-pulse" aria-hidden="true"></span>
            TABLERO EN VIVO
          </span>
          <span class="font-display text-xs font-bold uppercase tracking-wider text-pizarra">Arequipa</span>
        </div>
        <h1 class="mt-2 font-display text-3xl font-black tracking-tight text-basalto sm:text-4xl lg:text-5xl">
          Buscar canchas
        </h1>
        <p id="resumen" class="mt-2 min-h-7 text-base text-pizarra sm:text-lg">
          Canchas libres en Arequipa
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-1.5 text-xs font-bold text-pizarra sm:gap-2 lg:flex-nowrap">
        <span class="rounded-lg border border-cal bg-piedra px-2.5 py-1">{DISTRITOS.length} distritos</span>
        <span class="rounded-lg border border-cal bg-piedra px-2.5 py-1">{TIPOS.length} tipos de cancha</span>
        <span class="rounded-lg border border-cal bg-piedra px-2.5 py-1">Reserva al instante</span>
      </div>
    </div>

    <div class="card-tactil mt-6 bg-tiza p-4 shadow-dura-sm sm:p-5">
      <form id="filtros" action="/canchas" method="get" role="search" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.3fr)_repeat(4,minmax(0,1fr))]">
        <Field id="f-q" name="q" type="search" etiqueta="Complejo o cancha" placeholder="Nombre" autocomplete="off" class="sm:col-span-2 lg:col-span-1" />
        <Select id="f-distrito" name="distrito" etiqueta="Distrito" opciones={distritos} />
        <Select id="f-tipo" name="tipo" etiqueta="Deporte" opciones={tipos} />
        <Select id="f-fecha" name="fecha" etiqueta="Día" opciones={dias} />
        <Select id="f-hora" name="hora" etiqueta="Hora" opciones={horas} />
        <noscript><button type="submit" class={BOTON.primario}>Buscar</button></noscript>
      </form>
    </div>
  </section>

  <section class="mx-auto max-w-page px-4 pb-16 pt-6 md:px-6" aria-labelledby="resumen">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <p class="font-display text-xs font-bold uppercase tracking-wider text-pizarra">
        Resultados y horarios libres
      </p>
      <div class="flex items-center justify-end">
        <Select id="f-orden" etiqueta="Ordenar por" opciones={orden} class="flex items-center gap-2 [&_label]:mb-0 [&_label]:text-xs [&_label]:font-bold [&_label]:text-pizarra" />
      </div>
    </div>
    <div class="card-tactil overflow-hidden p-0 shadow-dura">
      <div class="hidden h-12 grid-cols-[4rem_4rem_minmax(0,1.2fr)_minmax(0,1fr)_4.5rem_6.5rem] items-center gap-x-4 border-b-2 border-basalto bg-piedra px-6 font-display text-xs font-bold uppercase tracking-wider text-basalto sm:grid" aria-hidden="true">
        <span></span><span>Hora</span><span>Complejo y cancha</span><span>Deporte y distrito</span><span class="text-right">Precio</span><span></span>
      </div>
      <ul id="resultados" aria-live="polite" aria-busy="true" class="[counter-reset:cancha]">
        {[0, 1, 2, 3].map(() => (
          <li class="grid h-24 grid-cols-[3.5rem_minmax(0,1fr)_5rem] items-center gap-x-3 border-b border-cal px-4 sm:h-16 sm:grid-cols-[4rem_3.5rem_minmax(0,1fr)_5rem] sm:gap-x-4 sm:px-6" aria-hidden="true">
            <span class="esqueleto hidden h-9 w-16 rounded-full sm:block"></span><span class="esqueleto h-6 w-12"></span><span class="esqueleto h-5 w-3/4"></span><span class="esqueleto h-9 w-20 justify-self-end"></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog id="opiniones" aria-labelledby="opiniones-titulo" class="card-tactil m-auto w-[min(32rem,calc(100%-2rem))] p-0 text-basalto backdrop:bg-velo motion-safe:transition-all overscroll-contain">
    <div class="flex items-start justify-between gap-4 border-b-2 border-basalto/15 px-5 py-4">
      <h2 id="opiniones-titulo" class="text-xl font-bold">Opiniones</h2>
      <button type="button" data-cerrar class="btn-tactil flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-cal bg-tiza text-pizarra hover:bg-piedra hover:text-basalto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-basalto focus-visible:ring-offset-2" aria-label="Cerrar opiniones">
        <Icon nombre="cerrar" />
      </button>
    </div>
    <ul id="opiniones-lista" class="max-h-[60vh] overflow-y-auto px-5 overscroll-contain"></ul>
    <div class="border-t-2 border-basalto/15 px-5 py-4 text-sm text-pizarra">
      ¿Jugaste aquí? Califica desde tu reserva completada.
      <a href={`${APP}/dashboard/reservas`} class={`${BOTON.texto} text-sm`}>Ir a mis reservas</a>
    </div>
  </dialog>
</BaseLayout>

<script>
  import "../scripts/canchas.ts";
</script>
