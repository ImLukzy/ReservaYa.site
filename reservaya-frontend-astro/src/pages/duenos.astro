      const el = e.target;
      const target = parseInt(el.dataset.count || "0", 10);
      const useK = el.hasAttribute("data-format");
      const t0 = performance.now();
      const tick = (t) => {
        const p = Math.min(1, (t - t0) / 1400);
        const v = Math.round(target * (1 - Math.pow(1 - p, 3)));
        el.textContent = useK ? (v >= 1000 ? "2,500" : v.toLocaleString("es-PE")) : v.toLocaleString("es-PE");
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      cio.unobserve(el);
    });
  }, { threshold: 0.4 });
  counters.forEach((c) => cio.observe(c));

  // ---------- Chart draw ----------
  const line = document.getElementById("dash-line");
  if (line) {
    const len = line.getTotalLength();
    line.style.strokeDasharray = String(len);
    line.style.strokeDashoffset = String(len);
    new IntersectionObserver((es, o) => {
      es.forEach((e) => { if (e.isIntersecting) { line.style.transition = "stroke-dashoffset 2s ease"; line.style.strokeDashoffset = "0"; o.disconnect(); } });
    }, { threshold: 0.3 }).observe(line);
  }

  // ---------- Reservas por confirmar ----------
  document.querySelectorAll(".pending-row").forEach((row) => {
    row.querySelector("[data-ok]")?.addEventListener("click", () => {
      row.outerHTML = `<div class="rounded-lg bg-[#22C55E]/10 px-3 py-2 text-[12px] font-bold text-[#16A34A]">✓ Reserva confirmada, código enviado al jugador</div>`;
    });
    row.querySelector("[data-no]")?.addEventListener("click", () => row.remove());
  });

  // ---------- Paso 01: progreso de registro (loop) ----------
  const steps = Array.from(document.querySelectorAll(".reg-step"));
  const pct = document.getElementById("reg-pct");
  let ri = 0;
  setInterval(() => {
    if (document.hidden) return;
    ri = (ri + 1) % (steps.length + 2);
    steps.forEach((s, i) => {
      const done = i < ri;
      const dot = s.querySelector(".reg-dot");
      const bar = s.querySelector(".reg-bar");
      if (dot) { dot.textContent = done ? "✓" : ""; dot.style.background = done ? "#22C55E" : "transparent"; dot.style.borderColor = done ? "#22C55E" : "rgba(255,255,255,0.25)"; dot.style.color = "#fff"; }
      if (bar) bar.style.width = done ? "100%" : (i === ri ? "45%" : "0%");
    });
    if (ri === 0 && pct) pct.textContent = "12";
    else if (pct) pct.textContent = String(Math.min(100, 12 + Math.round((ri / steps.length) * 88)));
  }, 1200);

  // ---------- Paso 02: slots en vivo ----------
  const toast = document.getElementById("slot-toast");
  document.querySelectorAll("#live-slots .slot").forEach((b) => b.addEventListener("click", () => {
    document.querySelectorAll("#live-slots .slot").forEach((x) => { x.className = "slot rounded-xl px-3 py-3 text-sm font-bold transition bg-white/[0.07] text-white/80 hover:bg-white/[0.14]"; });
    b.className = "slot rounded-xl px-3 py-3 text-sm font-bold transition bg-[#22C55E] text-white";
    if (toast) {
      toast.innerHTML = "";
      const span1 = document.createElement("span");
      span1.className = "font-bold text-[#4ADE80]";
      span1.textContent = `Nueva reserva · ${b.dataset.slot}`;
      const span2 = document.createElement("span");
      span2.className = "float-right text-white/50";
      span2.textContent = "S/ 80";
      toast.append(span1, span2);
    }
  }));

  // ---------- Paso 03: ingresos en vivo ----------
  const incomeList = document.getElementById("income-list");
  const incomeTotal = document.getElementById("owner-income");
  let income = 1150;
  const names = ["Ariana P.", "Equipo Tigres", "Luis R.", "Nicolas T.", "Vale Q."];
  setInterval(() => {
    if (document.hidden || !incomeList) return;
    const n = names[Math.floor(Math.random() * names.length)];
    const amt = [70, 80, 80, 100][Math.floor(Math.random() * 4)];
    income += amt;
    if (incomeTotal) incomeTotal.textContent = income.toLocaleString("es-PE");
    const div = document.createElement("div");
    div.className = "flex items-center justify-between rounded-xl bg-[#22C55E]/10 px-4 py-2.5";
    const span1 = document.createElement("span");
    span1.className = "text-white/70";
    span1.textContent = `Reserva · ${n}`;
    const span2 = document.createElement("span");
    span2.className = "font-bold text-[#4ADE80]";
    span2.textContent = `+S/ ${amt}`;
    div.append(span1, span2);
    incomeList.prepend(div);
    while (incomeList.children.length > 4) incomeList.lastElementChild?.remove();
  }, 6000);

  // ---------- Caja y stock ----------
  let ticket = 0;
  const ticketEl = document.getElementById("ticket-total");
  document.querySelectorAll(".prod").forEach((b) => b.addEventListener("click", () => {
    let stock = parseInt(b.dataset.stock || "0", 10);
    if (stock <= 0) return;
    stock--;
    b.dataset.stock = String(stock);
    const s = b.querySelector(".stock");
    if (s) { s.textContent = `${stock} u.`; if (stock <= 5) s.style.color = "#EAB308"; }
    ticket += parseInt(b.dataset.price || "0", 10);
    if (ticketEl) ticketEl.textContent = String(ticket);
    document.getElementById("cobro-msg")?.classList.add("hidden");
  }));
  document.getElementById("cobrar")?.addEventListener("click", () => {
    if (ticket <= 0) return;
    ticket = 0;
    if (ticketEl) ticketEl.textContent = "0";
    document.getElementById("cobro-msg")?.classList.remove("hidden");
  });

  // ---------- Roles ----------
  const perms = {
    "Dueño": ["Todo el negocio", "Ingresos y reportes", "Crea administradores"],
    "Admin": ["Su sede y sus canchas", "Reservas, caja y reportes de su sede", "No ve las otras sedes"],
    "Vendedor": ["Opera reservas y caja", "Valida códigos de acceso", "NO ve tus ingresos"],
  };
  const permList = document.getElementById("role-perms");
  const paintPerms = (role) => {
    if (!permList) return;
    permList.innerHTML = "";
    (perms[role] || []).forEach((p) => {
      const li = document.createElement("li");
      li.className = "flex items-center gap-2.5";
      const span = document.createElement("span");
      span.className = "text-[#4ADE80]";
      span.textContent = "◉";
      li.append(span, p);
      permList.appendChild(li);
    });
  };
  document.querySelectorAll(".role").forEach((b) => b.addEventListener("click", () => {
    document.querySelectorAll(".role").forEach((x) => {
      const on = x === b;
      x.className = `role flex w-full items-center gap-3 rounded-xl border px-4 py-3 text-sm transition ${on ? "border-[#22C55E]/50 bg-[#22C55E]/10" : "border-transparent bg-white/[0.04] hover:bg-white/[0.08]"}`;
      const av = x.querySelector("span");
      if (av) av.className = `flex h-8 w-8 items-center justify-center rounded-full text-xs font-black ${on ? "bg-[#22C55E] text-white" : "bg-white/10 text-white/60"}`;
    });
    paintPerms(b.dataset.role || "Dueño");
  }));
  paintPerms("Dueño");

  // ---------- Planes toggle ----------
  const bm = document.getElementById("btn-men");
  const ba = document.getElementById("btn-anu");
  const precios = Array.from(document.querySelectorAll(".precio"));
  const modo = (anual) => {
    precios.forEach((p) => { p.textContent = anual ? p.dataset.anu || "" : p.dataset.men || ""; });
    if (bm) bm.className = `rounded-full px-4 py-2 ${!anual ? "bg-[#060A08] text-white" : "text-[#5B6660]"}`;
    if (ba) ba.className = `rounded-full px-4 py-2 ${anual ? "bg-[#060A08] text-white" : "text-[#5B6660]"}`;
  };
  bm?.addEventListener("click", () => modo(false));
  ba?.addEventListener("click", () => modo(true));

  // ---------- Inscripción torneo ----------
  const insc = document.getElementById("insc");
  const paintInsc = () => {
    const v = parseInt(insc?.value || "280", 10) || 0;
    document.getElementById("insc-val").textContent = v.toLocaleString("es-PE");
    document.getElementById("insc-total").textContent = (v * 8).toLocaleString("es-PE");
  };
  insc?.addEventListener("input", paintInsc);

  // ---------- Bracket interactivo ----------
  const sfSlots = Array.from(document.querySelectorAll('[data-round="sf"] .slot-b'));
  const fSlots = Array.from(document.querySelectorAll('[data-round="f"] .slot-b'));
  const champ = document.getElementById("champion");
  const seed = [["Los Pumas","Los Cracks"],["Atlético 10","Los Tigres"]];
  // seed inicial como la referencia
  sfSlots[0].textContent = seed[0][0]; sfSlots[0].dataset.slot = seed[0][0];
  sfSlots[1].textContent = seed[0][1]; sfSlots[1].dataset.slot = seed[0][1];
  sfSlots[2].textContent = seed[1][0]; sfSlots[2].dataset.slot = seed[1][0];
  sfSlots[3].textContent = seed[1][1]; sfSlots[3].dataset.slot = seed[1][1];
  fSlots[0].textContent = "Los Pumas"; fSlots[0].dataset.slot = "Los Pumas";
  fSlots[1].textContent = "Atlético 10"; fSlots[1].dataset.slot = "Atlético 10";
  if (champ) champ.textContent = "Los Pumas";
  const clearDown = (round) => {
    if (round === "qf") { sfSlots.forEach((s) => { s.textContent = "—"; s.dataset.slot = ""; }); }
    if (round === "qf" || round === "sf") { fSlots.forEach((s) => { s.textContent = "—"; s.dataset.slot = ""; }); if (champ) champ.textContent = "—"; }
  };
  document.querySelectorAll('[data-round="qf"] [data-match]').forEach((m) => {
    m.querySelectorAll(".team").forEach((t) => t.addEventListener("click", () => {
      const mi = parseInt(m.dataset.match || "0", 10);
      // cada llave QF alimenta un slot de semis (mi 0,1 -> SF0 ; mi 2,3 -> SF1)
      const sf = mi < 2 ? 0 : 1;
      const slot = sfSlots[sf * 2 + (mi % 2)];
      slot.textContent = t.dataset.team || "";
      slot.dataset.slot = t.dataset.team || "";
      m.querySelectorAll(".team").forEach((x) => { x.style.borderColor = x === t ? "#4ADE80" : ""; x.style.background = x === t ? "rgba(34,197,94,0.15)" : ""; });
      clearDown("sf");
    }));
  });
  sfSlots.forEach((s, i) => s.addEventListener("click", () => {
    if (!s.dataset.slot) return;
    const f = fSlots[Math.floor(i / 2)];
    f.textContent = s.dataset.slot;
    f.dataset.slot = s.dataset.slot;
    if (champ) champ.textContent = "Por definir";
  }));
  fSlots.forEach((f) => f.addEventListener("click", () => {
    if (!f.dataset.slot) return;
    if (champ) champ.textContent = f.dataset.slot;
  }));

  // ---------- Testimonios carrusel ----------
  const qt = document.getElementById("quote-track");
  const qdots = Array.from(document.querySelectorAll("[data-q]"));
  let qi = 0, qtimer;
  const showQ = (i) => {
    qi = (i + qdots.length) % qdots.length;
    if (qt) qt.style.transform = `translateX(-${qi * 100}%)`;
    qdots.forEach((d, k) => { d.className = `h-1.5 rounded-full transition-all ${k === qi ? "w-6 bg-[#4ADE80]" : "w-1.5 bg-white/25"}`; });
  };
  const autoQ = () => { clearInterval(qtimer); qtimer = setInterval(() => { if (!document.hidden) showQ(qi + 1); }, 6000); };
  qdots.forEach((d) => d.addEventListener("click", () => { showQ(parseInt(d.dataset.q || "0", 10)); autoQ(); }));
  document.getElementById("q-prev")?.addEventListener("click", () => { showQ(qi - 1); autoQ(); });
  document.getElementById("q-next")?.addEventListener("click", () => { showQ(qi + 1); autoQ(); });
  autoQ();

  // ---------- FAQ ----------
  document.querySelectorAll(".faq-item").forEach((item) => {
    const btn = item.querySelector(".faq-q");
    const ans = item.querySelector(".faq-a");
    const icon = item.querySelector(".faq-icon");
    btn?.addEventListener("click", () => {
      const open = ans?.classList.toggle("grid-rows-[0fr]");
      const isOpen = !ans?.classList.contains("grid-rows-[0fr]");
      ans?.classList.toggle("grid-rows-[1fr]", isOpen);
      btn.setAttribute("aria-expanded", String(isOpen));
      if (icon) icon.textContent = isOpen ? "−" : "+";
    });
  });
</script>
