---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Planes from "../components/Planes.astro";
import Icon from "../components/ui/Icon.astro";
import { whatsappUrl } from "../lib/contacto";

const pasos = [
  "Crea tu cuenta en ReservaYa.",
  "Escríbenos y activamos tu cuenta de dueño.",
  "Registra tu complejo: canchas, fotos, horarios y precios.",
  "Elige tu plan. Cuando lo aprobamos, tus canchas aparecen en la búsqueda.",
];

const modulos = [
  { id: "reservas", titulo: "Reservas y agenda", texto: "Confirmas o rechazas cada reserva y ves el día de cada cancha. La reserva confirmada trae un código que validas cuando llega el jugador." },
  { id: "precios", titulo: "Horarios y precios", texto: "Defines el horario de cada día, precios especiales por franja y descuentos." },
  { id: "caja", titulo: "Caja", texto: "Abres y cierras caja, vendes productos y registras cada cobro: efectivo, Yape, tarjeta o transferencia." },
  { id: "equipo", titulo: "Trabajadores", texto: "Cada trabajador entra con su cuenta a la agenda, las reservas y la caja. No ve tus reportes ni tus ingresos." },
  { id: "reportes", titulo: "Reportes y metas", texto: "Ingresos, reservas y metas del mes de cada complejo." },
  { id: "resenas", titulo: "Opiniones", texto: "Solo opinan jugadores con una reserva completada, y tú puedes responder." },
  { id: "torneos", titulo: "Torneos", texto: "Inscribes equipos, armas los partidos y registras los resultados." },
];

const preguntas = [
  ["¿Tengo que instalar algo?", "No. El panel funciona en el navegador del celular o de la computadora."],
  ["¿ReservaYa cobra las reservas por mí?", "Todavía no. Tú cobras como siempre y registras el pago en la caja del panel, con su método."],
  ["¿Sirve si tengo varias sedes?", "Sí. Cada sede es un complejo con sus canchas, horarios, precios y trabajadores."],
  ["¿Qué pasa con una reserva pendiente?", "No bloquea el horario hasta que la confirmas. Así no pierdes la hora por una reserva que nadie confirmó."],
  ["¿Hay contrato de permanencia?", "No. Pagas por mes o por año y puedes dejarlo cuando quieras."],
];
---

<BaseLayout
  title="Publica tus canchas | ReservaYa para dueños"
  description="Recibe reservas de tus canchas en Arequipa sin contestar llamadas. Agenda, precios, caja y trabajadores en un solo panel."
>
  <section class="mx-auto grid max-w-page gap-10 px-4 pb-12 pt-8 md:px-6 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-16 lg:pb-16 lg:pt-12">
    <div>
      <h1 class="text-3xl lg:text-4xl">Publica tus canchas y recibe reservas sin llamadas</h1>
      <p class="mt-4 max-w-xl text-lg text-pizarra">Los jugadores de Arequipa ven tus horas libres con su precio y te envían la reserva. Tú la confirmas desde el panel.</p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <Button href="/register?plan=dueno">Crear mi cuenta</Button>
        <Button href={whatsappUrl("Hola, quiero publicar mis canchas en ReservaYa")} variante="secundario" target="_blank" rel="noopener">Escribir por WhatsApp</Button>
      </div>
    </div>
    <div class="card-tactil p-6 sm:p-8">
      <h2 class="text-xl font-bold">Cómo empiezas</h2>
      <ol class="mt-4 space-y-4">
        {pasos.map((p, i) => (
          <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-2">
            <span class="font-display text-xl font-extrabold tabular-nums tracking-tight text-cesped-hondo">{i + 1}</span>
            <span class="font-medium text-basalto">{p}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="panel-titulo" class="border-y-2 border-basalto bg-tiza">
    <div class="mx-auto max-w-page px-4 py-12 md:px-6 lg:py-16">
      <h2 id="panel-titulo" class="text-2xl font-bold lg:text-3xl">Qué haces desde el panel</h2>
      <dl class="mt-6 border-t border-cal">
        {modulos.map((m) => (
          <div id={m.id} class="grid gap-1 border-b border-cal py-4 md:grid-cols-[14rem_minmax(0,1fr)] md:gap-6">
            <dt class="font-display text-xl font-bold text-basalto">{m.titulo}</dt>
            <dd class="max-w-2xl text-pizarra">{m.texto}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Planes />

  <section aria-labelledby="preguntas-titulo" class="border-t-2 border-basalto bg-tiza">
    <div class="mx-auto max-w-texto px-4 py-12 md:px-6 lg:py-16">
      <h2 id="preguntas-titulo" class="text-2xl lg:text-3xl">Preguntas de dueños</h2>
      <div class="mt-6 border-t border-cal">
        {preguntas.map(([p, r]) => (
          <details class="group border-b border-cal">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold [&::-webkit-details-marker]:hidden">
              {p}
              <Icon nombre="mas" class="h-5 w-5 shrink-0 text-pizarra transition-transform group-open:rotate-45" />
            </summary>
            <p class="pb-4 text-pizarra">{r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
