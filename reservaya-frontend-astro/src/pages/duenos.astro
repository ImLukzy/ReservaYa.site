---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Planes from "../components/Planes.astro";
import Icon from "../components/ui/Icon.astro";
import PatronCancha from "../components/ui/PatronCancha.astro";
import SeccionTitulo from "../components/inicio/SeccionTitulo.astro";
import PreguntasTactiles, { type Pregunta } from "../components/inicio/PreguntasTactiles.astro";
import BandaCierre from "../components/inicio/BandaCierre.astro";
import { whatsappUrl } from "../lib/contacto";
import { NUMERO_PASO } from "../lib/estilos";

const pasos = [
  "Crea tu cuenta en ReservaYa.",
  "Escríbenos y activamos tu cuenta de dueño.",
  "Registra tu complejo: canchas, fotos, horarios y precios.",
  "Elige tu plan. Cuando lo aprobamos, tus canchas aparecen en la búsqueda.",
];

const introEmpiezas = "Cuatro pasos claros: crea tu cuenta en ReservaYa, actívala con nosotros, registra tu complejo y sus canchas, elige tu plan. Listo.";
const ventajas = ["Sin contratos de permanencia", "Funciona en el navegador, sin instalar", "Soporte directo por WhatsApp"];
const whatsapp = whatsappUrl("Hola, quiero publicar mis canchas en ReservaYa");

const modulos = [
  { id: "reservas", icono: "ticket", titulo: "Reservas", texto: "Confirmas o rechazas cada reserva. La confirmada trae un código que el jugador muestra al llegar." },
  { id: "precios", icono: "calendario", titulo: "Horarios y precios", texto: "Defines el horario de cada día, precios especiales por franja y descuentos." },
  { id: "caja", icono: "billete", titulo: "Caja", texto: "Abres y cierras caja, vendes productos y registras cada cobro con su método." },
  { id: "equipo", icono: "grupo", titulo: "Trabajadores", texto: "Cada trabajador entra con su cuenta a la agenda, las reservas y la caja. No ve tus reportes ni tus ingresos." },
  { id: "reportes", icono: "grafico", titulo: "Reportes", texto: "Ingresos, reservas y metas del mes de cada complejo." },
  { id: "resenas", icono: "mensaje", titulo: "Opiniones", texto: "Solo opinan jugadores con una reserva completada, y tú puedes responder." },
  { id: "torneos", icono: "trofeo", titulo: "Torneos", texto: "Inscribes equipos, armas los partidos y registras los resultados." },
] as const;

const preguntas: Pregunta[] = [
  { categoria: "Panel", icono: "pantalla", pregunta: "¿Tengo que instalar algo?", respuesta: "No, el panel funciona directamente en el navegador. Creas tu cuenta, registras el complejo y completas sus canchas, fotos, horarios y precios desde el celular o la computadora. Luego usas el mismo panel para atender reservas y administrar la operación. Solo necesitas entrar con la cuenta que tenga acceso al complejo." },
  { categoria: "Cobros", icono: "billete", pregunta: "¿ReservaYa cobra las reservas por mí?", respuesta: "No, actualmente el cobro lo realiza cada complejo. Cuando atiendes una reserva, recibes el pago por el medio que uses normalmente y luego lo registras en la caja del panel con su método. Ese registro queda dentro de la gestión del complejo. La forma de cobro al jugador sigue dependiendo de tu negocio." },
  { categoria: "Sedes", icono: "lugar", pregunta: "¿Sirve si tengo varias sedes?", respuesta: "Sí, puedes gestionar más de un complejo desde el panel. Registras cada sede como un complejo y configuras por separado sus canchas, horarios, precios y trabajadores. Después puedes consultar su agenda, caja y reportes según el complejo seleccionado. La información operativa de cada sede se mantiene asociada a ese complejo." },
  { categoria: "Reservas", icono: "reloj", pregunta: "¿Qué pasa con una reserva pendiente?", respuesta: "Una reserva pendiente todavía requiere una decisión del complejo. En el módulo de reservas revisas la solicitud y eliges confirmarla o rechazarla; mientras siga pendiente, no bloquea el horario. Al confirmarla, el jugador recibe el estado confirmado y puede ver su código. La atención de cada solicitud queda a cargo del complejo." },
  { categoria: "Planes", icono: "documento", pregunta: "¿Hay contrato de permanencia?", respuesta: "No, los planes se presentan sin contrato de permanencia. En la sección de planes eliges la opción que corresponda a tu operación y puedes comparar el pago mensual con el anual. El descuento anual se muestra allí antes de elegir. Las funciones disponibles dependen del plan seleccionado." },
  { categoria: "Canchas", icono: "calendario", pregunta: "¿Qué puedo configurar de mis canchas?", respuesta: "Puedes registrar las canchas de cada complejo con sus fotos, horarios y precios. Primero creas el complejo, luego agregas sus canchas y finalmente defines el horario de cada día, las franjas con precios especiales y los descuentos. Esa información alimenta la disponibilidad que ven los jugadores. Cada configuración queda vinculada al complejo correspondiente." },
  { categoria: "Trabajadores", icono: "grupo", pregunta: "¿Qué acceso tienen mis trabajadores?", respuesta: "Cada trabajador entra al panel con su propia cuenta. Después de agregarlo al complejo, puede usar la agenda, atender las reservas y trabajar con la caja. El panel no le muestra tus reportes ni tus ingresos. Así separas las tareas operativas de la información reservada para la administración." },
  { categoria: "Reportes", icono: "grafico", pregunta: "¿Qué muestran los reportes?", respuesta: "Los reportes reúnen información de ingresos, reservas y metas del mes. Entras al módulo de reportes y consultas los datos del complejo que estás administrando. Si manejas varias sedes, seleccionas el complejo para revisar su operación correspondiente. Los trabajadores no tienen acceso a estos reportes ni a tus ingresos." },
];
---

<BaseLayout
  title="Publica tus canchas | ReservaYa para dueños"
  description="Recibe reservas de tus canchas en Arequipa sin contestar llamadas. Agenda, precios, caja y trabajadores en un solo panel."
>
  <section class="relative overflow-hidden bg-noche">
    <PatronCancha />
    <div class="relative z-10 mx-auto grid max-w-page gap-10 px-4 pb-14 pt-8 md:px-6 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-center lg:gap-16 lg:pb-20 lg:pt-14">
      <div class="duenos-hero-entra">
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-2 rounded-full border border-cesped/40 bg-cesped/15 px-3 py-1">
            <span class="h-2 w-2 rounded-full bg-cesped pulso-inicial" aria-hidden="true"></span>
            <span class="eyebrow text-cesped-suave">Panel de gestión para dueños</span>
          </span>
          <span class="eyebrow text-tiza/70">Arequipa</span>
        </div>
        <h1 class="mt-4 font-display text-4xl font-black tracking-tight text-tiza sm:text-5xl lg:text-6xl">
          Publica tus canchas y recibe reservas sin llamadas
        </h1>
        <p class="mt-4 max-w-xl text-lg text-tiza/80 sm:text-xl leading-relaxed">
          Los jugadores de Arequipa ven tus horas libres con su precio y te envían la reserva. Tú la confirmas desde el panel.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/register?plan=dueno" class="shadow-dura-sm">Crear mi cuenta</Button>
          <Button href={whatsapp} variante="secundario" target="_blank" rel="noopener">Escribir por WhatsApp</Button>
        </div>
        <ul class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm font-bold text-tiza/80">
          {ventajas.map((v) => (
            <li class="inline-flex items-center gap-2">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-cesped text-tiza"><Icon nombre="ok" class="h-3 w-3" /></span>{v}
            </li>
          ))}
        </ul>
      </div>

      <div class="card-tactil relative z-10 bg-tiza p-6 shadow-dura-cesped sm:p-8">
        <div class="flex items-center justify-between gap-3 border-b-2 border-cal pb-3">
          <div>
            <h2 class="font-display text-xl font-black tracking-tight text-basalto">Cómo empiezas</h2>
            <p class="mt-2 text-sm text-pizarra">{introEmpiezas}</p>
          </div>
          <span class="shrink-0 rounded-full bg-cesped-suave px-2.5 py-0.5 font-display text-xs font-extrabold text-cesped-hondo">{pasos.length} pasos</span>
        </div>
        <ol class="mt-5 space-y-4">
          {pasos.map((p, i) => (
            <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] items-start gap-3">
              <span class={NUMERO_PASO}>{i + 1}</span>
              <span class="pt-1 text-sm font-semibold leading-snug text-basalto sm:text-base">{p}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div
      class="h-3 w-full border-t-2 border-basalto"
      style="background-image: repeating-linear-gradient(45deg, var(--color-cesped) 0 0.875rem, var(--color-cesped-hondo) 0.875rem 1.75rem);"
      aria-hidden="true"
    ></div>
  </section>

  <style>
    @media (prefers-reduced-motion: no-preference) {
      .duenos-hero-entra {
        animation: duenos-entra var(--dur-resorte) var(--ease-resorte) both;
      }
    }
    @keyframes duenos-entra {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <section aria-labelledby="panel-titulo" class="border-y-2 border-basalto bg-tiza">
    <div class="revelar mx-auto max-w-page px-4 py-16 md:px-6 lg:py-24">
      <SeccionTitulo
        id="panel-titulo"
        antetitulo="Módulos del panel"
        titulo="Qué haces desde el panel"
        bajada="Gestiona 7 módulos sin instalar nada en el navegador: reservas confirmadas, agenda, caja del día, trabajadores con su acceso, reportes de ingresos, opiniones de jugadores, torneos. Un complejo o varios."
      />
      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3">
        {modulos.map((m, i) => (
          <article id={m.id} class={`card-tactil flex gap-4 p-5 ${i === 0 ? "bg-cesped-suave sm:col-span-2" : i === modulos.length - 1 ? "bg-miel-suave lg:col-span-2" : "bg-tiza"}`}>
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-surface border-2 border-basalto bg-cesped text-tiza">
              <Icon nombre={m.icono} class="h-5 w-5" />
            </span>
            <div>
              <h3 class="font-display text-xl font-black text-basalto">{m.titulo}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-pizarra sm:text-base">{m.texto}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Planes />

  <section aria-labelledby="preguntas-titulo" class="border-t-2 border-basalto bg-tiza">
    <div class="revelar mx-auto max-w-page px-4 py-16 md:px-6 lg:py-24">
      <SeccionTitulo
        id="preguntas-titulo"
        antetitulo="Ayuda para dueños"
        titulo="Preguntas de dueños"
        bajada="Dudas reales antes de registrarte: ¿sin contratos?, ¿sin instalar?, ¿funciona con varias sedes?, ¿cómo cobro?, ¿qué pasa con reservas pendientes? Aquí están las respuestas."
      />
      <PreguntasTactiles preguntas={preguntas} />
    </div>
  </section>

  <BandaCierre
    id="empezar-titulo"
    antetitulo="Empieza hoy"
    titulo="Recibe reservas de tus canchas"
    bajada="Crea tu cuenta, escríbenos para activarla y registra tu complejo. Sin contratos de permanencia."
    primario={{ href: "/register?plan=dueno", texto: "Crear mi cuenta" }}
    secundario={{ href: whatsapp, texto: "Escribir por WhatsApp", externo: true }}
  />
</BaseLayout>
