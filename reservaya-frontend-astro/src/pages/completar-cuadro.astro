---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Field from "../components/ui/Field.astro";
import Select from "../components/ui/Select.astro";
import Icon from "../components/ui/Icon.astro";
import { API, APP } from "../lib/entorno";
import { AVISO, BOTON, ETIQUETA, INSIGNIA, INSIGNIA_BASE } from "../lib/estilos";

const apiUrl = API;
const niveles = ["Todos los niveles", "Principiante", "Intermedio", "Avanzado"];
const formatos = ["Fútbol 5", "Fútbol 6", "Fútbol 7", "Fútbol 8", "Fútbol 9", "Fútbol 11"];
const superficies = ["Grass sintético", "Losa", "Grass natural"].map((s) => ({ valor: s, etiqueta: s }));
const nivelesForm = ["Principiante", "Intermedio", "Avanzado"].map((n) => ({ valor: n, etiqueta: n }));
const chip = "chip-tactil cursor-pointer";
const clases = { ok: AVISO.ok, error: AVISO.error, chip, libre: `${INSIGNIA_BASE} ${INSIGNIA.libre}`, primario: BOTON.primario };
---

<BaseLayout title="Partidos abiertos | ReservaYa" description="Súmate a un partido abierto en Arequipa o publica el tuyo para completar el cuadro.">
  <section class="mx-auto max-w-page px-4 pb-16 pt-8 md:px-6 lg:pt-12">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <div class="flex items-center gap-2">
          <span class="font-display text-xs font-bold uppercase tracking-wider text-cesped-hondo">Completa el cuadro</span>
          <span class="text-xs text-pizarra">·</span>
          <span class="font-display text-xs font-bold uppercase tracking-wider text-pizarra">Partidos en Arequipa</span>
        </div>
        <h1 class="mt-2 font-display text-4xl font-black tracking-tight text-basalto sm:text-5xl">Partidos abiertos</h1>
        <p class="mt-3 max-w-xl text-base text-pizarra sm:text-lg">Te anotas en un partido abierto, el organizador te confirma por WhatsApp y a la cancha. Si te faltan, publica tu pichanga y encuentra con quién jugar.</p>
      </div>
      <div class="flex gap-3">
        <Button data-open-publish class="shadow-dura-sm"><Icon nombre="mas" class="h-4 w-4" />Publicar partido</Button>
        <Button href={`${APP}/dashboard/partidos`} variante="secundario">Mis partidos</Button>
      </div>
    </div>

    <div class="card-tactil mt-8 grid gap-4 bg-sillar/40 p-5 shadow-dura md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
      <Field id="q" etiqueta="Buscar" placeholder="Distrito, cancha o título" autocomplete="off" type="search" />
      <div id="nivs" class="flex flex-wrap gap-2" role="group" aria-label="Nivel">
        {niveles.map((n, i) => <button type="button" data-n={n} aria-pressed={i === 0 ? "true" : "false"} class={`${chip} ${i === 0 ? "active" : ""}`}>{n}</button>)}
      </div>
    </div>
    <p id="count-line" class="mt-4 text-pizarra"><strong id="count" class="font-display text-lg font-extrabold tabular-nums text-basalto">–</strong> partidos abiertos con <strong id="stat-cupos" class="font-display text-lg font-extrabold tabular-nums text-basalto">–</strong> cupos libres</p>

    <div class="card-tactil mt-4 overflow-hidden bg-tiza p-0 shadow-dura">
      <ul id="lista" aria-live="polite">
        <li class="h-24 border-b border-cal px-5 py-5" aria-hidden="true"><span class="esqueleto block h-5 w-1/2"></span><span class="esqueleto mt-3 block h-4 w-1/3"></span></li>
        <li class="h-24 px-5 py-5" aria-hidden="true"><span class="esqueleto block h-5 w-2/5"></span><span class="esqueleto mt-3 block h-4 w-1/4"></span></li>
      </ul>
      <div id="vacio" hidden class="card-dashed mx-4 my-6 p-8 text-center">
        <p class="font-display text-xl font-bold">Todavía no hay partidos abiertos</p>
        <p class="mx-auto mt-2 max-w-sm text-pizarra">Publica el tuyo y encuentra con quién jugar.</p>
        <Button data-open-publish class="mt-5"><Icon nombre="mas" class="h-4 w-4" />Publicar partido</Button>
      </div>
    </div>
    <p id="lista-error" hidden class={`mt-4 ${AVISO.error}`} role="alert"></p>
  </section>

  <dialog id="publish-modal" aria-labelledby="publish-title" class="card-tactil m-auto max-h-[calc(100vh-2rem)] w-[min(48rem,calc(100%-2rem))] overflow-y-auto bg-tiza p-0 text-basalto shadow-dura-lg backdrop:bg-velo">
    <div class="flex items-center justify-between border-b-2 border-basalto/15 px-5 py-3">
      <h2 id="publish-title" class="font-display text-2xl font-black">Publicar un partido</h2>
      <button type="button" data-publish-close aria-label="Cerrar" class="flex h-11 w-11 items-center justify-center rounded-full hover:bg-piedra"><Icon nombre="cerrar" /></button>
    </div>
    <form id="publish-form" class="grid gap-5 p-5 md:grid-cols-[14rem_minmax(0,1fr)]" novalidate>
      <div>
        <p class={ETIQUETA}>Foto (opcional)</p>
        <label for="p-foto" class="flex h-40 cursor-pointer flex-col items-center justify-center gap-1 overflow-hidden rounded-control border border-dashed border-borde bg-sillar text-pizarra hover:bg-piedra">
          <img id="p-foto-preview" alt="" hidden class="h-full w-full object-cover" />
          <span id="p-foto-empty" class="font-medium">Subir foto</span>
        </label>
        <input id="p-foto" type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" />
        <Field id="p-desc" etiqueta="Descripción" multilinea filas={4} placeholder="Faltan 4, se pide puntualidad." class="mt-4" />
      </div>
      <div class="space-y-3">
        <Field id="p-titulo" etiqueta="Título" required maxlength="80" placeholder="Pichanga de los viernes" />
        <fieldset>
          <legend class={ETIQUETA}>Formato</legend>
          <div id="p-formatos" class="grid grid-cols-3 gap-2">
            {formatos.map((f, i) => <button type="button" data-f={f} aria-pressed={i === 2 ? "true" : "false"} class={chip}>{f}</button>)}
          </div>
        </fieldset>
        <div class="grid gap-3 sm:grid-cols-2">
          <Select id="p-nivel" etiqueta="Nivel" opciones={nivelesForm} valor="Intermedio" />
          <Field id="p-cupos" type="number" etiqueta="Cupos totales" min="2" max="30" value="14" />
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
          <Field id="p-fecha" type="date" etiqueta="Fecha" required />
          <Field id="p-desde" type="time" etiqueta="Desde" required />
          <Field id="p-hasta" type="time" etiqueta="Hasta" required />
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <Field id="p-distrito" etiqueta="Distrito" required maxlength="60" placeholder="Yanahuara" autocomplete="off" />
          <Field id="p-cancha" etiqueta="Cancha" required maxlength="80" placeholder="Nombre del complejo" autocomplete="off" />
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <Select id="p-superficie" etiqueta="Superficie" opciones={superficies} />
          <Field id="p-precio" type="number" etiqueta="Precio por persona (S/)" min="0" step="1" placeholder="0" />
        </div>
        <p id="publish-status" hidden role="alert"></p>
        <div class="flex justify-end gap-3 pt-2">
          <Button data-publish-close variante="secundario">Cancelar</Button>
          <Button type="submit" id="publish-submit">Publicar partido</Button>
        </div>
      </div>
    </form>
  </dialog>

  <dialog id="join-modal" aria-labelledby="join-title" class="card-tactil m-auto w-[min(28rem,calc(100%-2rem))] bg-tiza p-6 text-basalto shadow-dura-lg backdrop:bg-velo">
    <h2 id="join-title" class="flex items-center gap-2 font-display text-2xl font-black"><Icon nombre="ok" class="h-6 w-6 text-cesped-hondo" />Te anotaste</h2>
    <p id="join-summary" class="mt-2 text-pizarra"></p>
    <div class="mt-5 grid gap-2">
      <a id="join-share" href="https://wa.me/" target="_blank" rel="noopener" class={BOTON.primario}>Avisar por WhatsApp</a>
      <Button data-join-close variante="secundario">Seguir viendo partidos</Button>
    </div>
  </dialog>
</BaseLayout>

<script is:inline define:vars={{ apiUrl, clases }}>
(function () {
  var base = String(apiUrl);
  function $(id) { return document.getElementById(id); }
  var q = $("q");
  var nivBox = $("nivs");
  var lista = $("lista");
  var vacio = $("vacio");
  var countEl = $("count");
  var errEl = $("lista-error");
  var statCupos = $("stat-cupos");
  if (!q || !lista || !vacio || !countEl) return;

  var partidos = [];
  var nivel = "Todos los niveles";
  var formato = "Fútbol 7";

  function showError(msg, ok) {
    if (!errEl) return;
    errEl.textContent = msg || "";
    errEl.className = "mt-4 " + (ok ? clases.ok : clases.error);
    errEl.hidden = !msg;
  }

  function resumen(p) {
    var cuando = p.cuando || [p.fechaCorta, p.horaCorta].filter(Boolean).join(" ") || p.fecha || "";
    var lugar = [p.distrito, p.nivel].filter(Boolean).join(", ");
    return [cuando, lugar].filter(Boolean).join(", ");
  }

  function fila(p) {
    var li = document.createElement("li");
    li.className = "fila-entra flex flex-col gap-3 border-b-2 border-basalto/15 px-5 py-4 last:border-b-0 sm:flex-row sm:items-center sm:justify-between";
    var left = document.createElement("div");
    var title = document.createElement("p");
    title.className = "font-semibold";
    title.textContent = p.titulo || "Partido abierto";
    var sub = document.createElement("p");
    sub.className = "text-sm text-pizarra";
    sub.textContent = resumen(p);
    left.append(title, sub);
    var right = document.createElement("div");
    right.className = "flex items-center gap-3";
    var pill = document.createElement("span");
    pill.className = clases.libre;
    pill.textContent = (p.cuposLibres != null ? p.cuposLibres : "–") + " cupos";
    var btn = document.createElement("button");
    btn.type = "button";
    btn.className = clases.primario;
    var lleno = (parseInt(p.cuposLibres, 10) || 0) <= 0 && !p.anotado;
    if (p.anotado) { btn.textContent = "Anotado"; btn.disabled = true; }
    else if (lleno) { btn.textContent = "Lleno"; btn.disabled = true; }
    else { btn.textContent = "Anotarme"; btn.addEventListener("click", function () { anotarse(p, btn); }); }
    right.append(pill, btn);
    li.append(left, right);
    return li;
  }

  function pintar() {
    var t = q.value.toLowerCase().trim();
    var visibles = partidos.filter(function (p) {
      var okN = nivel === "Todos los niveles" || p.nivel === nivel;
      var txt = ((p.titulo || "") + " " + (p.distrito || "") + " " + (p.cancha || "")).toLowerCase();
      return okN && (!t || txt.indexOf(t) !== -1);
    });
    lista.replaceChildren.apply(lista, visibles.map(fila));
    countEl.textContent = String(visibles.length);
    vacio.hidden = !(visibles.length === 0 && partidos.length === 0);
    lista.hidden = visibles.length === 0 && partidos.length === 0;
    var cupos = partidos.reduce(function (acc, p) { return acc + (parseInt(p.cuposLibres, 10) || 0); }, 0);
    if (statCupos) statCupos.textContent = String(cupos);
  }

  function cargar() {
    fetch(base + "/api/partidos", { credentials: "include" })
      .then(function (res) {
        if (!res.ok) throw new Error("http " + res.status);
        return res.json().catch(function () { return null; });
      })
      .then(function (body) {
        var arr = body ? (body.partidos || body.data || body.items) : null;
        partidos = Array.isArray(arr) ? arr : [];
        pintar();
      })
      .catch(function () {
        partidos = [];
        pintar();
        showError("No pudimos cargar los partidos. Igual puedes publicar el tuyo.");
      });
  }

  var nivBtns = nivBox ? Array.prototype.slice.call(nivBox.querySelectorAll("button")) : [];
  nivBtns.forEach(function (b) {
    b.addEventListener("click", function () {
      nivel = b.getAttribute("data-n") || nivel;
      nivBtns.forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
      pintar();
    });
  });
  q.addEventListener("input", pintar);

  var joinModal = $("join-modal");
  function openJoin(p) {
    if (!joinModal) return;
    var sum = $("join-summary");
    if (sum) sum.textContent = (p.titulo || "Partido") + ", " + resumen(p) + ".";
    var share = $("join-share");
    if (share) share.href = "https://wa.me/?text=" + encodeURIComponent("Me anoté en \"" + (p.titulo || "un partido") + "\" (" + resumen(p) + ") por ReservaYa. ¡Súmate!");
    joinModal.showModal();
  }
  Array.prototype.forEach.call(document.querySelectorAll("[data-join-close]"), function (el) {
    el.addEventListener("click", function () { if (joinModal) joinModal.close(); });
  });

  function anotarse(p, btn) {
    btn.disabled = true;
    var orig = btn.textContent;
    btn.textContent = "Anotando...";
    fetch(base + "/api/partidos/" + encodeURIComponent(p.id) + "/anotarse", {
      method: "POST",
      credentials: "include",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({})
    })
      .then(function (res) {
        if (res.status === 401) {
          window.location.href = "/login?returnUrl=" + encodeURIComponent("/completar-cuadro");
          return null;
        }
        if (!res.ok) throw new Error("No se pudo completar tu anotación");
        return res.json().catch(function () { return {}; });
      })
      .then(function (body) {
        if (!body) return;
        p.anotado = true;
        if (typeof p.cuposLibres === "number" && p.cuposLibres > 0) p.cuposLibres -= 1;
        pintar();
        openJoin(p);
      })
      .catch(function (e) {
        btn.disabled = false;
        btn.textContent = orig;
        showError(e && e.message ? e.message : "No se pudo completar tu anotación");
      });
  }

  var pubModal = $("publish-modal");
  function openPublish() {
    if (!pubModal) return;
    pubModal.showModal();
    var f = $("p-fecha");
    if (f && !f.value) {
      var d = new Date();
      d.setDate(d.getDate() + 1);
      f.value = d.toISOString().slice(0, 10);
    }
  }
  function closePublish() { if (pubModal) pubModal.close(); }
  Array.prototype.forEach.call(document.querySelectorAll("[data-open-publish]"), function (el) { el.addEventListener("click", openPublish); });
  Array.prototype.forEach.call(document.querySelectorAll("[data-publish-close]"), function (el) { el.addEventListener("click", closePublish); });

  var fmtBox = $("p-formatos");
  if (fmtBox) {
    var fmtBtns = Array.prototype.slice.call(fmtBox.querySelectorAll("button"));
    fmtBtns.forEach(function (b) {
      b.addEventListener("click", function () {
        formato = b.getAttribute("data-f") || formato;
        fmtBtns.forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
      });
    });
  }

  var fotoInput = $("p-foto");
  if (fotoInput) {
    fotoInput.addEventListener("change", function () {
      var f = fotoInput.files && fotoInput.files[0];
      var img = $("p-foto-preview");
      var empty = $("p-foto-empty");
      if (f && img) {
        img.src = URL.createObjectURL(f);
        img.hidden = false;
        if (empty) empty.hidden = true;
      }
    });
  }

  var form = $("publish-form");
  var pubStatus = $("publish-status");
  function pubMsg(msg) {
    if (!pubStatus) return;
    pubStatus.textContent = msg || "";
    pubStatus.className = clases.error;
    pubStatus.hidden = !msg;
  }
  if (form) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      pubMsg("");
      var titulo = $("p-titulo").value.trim();
      var fecha = $("p-fecha").value;
      var desde = $("p-desde").value;
      var hasta = $("p-hasta").value;
      var distrito = $("p-distrito").value.trim();
      var cancha = $("p-cancha").value.trim();
      if (!titulo || !fecha || !desde || !hasta || !distrito || !cancha) {
        pubMsg("Completa título, fecha, horario, distrito y cancha.");
        return;
      }
      var submit = $("publish-submit");
      if (submit) { submit.disabled = true; submit.textContent = "Publicando..."; }
      var fd = new FormData();
      fd.append("titulo", titulo);
      fd.append("formato", formato);
      fd.append("nivel", $("p-nivel").value);
      fd.append("cuposTotales", $("p-cupos").value);
      fd.append("fecha", fecha);
      fd.append("desde", desde);
      fd.append("hasta", hasta);
      fd.append("distrito", distrito);
      fd.append("cancha", cancha);
      fd.append("superficie", $("p-superficie").value);
      fd.append("precio", $("p-precio").value || "0");
      fd.append("descripcion", $("p-desc").value.trim());
      if (fotoInput && fotoInput.files && fotoInput.files[0]) fd.append("foto", fotoInput.files[0]);
      fetch(base + "/api/partidos", { method: "POST", credentials: "include", body: fd })
        .then(function (res) {
          if (res.status === 401) {
            window.location.href = "/login?returnUrl=" + encodeURIComponent("/completar-cuadro");
            return null;
          }
          if (!res.ok) throw new Error("No se pudo publicar tu partido");
          return res.json().catch(function () { return {}; });
        })
        .then(function (body) {
          if (!body) return;
          closePublish();
          form.reset();
          var img = $("p-foto-preview");
          var empty = $("p-foto-empty");
          if (img) { img.removeAttribute("src"); img.hidden = true; }
          if (empty) empty.hidden = false;
          cargar();
          showError("Partido publicado. Ya aparece en la lista.", true);
        })
        .catch(function (err) { pubMsg(err && err.message ? err.message : "No se pudo publicar tu partido"); })
        .finally(function () { if (submit) { submit.disabled = false; submit.textContent = "Publicar partido"; } });
    });
  }

  cargar();
  if (new URLSearchParams(window.location.search).get("publicar") === "1") openPublish();
})();
</script>
