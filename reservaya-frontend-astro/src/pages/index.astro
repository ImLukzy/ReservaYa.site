---
import BaseLayout from "../layouts/BaseLayout.astro";
import SlotBoard from "../components/ui/SlotBoard.astro";
import Select from "../components/ui/Select.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import { DISTRITOS, TIPOS } from "../lib/arequipa";
import { BOTON } from "../lib/estilos";

const distritos = [{ valor: "", etiqueta: "Todo Arequipa" }, ...DISTRITOS.map((d) => ({ valor: d, etiqueta: d }))];
const tipos = [{ valor: "", etiqueta: "Todo deporte" }, ...TIPOS];
const dias = [{ valor: "hoy", etiqueta: "Hoy" }, { valor: "manana", etiqueta: "Mañana" }];

const pasos = [
  { titulo: "Busca", texto: "Elige distrito, deporte y hora. Solo ves canchas libres, con su precio." },
  { titulo: "Reserva", texto: "Envía la reserva desde tu cuenta. El complejo la confirma en su panel." },
  { titulo: "Juega", texto: "Con la reserva confirmada tienes un código. Lo muestras al llegar y entras a jugar." },
];

const extras = [
  { href: "/completar-cuadro", titulo: "Te faltan jugadores", texto: "Publica tu partido o súmate a uno abierto en tu distrito.", accion: "Ver partidos abiertos" },
  { href: "/sortear", titulo: "Arma equipos parejos", texto: "Escribe los nombres y reparte los equipos al azar, sin discusiones.", accion: "Armar equipos" },
  { href: "/torneos", titulo: "Torneos en complejos", texto: "Los complejos organizan sus torneos con inscripciones, partidos y resultados.", accion: "Ver torneos" },
];

const preguntas = [
  ["¿Necesito pagar en la página?", "No. Reservas el horario y pagas en el complejo, con el método que uses siempre."],
  ["¿Qué pasa si mi reserva queda pendiente?", "No bloquea el horario hasta que el complejo la confirma."],
  ["¿Cómo entro a jugar?", "Con la reserva confirmada ves tu código en Mi partido y lo muestras al llegar a la cancha."],
  ["¿En qué distritos hay canchas?", "En los 29 distritos de Arequipa: eliges el tuyo y ves las canchas libres cerca de ti."],
  ["¿Necesito crear una cuenta?", "Sí, con tu nombre, correo, fecha de nacimiento y una contraseña."],
];
---

<BaseLayout
  title="ReservaYa | Canchas libres en Arequipa"
  description="Mira qué canchas de fútbol, vóley, básquet, pádel y tenis están libres hoy en Arequipa y resérvalas en un minuto."
>
  <section class="relative overflow-hidden bg-noche">
    <div class="mx-auto grid max-w-page gap-8 px-4 pb-14 pt-8 md:px-6 lg:grid-cols-[19rem_minmax(0,1fr)] lg:gap-12 lg:pb-20 lg:pt-12">
      <div>
        <h1 class="text-3xl text-tiza lg:text-4xl">Canchas libres en Arequipa</h1>
        <p class="mt-3 max-w-md text-lg text-tiza/75">Elige la hora, mira el precio y reserva en un minuto.</p>

        <form action="/canchas" method="get" class="mt-6 grid grid-cols-2 gap-3 rounded-surface border border-cal bg-tiza p-4 lg:grid-cols-1 lg:p-5" role="search" aria-label="Buscar canchas">
          <Select id="buscar-distrito" name="distrito" etiqueta="Distrito" etiquetaOculta opciones={distritos} />
          <Select id="buscar-tipo" name="tipo" etiqueta="Deporte" etiquetaOculta opciones={tipos} />
          <Select id="buscar-dia" name="fecha" etiqueta="Día" etiquetaOculta opciones={dias} />
          <input id="buscar-hora" type="hidden" name="hora" value="" />
          <Button type="submit" class="lg:mt-1">Buscar canchas</Button>
        </form>
      </div>

      <SlotBoard />
    </div>
    <div
      class="h-3 w-full border-t border-cal"
      style="background-image: repeating-linear-gradient(45deg, var(--color-cesped) 0 14px, var(--color-cesped-hondo) 14px 28px);"
      aria-hidden="true"
    ></div>
  </section>

  <section id="como-funciona" aria-labelledby="como-titulo" class="border-y border-cal bg-tiza">
    <div class="mx-auto max-w-page px-4 py-12 md:px-6 lg:py-16">
      <h2 id="como-titulo" class="text-2xl lg:text-3xl">Cómo funciona</h2>
      <ol class="mt-6 grid md:grid-cols-3">
        {pasos.map((p, i) => (
          <li class="border-t border-cal py-5 md:border-l md:border-t-0 md:px-6 md:py-2 md:first:border-l-0 md:first:pl-0">
            <p class="font-display text-3xl font-bold tabular-nums">{i + 1}</p>
            <h3 class="mt-1 text-xl">{p.titulo}</h3>
            <p class="mt-1 max-w-xs text-pizarra">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="deportes-titulo" class="mx-auto max-w-page px-4 py-12 md:px-6 lg:py-16">
    <h2 id="deportes-titulo" class="text-2xl lg:text-3xl">Todos los deportes</h2>
    <p class="mt-2 max-w-xl text-pizarra">Busca cancha por el deporte que juegas.</p>
    <ul class="mt-6 flex flex-wrap gap-3">
      {TIPOS.map((t) => (
        <li>
          <a
            href={`/canchas?tipo=${t.valor}`}
            class="inline-flex min-h-11 items-center gap-2 rounded-control border border-borde bg-tiza px-4 font-semibold text-basalto hover:bg-piedra"
          >
            {t.etiqueta}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="distritos-titulo" class="border-y border-cal bg-cielo">
    <div class="mx-auto max-w-page px-4 py-12 md:px-6 lg:py-16">
      <h2 id="distritos-titulo" class="text-2xl lg:text-3xl">Cobertura en los 29 distritos de Arequipa</h2>
      <p class="mt-2 max-w-xl text-pizarra">Elige tu distrito y mira las canchas libres cerca de ti.</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {DISTRITOS.map((d) => (
          <li>
            <a
              href={`/canchas?distrito=${encodeURIComponent(d)}`}
              class="inline-flex min-h-11 items-center rounded-control border border-cal bg-tiza px-3 text-sm font-medium text-basalto hover:bg-piedra"
            >
              {d}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="extras-titulo" class="mx-auto max-w-page px-4 py-12 md:px-6 lg:py-16">
    <h2 id="extras-titulo" class="text-2xl lg:text-3xl">Para el resto del partido</h2>
    <ul class="mt-6 border-t border-cal">
      {extras.map((e) => (
        <li class="grid gap-2 border-b border-cal py-5 md:grid-cols-[16rem_minmax(0,1fr)_auto] md:items-center md:gap-6">
          <h3 class="text-xl">{e.titulo}</h3>
          <p class="text-pizarra">{e.texto}</p>
          <a href={e.href} class={BOTON.texto}>{e.accion}</a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="preguntas-titulo" class="border-t border-cal bg-tiza">
    <div class="mx-auto max-w-texto px-4 py-12 md:px-6 lg:py-16">
      <h2 id="preguntas-titulo" class="text-2xl lg:text-3xl">Preguntas frecuentes</h2>
      <div class="mt-6 border-t border-cal">
        {preguntas.map(([p, r]) => (
          <details class="group border-b border-cal">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold [&::-webkit-details-marker]:hidden">
              {p}
              <Icon nombre="mas" class="h-5 w-5 shrink-0 text-pizarra transition-transform group-open:rotate-45" />
            </summary>
            <p class="pb-4 text-pizarra">{r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="duenos-titulo" class="border-t border-cal bg-cielo">
    <div class="mx-auto flex max-w-page flex-col gap-6 px-4 py-12 md:flex-row md:items-center md:justify-between md:px-6">
      <div>
        <h2 id="duenos-titulo" class="text-2xl lg:text-3xl">¿Tienes canchas en Arequipa?</h2>
        <p class="mt-2 max-w-xl text-pizarra">Publica tus horarios y recibe reservas sin contestar llamadas. Agenda, precios y caja en un solo panel; las confirmas cuando quieras.</p>
      </div>
      <Button href="/duenos" class="shrink-0">Publicar mis canchas</Button>
    </div>
  </section>
</BaseLayout>
