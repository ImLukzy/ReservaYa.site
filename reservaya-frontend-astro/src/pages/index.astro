---
import BaseLayout from "../layouts/BaseLayout.astro";

const cities = ["YANAHUARA","CAYMA","CERRO COLORADO","MIRAFLORES","HUNTER","SABANDÍA","CHARACATO","SOCABAYA","PAUCARPATA","BUSTAMANTE","MARIANO MELGAR","SELVA ALEGRE","SACHACA","TIABAYA","UCHUMAYO","YURA"];
const pins = [
  { name: "Cayma", price: "S/ 65/h", x: "68%", y: "28%", fmt: "F7" },
  { name: "San Isidro", price: "S/ 80/h", x: "48%", y: "38%", fmt: "F5" },
  { name: "La Molina", price: "S/ 55/h", x: "28%", y: "68%", fmt: "F5" },
  { name: "Paucarpata", price: "S/ 70/h", x: "62%", y: "60%", fmt: "F7" },
  { name: "Barranco", price: "S/ 60/h", x: "74%", y: "76%", fmt: "F5" },
];
const slots = ["06:00","07:00","08:00","09:00","10:00","11:00"];
const players = [
  { init: "DL", name: "Diego L.", zone: "Cayma", text: "Encontré canchas que ni sabía que existían a 5 cuadras de mi casa. Brutal.", tag: "Jugador · F7" },
  { init: "RP", name: "Rodrigo P.", zone: "San Borja", text: "El código es perfectazo. Llegas, lo muestras y entras. Sin esperar, sin explicar nada.", tag: "Jugador · F5" },
  { init: "MA", name: "Marco A.", zone: "La Molina", text: "Divido el pago con mis patas desde la app. Ya nadie lleva efectivo al partido.", tag: "Jugador · F11" },
  { init: "LR", name: "Luis R.", zone: "Barranco", text: "Me avisa cuando hay canchas libres de última hora. Salvó más de un partido a las 11pm.", tag: "Jugador · F5" },
  { init: "KS", name: "Kevin S.", zone: "Jesús María", text: "La sección de filtros es genial. Grass, techada, precio — en 30 segundos tengo opciones.", tag: "Jugador · F7" },
  { init: "AV", name: "André V.", zone: "San Miguel", text: "Antes perdíamos 20 min para ver si había cancha. Ahora llegamos y listo.", tag: "Jugador · F5" },
];
const owners = [
  { init: "WC", name: "Walter C.", zone: "Comas", text: "Ahora los clientes llegan con su código y el proceso es limpio. Menos confusiones, más orden.", tag: "Dueño · Canchas El Bosque" },
  { init: "JF", name: "José F.", zone: "Villa El Salvador", text: "Registré mi complejo gratis y en 3 días ya tenía reservas online. Increíble.", tag: "Dueño · Sport Center VES" },
  { init: "JT", name: "Jhon T.", zone: "Cayma", text: "Mis canchas están llenas entre semana. Antes se quedaban vacías los martes y miércoles.", tag: "Dueño · Complejo Los Andes" },
  { init: "RV", name: "Roberto V.", zone: "José Luis Bustamante y Rivero", text: "El panel es muy fácil. Veo mis reservas del mes de un vistazo y gestiono todo desde el celular.", tag: "Dueño · Complejo San Martín" },
  { init: "HM", name: "Henry M.", zone: "Ate Vitarte", text: "Triplicamos las reservas en los primeros 2 meses. Sin gastar en publicidad.", tag: "Dueño · Los Cedros FC" },
];
---

<BaseLayout
  title="ReservaYa | Busca. Reserva. Juega."
  description="Reserva canchas en minutos en todo el Perú. Sin llamadas, sin WhatsApp. Pago con Yape, tarjeta y QR."
  announcement="⚽ Crea tu carné de jugador estilo FIFA y compártelo con tus causas"
>
  <!-- ============ HERO con carrusel de fondo ============ -->
  <section class="relative left-1/2 flex min-h-[94vh] w-screen -translate-x-1/2 items-center overflow-hidden bg-[#040705] text-white">
    <div id="hero-slides" class="absolute inset-0">
      <img src="https://images.unsplash.com/photo-1554068865-24cecd4e34b8?q=80&w=2000&auto=format&fit=crop" alt="Canchas deportivas desde el aire" class="hero-bg is-active absolute inset-0 h-full w-full object-cover opacity-100" loading="eager" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1574629810360-7efbbe195018?q=80&w=2000&auto=format&fit=crop'" />
      <img src="https://images.unsplash.com/photo-1508098682722-e99c43a406b2?q=80&w=2000&auto=format&fit=crop" alt="Estadio de fútbol de noche" class="hero-bg absolute inset-0 h-full w-full object-cover opacity-0" loading="lazy" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1554068865-24cecd4e34b8?q=80&w=2000&auto=format&fit=crop'" />
      <img src="https://images.unsplash.com/photo-1622163642998-1ea32b0bbc67?q=80&w=2000&auto=format&fit=crop" alt="Cancha de pádel" class="hero-bg absolute inset-0 h-full w-full object-cover opacity-0" loading="lazy" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1554068865-24cecd4e34b8?q=80&w=2000&auto=format&fit=crop'" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/50 to-black/10"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#040705] via-transparent to-black/50"></div>
    <div class="pointer-events-none absolute -left-40 top-1/3 h-[480px] w-[480px] rounded-full bg-[#22C55E]/15 blur-[140px]"></div>

    <div class="relative mx-auto w-full max-w-7xl px-4 py-20 md:px-8 md:py-24">
      <p class="flex items-center justify-end gap-1.5 text-xs text-white/50"><span aria-hidden="true">◉</span> @reservaya.pe</p>
      <span class="mt-3 inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-black/50 py-2 pl-3.5 pr-5 text-[11px] font-bold uppercase tracking-[0.16em] text-[#4ADE80] shadow-lg backdrop-blur-xl">
        <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#4ADE80] opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-[#4ADE80]"></span></span>
        Todo el Perú · Canchas disponibles ahora
      </span>
      <h1 class="text-shadow-hero mt-7 max-w-3xl font-black leading-[0.93] tracking-tight text-white [font-family:'Poppins','Inter',sans-serif] text-[clamp(3.8rem,10vw,8rem)]">
        Busca.<br />Reserva.<br /><span class="text-glow-green text-[#4ADE80]">Ya</span><span class="text-white">.</span>
      </h1>
      <p class="text-shadow-hero mt-6 max-w-md text-lg leading-relaxed text-white/80 md:text-xl">
        Reserva en minutos. Sin llamadas, sin WhatsApp.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href="/canchas" class="btn-press btn-shine group inline-flex items-center justify-center gap-2.5 rounded-2xl bg-[#22C55E] px-8 py-4 text-[15px] font-bold text-white shadow-[0_12px_40px_rgba(34,197,94,0.45)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#16A34A] hover:shadow-[0_18px_50px_rgba(34,197,94,0.55)]">
          Buscar canchas <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
        <a href="/duenos" class="inline-flex items-center justify-center gap-2.5 rounded-2xl border border-white/25 bg-white/[0.07] px-8 py-4 text-[15px] font-semibold text-white shadow-lg backdrop-blur-xl transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/[0.14]">
          <span aria-hidden="true" class="text-[#4ADE80]">◔</span> Soy dueño de cancha
        </a>
      </div>
      <div class="mt-11 grid max-w-2xl grid-cols-2 divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-black/40 shadow-2xl backdrop-blur-2xl sm:grid-cols-4 sm:divide-x">
        {[["Online","Reserva en 3 clics"],["Yape","Plin · Tarjeta"],["QR","Voucher de acceso"],["24/7","Disponible siempre"]].map(([t,d]) => (
          <div class="px-5 py-4">
            <p class="text-[15px] font-extrabold text-white">{t}</p>
            <p class="mt-0.5 text-[11px] text-white/55">{d}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 flex items-center gap-4">
        <div class="flex items-center gap-2" id="hero-dots" role="tablist" aria-label="Fondos destacados">
          {[0,1,2].map(i => <button type="button" data-hero-dot={i} aria-label={`Ver fondo ${i+1}`} class={`h-1.5 rounded-full transition-all duration-500 ${i===0?"w-9 bg-[#4ADE80]":"w-2 bg-white/30 hover:bg-white/70"}`}></button>)}
        </div>
        <div class="h-px w-16 overflow-hidden rounded-full bg-white/15"><div id="hero-progress" class="hero-progress h-full w-full bg-[#4ADE80]"></div></div>
        <span id="hero-counter" class="text-[11px] font-bold tracking-[0.2em] text-white/50">01 / 03</span>
      </div>
    </div>
    <div class="absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2.5" aria-hidden="true">
      <span class="text-[10px] font-bold uppercase tracking-[0.35em] text-white/45">Scroll</span>
      <span class="flex h-10 w-6 items-start justify-center overflow-hidden rounded-full border border-white/25 p-1.5"><span class="scroll-hint-dot block h-2 w-1 rounded-full bg-[#4ADE80]"></span></span>
    </div>
  </section>

  <!-- ============ CINTA DE DISTRITOS (carrusel infinito) ============ -->
  <div class="relative left-1/2 w-screen -translate-x-1/2 overflow-hidden border-y border-[#22C55E]/20 bg-[#060A08] py-2">
    <div class="flex w-max will-change-transform" id="cities-marquee" data-marquee data-speed="90" data-dir="1">
      {[...cities, ...cities].map((c, i) => (
        <span class={`mr-2 whitespace-nowrap px-5 py-2 text-sm font-black tracking-wider ${i%2===0 ? "bg-white text-black" : "bg-[#0B120D] text-[#4ADE80]"} rounded-[2px]`}>{c}</span>
      ))}
    </div>
  </div>

  <!-- ============ CÓMO FUNCIONA · Carrusel 01/03 ============ -->
  <section id="como-funciona" class="relative left-1/2 w-screen -translate-x-1/2 overflow-hidden bg-[#040705] text-white">
    <div class="pointer-events-none absolute inset-0 opacity-70" aria-hidden="true">
      <svg class="h-full w-full" viewBox="0 0 1440 600" fill="none" stroke="#22C55E" stroke-opacity="0.16" preserveAspectRatio="xMidYMid slice"><rect x="8" y="24" width="1424" height="552"/><line x1="720" y1="24" x2="720" y2="576"/><circle cx="720" cy="300" r="110"/><rect x="8" y="170" width="180" height="260"/><rect x="1252" y="170" width="180" height="260"/><rect x="8" y="230" width="70" height="140"/><rect x="1362" y="230" width="70" height="140"/><circle cx="240" cy="300" r="4" fill="#22C55E" stroke="none" stroke-opacity="0.5"/><circle cx="1200" cy="300" r="4" fill="#22C55E" stroke="none" stroke-opacity="0.5"/></svg>
    </div>
    <div id="how-giant" class="pointer-events-none absolute -bottom-10 right-0 select-none text-[22vw] font-black leading-none text-white/[0.04] md:text-[16rem]">01</div>

    <div class="relative mx-auto max-w-7xl px-4 py-14 md:px-8 md:py-20">
      <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-[0.2em]">
        <p class="text-[#4ADE80]" id="how-label">Busca · 01/03</p>
        <div class="flex items-center gap-2" id="how-dots" role="tablist" aria-label="Pasos">
          {[0,1,2].map(i => <button type="button" role="tab" data-how-dot={i} aria-label={`Ir al paso ${i+1}`} class={`h-1.5 rounded-full transition-all ${i===0?"w-6 bg-[#4ADE80]":"w-1.5 bg-white/25 hover:bg-white/60"}`}></button>)}
        </div>
      </div>

      <div class="mt-6 overflow-hidden" id="how-viewport">
        <div id="how-track" class="flex transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]">

          <!-- SLIDE 1: BUSCA -->
          <div class="w-full shrink-0 pr-1" role="tabpanel" aria-label="Paso 1 busca">
            <div class="grid items-center gap-10 lg:grid-cols-2">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#4ADE80]">Paso 01 · Busca</p>
                <h2 class="mt-4 text-4xl font-black leading-tight tracking-tight text-white md:text-6xl">Encuentra tu<br/>cancha ideal.</h2>
                <p class="mt-5 max-w-md leading-relaxed text-white/60">Filtra por distrito, formato (F5/F7/F11), superficie y precio. Mapa con canchas cerca tuyo en tiempo real.</p>
                <div class="mt-6 flex items-center gap-2 text-xs text-white/40">
                  <span class="h-1.5 w-6 rounded-full bg-[#4ADE80]"></span><span class="h-1.5 w-1.5 rounded-full bg-white/25"></span><span class="h-1.5 w-1.5 rounded-full bg-white/25"></span>
                  <span class="ml-2">Sigue scrolleando</span>
                </div>
                <div class="mt-6 flex gap-2">
                  <button type="button" data-how-prev class="rounded-xl border border-white/20 px-5 py-2.5 text-sm font-bold hover:bg-white/10">← Anterior</button>
                  <button type="button" data-how-next class="rounded-xl bg-[#22C55E] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#16A34A]">Siguiente →</button>
                </div>
              </div>
              <div class="rounded-2xl border border-white/10 bg-[#081009]/90 p-4 shadow-2xl">
                <div id="mini-map" class="relative h-72 overflow-hidden rounded-xl bg-[#060D08]" style="background-image:radial-gradient(rgba(74,222,128,0.18) 1px, transparent 1px);background-size:22px 22px;">
                  <div class="pointer-events-none absolute left-1/2 top-1/2 h-56 w-56 -translate-x-1/2 -translate-y-1/2 rounded-full" style="background:radial-gradient(circle, rgba(34,197,94,0.16), transparent 65%);" aria-hidden="true"></div>
                  {pins.map((p, i) => (
                    <button type="button" data-pin={p.name} data-fmt={p.fmt} class="map-pin group absolute -translate-x-1/2 -translate-y-1/2" style={`left:${p.x};top:${p.y}`}>
                      <span class="relative mx-auto block h-2.5 w-2.5">
                        <span class="sonar-ring" style={`animation-delay:${(i % 5) * 0.45}s`}></span>
                        <span class="sonar-ring" style={`animation-delay:${((i % 5) * 0.45 + 1.2).toFixed(2)}s`}></span>
                        <span class="relative block h-2.5 w-2.5 rounded-full bg-[#4ADE80] shadow-[0_0_14px_rgba(74,222,128,1)]"></span>
                      </span>
                      <span class="mt-1 block whitespace-nowrap rounded-lg border border-[#22C55E]/30 bg-black/80 px-2.5 py-1.5 text-left text-[11px] leading-tight backdrop-blur"><strong class="block text-white">{p.name}</strong><span class="text-[#4ADE80] font-bold">{p.price}</span></span>
                    </button>
                  ))}
                </div>
                <div class="mt-3 flex items-center gap-2 rounded-xl border border-white/10 bg-black px-3 py-2.5">
                  <span aria-hidden="true" class="text-[#4ADE80]">⌖</span>
                  <input id="map-search" type="text" placeholder="Buscar por distrito o cancha..." class="w-full bg-transparent text-sm text-white placeholder:text-white/35 focus:outline-none" />
                  <button type="button" data-fmt-filter="F5" class="fmt-btn rounded-md bg-[#22C55E]/20 px-2.5 py-1 text-[11px] font-bold text-[#4ADE80]">F5</button>
                  <button type="button" data-fmt-filter="F7" class="fmt-btn rounded-md bg-white/10 px-2.5 py-1 text-[11px] font-bold text-white/70">F7</button>
                </div>
                <p id="map-count" class="mt-2 text-xs text-white/45">5 canchas cerca de ti</p>
              </div>
            </div>
          </div>

          <!-- SLIDE 2: RESERVA -->
          <div class="w-full shrink-0 pr-1" role="tabpanel" aria-label="Paso 2 reserva">
            <div class="grid items-center gap-10 lg:grid-cols-2">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#4ADE80]">Paso 02 · Reserva</p>
                <h2 class="mt-4 text-4xl font-black leading-tight tracking-tight text-white md:text-6xl">Elige tu hora,<br/>confirma al<br/>instante.</h2>
                <p class="mt-5 max-w-md leading-relaxed text-white/60">Selecciona el slot disponible y reserva en segundos. Pago online con Yape o presencial en la cancha.</p>
                <div class="mt-6 flex items-center gap-2 text-xs text-white/40">
                  <span class="h-1.5 w-1.5 rounded-full bg-white/25"></span><span class="h-1.5 w-6 rounded-full bg-[#4ADE80]"></span><span class="h-1.5 w-1.5 rounded-full bg-white/25"></span>
                  <span class="ml-2">Sigue scrolleando</span>
                </div>
                <div class="mt-6 flex gap-2">
                  <button type="button" data-how-prev class="rounded-xl border border-white/20 px-5 py-2.5 text-sm font-bold hover:bg-white/10">← Anterior</button>
                  <button type="button" data-how-next class="rounded-xl bg-[#22C55E] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#16A34A]">Siguiente →</button>
                </div>
              </div>
              <div class="rounded-2xl border border-white/10 bg-[#0B100C]/95 p-6 shadow-2xl">
                <div class="flex items-start justify-between">
                  <div><p class="font-bold">Cancha Norte — F5</p><p class="text-xs text-white/45">◷ Sáb 14 Jun</p></div>
                  <p class="text-right text-xl font-black text-[#4ADE80]">S/ 80<small class="block text-xs font-normal text-white/45">/hora</small></p>
                </div>
                <div class="mt-5 grid grid-cols-3 gap-2.5" id="slot-grid" role="radiogroup" aria-label="Elige horario">
                  {slots.map((s,i) => (
                    <button type="button" role="radio" data-slot={s} aria-checked={i===2?"true":"false"} class={`slot-btn rounded-xl px-3 py-3 text-sm font-bold transition ${i===2?"bg-[#4ADE80] text-black shadow-[0_0_20px_rgba(74,222,128,0.4)]":"bg-white/[0.07] text-white hover:bg-white/[0.14]"} ${i===0||i===4?"opacity-40 line-through":""}`}>{s}</button>
                  ))}
                </div>
                <div class="mt-4 flex flex-wrap gap-2 text-[11px] text-white/50">
                  {["Grass sint.","Techada","Vestuarios","Estacionam."].map(t => <span class="rounded-md bg-white/5 px-2.5 py-1">{t}</span>)}
                </div>
                <div class="mt-5 border-t border-white/10 pt-4 text-sm">
                  <div class="flex justify-between text-white/60"><span id="book-summary">Sáb 14 Jun · 08:00 - 09:00</span><span class="font-bold text-white">S/ 80</span></div>
                  <p class="mt-1 text-xs text-white/40">Cancha Norte · F5 · San Isidro</p>
                </div>
                <button type="button" id="confirm-book" class="mt-4 w-full rounded-xl bg-[#22C55E] py-3.5 font-bold text-black transition hover:bg-[#4ADE80] hover:shadow-[0_8px_28px_rgba(74,222,128,0.45)]">Confirmar reserva · S/ 80</button>
                <p id="book-msg" class="mt-2 hidden text-center text-xs font-bold text-[#4ADE80]">¡Slot apartado! Te llevamos al paso 03…</p>
              </div>
            </div>
          </div>

          <!-- SLIDE 3: JUEGA -->
          <div class="w-full shrink-0" role="tabpanel" aria-label="Paso 3 juega">
            <div class="grid items-center gap-10 lg:grid-cols-2">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#4ADE80]">Paso 03 · Juega</p>
                <h2 class="mt-4 text-4xl font-black leading-tight tracking-tight text-white md:text-5xl">¡Llega, muestra tu código y juega!</h2>
                <p class="mt-5 max-w-md leading-relaxed text-white/60">Recibes un código único de reserva. Muéstralo al dueño al llegar y listo. Sin filas, sin llamadas.</p>
                <div class="mt-6 flex items-center gap-2 text-xs text-white/40">
                  <span class="h-1.5 w-1.5 rounded-full bg-white/25"></span><span class="h-1.5 w-1.5 rounded-full bg-white/25"></span><span class="h-1.5 w-6 rounded-full bg-[#4ADE80]"></span>
                  <span class="ml-2">Sigue scrolleando</span>
                </div>
                <div class="mt-6 flex gap-2">
                  <button type="button" data-how-prev class="rounded-xl border border-white/20 px-5 py-2.5 text-sm font-bold hover:bg-white/10">← Anterior</button>
                  <a href="/canchas" class="rounded-xl bg-[#22C55E] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#16A34A]">Reservar ahora →</a>
                </div>
              </div>
              <div class="rounded-2xl border border-white/10 bg-[#0B100C]/95 p-8 text-center shadow-2xl">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-[#22C55E]/50 bg-[#22C55E]/10 text-2xl text-[#4ADE80]">✓</div>
                <p class="mt-4 text-lg font-black">¡Reserva confirmada!</p>
                <p class="text-xs text-white/45">Cancha Norte · Sáb <span id="ticket-hour">8:00 AM</span></p>
                <div class="mx-auto mt-5 max-w-xs rounded-xl border border-[#22C55E]/30 bg-black/60 px-6 py-5">
                  <p class="text-[11px] uppercase tracking-[0.25em] text-[#4ADE80]">Tu código</p>
                  <p id="ticket-code" class="mt-2 text-2xl font-black tracking-[0.2em]">RY - 7KX9M2</p>
                  <p class="mt-2 text-[11px] text-white/40">Muéstralo al llegar a la cancha</p>
                </div>
                <div class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 rounded-xl bg-black/70 p-5 text-left text-xs">
                  <div><p class="text-white/40">Jugador</p><p class="font-bold text-white">Carlos M.</p></div>
                  <div><p class="text-white/40">Formato</p><p class="font-bold text-white">Fútbol 5</p></div>
                  <div><p class="text-white/40">Fecha</p><p class="font-bold text-white">Sáb 14 Jun</p></div>
                  <div><p class="text-white/40">Hora</p><p class="font-bold text-white" id="ticket-range">08:00 - 09:00</p></div>
                  <div><p class="text-white/40">Cancha</p><p class="font-bold text-white">Norte</p></div>
                  <div><p class="text-white/40">Total</p><p class="font-bold text-white">S/ 80</p></div>
                </div>
                <div class="mt-4 flex items-center justify-center gap-1 text-lg" id="stars" aria-label="Califica tu experiencia">
                  {[1,2,3,4,5].map(i => <button type="button" data-star={i} class="text-[#EAB308] transition hover:scale-125" aria-label={`${i} estrellas`}>★</button>)}
                  <span class="ml-2 text-xs text-white/40">Califica tu experiencia</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============ FUNCIONALIDADES ============ -->
