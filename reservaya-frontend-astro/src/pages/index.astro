---
import BaseLayout from "../layouts/BaseLayout.astro";
import SlotBoard from "../components/ui/SlotBoard.astro";
import PatronCancha from "../components/ui/PatronCancha.astro";
import CintaPitazo from "../components/CintaPitazo.astro";
import Select from "../components/ui/Select.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import SeccionTitulo from "../components/inicio/SeccionTitulo.astro";
import FilaFuncion from "../components/inicio/FilaFuncion.astro";
import MaquetaPartido from "../components/inicio/MaquetaPartido.astro";
import MaquetaEquipos from "../components/inicio/MaquetaEquipos.astro";
import MaquetaTorneo from "../components/inicio/MaquetaTorneo.astro";
import PreguntasTactiles from "../components/inicio/PreguntasTactiles.astro";
import BandaCierre from "../components/inicio/BandaCierre.astro";
import { DISTRITOS, TIPOS } from "../lib/arequipa";
import { BOTON } from "../lib/estilos";
import { PREGUNTAS_JUGADOR } from "../lib/preguntas";

const distritos = [{ valor: "", etiqueta: "Todo Arequipa" }, ...DISTRITOS.map((d) => ({ valor: d, etiqueta: d }))];
const distritosTop = [
  "Arequipa", "Cayma", "Cerro Colorado", "Yanahuara",
  "José Luis Bustamante y Rivero", "Paucarpata", "Miraflores", "Sachaca"
];
const tipos = [{ valor: "", etiqueta: "Todo deporte" }, ...TIPOS];
const dias = [{ valor: "hoy", etiqueta: "Hoy" }, { valor: "manana", etiqueta: "Mañana" }];
const tintasDeporte: Record<string, { tarjeta: string; franja: string }> = {
  FUTBOL: { tarjeta: "bg-cesped-suave", franja: "bg-cesped" },
  FUTBOL5: { tarjeta: "bg-cesped-suave", franja: "bg-cesped" },
  FUTBOL7: { tarjeta: "bg-cesped-suave", franja: "bg-cesped" },
  VOLLEYBALL: { tarjeta: "bg-mar-suave", franja: "bg-mar" },
  BASQUET: { tarjeta: "bg-miel-suave", franja: "bg-miel" },
  PADEL: { tarjeta: "bg-lima-suave", franja: "bg-lima" },
  TENIS: { tarjeta: "bg-arcilla-suave", franja: "bg-arcilla" },
  LOZA: { tarjeta: "bg-losa-suave", franja: "bg-losa" },
};

const pasos = [
  { titulo: "Busca", texto: "Elige distrito, deporte y hora. Solo ves canchas libres, con su precio." },
  { titulo: "Reserva", texto: "Envía la reserva desde tu cuenta. El complejo la confirma en su panel." },
  { titulo: "Juega", texto: "Con la reserva confirmada tienes un código. Lo muestras al llegar y entras a jugar." },
];

const introSecciones = {
  comoFunciona: "Tres pasos: busca la cancha que te falta, envía la reserva y ve el código cuando te confirman. Así entras a jugar.",
  deportes: "Fútbol, básquet, vóley, pádel, tenis y más. Cada deporte tiene sus canchas libres en los 29 distritos.",
  distritos: "29 distritos: Arequipa, Cayma, Cerro Colorado, Yanahuara, José Luis Bustamante y Rivero, Paucarpata y más. Busca por tu zona.",
  extras: "Después de reservar: completa cuadro si falta alguien, sortea equipos sin discusiones o mira torneos en tu complejo.",
  preguntas: "Respuestas directas sobre cómo reservar, qué pasa si queda pendiente, cuándo te confirman, cómo entras y más.",
};

// Puntos tomados del copy verificado de la spec 45 (textos de extras).
const extras = [
  { href: "/completar-cuadro", titulo: "Te faltan jugadores", texto: "Publica tu partido o súmate a uno abierto en tu distrito.", accion: "Ver partidos abiertos", tinta: "bg-cesped-suave", Maqueta: MaquetaPartido, puntos: ["Publica tu partido para buscar jugadores", "Súmate a uno abierto en tu distrito"] },
  { href: "/sortear", titulo: "Arma equipos parejos", texto: "Escribe los nombres y reparte los equipos al azar, sin discusiones.", accion: "Armar equipos", tinta: "bg-cielo", Maqueta: MaquetaEquipos, puntos: ["Reparte los equipos al azar", "Funciona sin cuenta"] },
  { href: "/torneos", titulo: "Torneos en complejos", texto: "Los complejos organizan sus torneos con inscripciones, partidos y resultados.", accion: "Ver torneos", tinta: "bg-miel-suave", Maqueta: MaquetaTorneo, puntos: ["Inscripciones, partidos y resultados", "Organizados por cada complejo"] },
];

---

<BaseLayout
  title="ReservaYa | Canchas libres en Arequipa"
  description="Mira qué canchas de fútbol, vóley, básquet, pádel y tenis están libres hoy en Arequipa y resérvalas en un minuto."
>
  <!-- Héroe centrado como el de Universo (spec 49): titular grande, buscador ancho y tablero debajo. -->
  <section class="relative overflow-hidden bg-noche">
    <PatronCancha variante="centro" />
    <div class="relative z-10 mx-auto max-w-5xl px-4 pb-14 pt-12 md:px-6 lg:pb-20 lg:pt-20">
      <div class="hero-entra mx-auto max-w-3xl text-center">
        <h1 class="text-4xl text-tiza sm:text-5xl md:text-6xl lg:text-7xl">Canchas libres en Arequipa</h1>
        <p class="mx-auto mt-4 max-w-xl text-lg text-tiza/75 md:text-xl">Elige la hora, mira el precio y reserva en un minuto.</p>
      </div>

      <form action="/canchas" method="get" class="card-tactil mx-auto mt-10 grid max-w-4xl grid-cols-1 gap-3 p-4 shadow-dura-cesped sm:grid-cols-2 lg:grid-cols-[repeat(3,minmax(0,1fr))_auto] lg:items-end lg:p-5" role="search" aria-label="Buscar canchas">
        <Select id="buscar-distrito" name="distrito" etiqueta="Distrito" opciones={distritos} />
        <Select id="buscar-tipo" name="tipo" etiqueta="Deporte" opciones={tipos} />
        <Select id="buscar-dia" name="fecha" etiqueta="Día" opciones={dias} />
        <input id="buscar-hora" type="hidden" name="hora" value="" />
        <Button type="submit" class="w-full lg:w-auto lg:px-8">Buscar canchas</Button>
      </form>

      <div class="mx-auto mt-8 max-w-4xl">
        <SlotBoard />
      </div>
    </div>
    <div
      class="h-3 w-full border-t-2 border-basalto"
      style="background-image: repeating-linear-gradient(45deg, var(--color-cesped) 0 0.875rem, var(--color-cesped-hondo) 0.875rem 1.75rem);"
      aria-hidden="true"
    ></div>
  </section>

  <CintaPitazo />

  <style>
    @media (prefers-reduced-motion: no-preference) {
      .hero-entra {
        animation: hero-entra var(--dur-resorte) var(--ease-resorte) both;
      }
    }
    @keyframes hero-entra {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <section id="como-funciona" aria-labelledby="como-titulo" class="border-y-2 border-basalto bg-tiza">
    <div class="revelar mx-auto max-w-page px-4 py-16 md:px-6 lg:py-24">
      <SeccionTitulo id="como-titulo" antetitulo="Así de simple" titulo="Cómo funciona" bajada={introSecciones.comoFunciona} />
      <ol class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-3 lg:mt-12">
        {pasos.map((p, i) => (
          <li class="card-tactil p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-basalto bg-cesped-suave font-display text-2xl font-extrabold tabular-nums text-cesped-hondo">{i + 1}</span>
            <h3 class="mt-4 text-xl font-bold">{p.titulo}</h3>
            <p class="mt-2 text-pizarra">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="deportes-titulo" class="revelar mx-auto max-w-page px-4 py-16 md:px-6 lg:py-24">
    <SeccionTitulo id="deportes-titulo" antetitulo="Deportes" titulo="Todos los deportes" bajada={introSecciones.deportes} />
    <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:mt-12">
      {TIPOS.map((t) => (
        <a
          href={`/canchas?tipo=${t.valor}`}
          data-deporte={t.valor}
          class={`card-tactil group relative flex min-h-28 flex-col justify-between overflow-hidden p-4 text-basalto shadow-dura-sm transition-transform hover:-translate-y-0.5 hover:shadow-dura motion-reduce:hover:translate-y-0 ${tintasDeporte[t.valor].tarjeta}`}
        >
          <span class={`absolute inset-x-0 top-0 h-2 ${tintasDeporte[t.valor].franja}`} aria-hidden="true"></span>
          <div class="flex items-center justify-between">
            <span class="eyebrow text-basalto">Canchas</span>
            <Icon nombre="flecha" class="h-4 w-4 transition-transform group-hover:translate-x-1 motion-reduce:group-hover:translate-x-0" />
          </div>
          <span class="mt-3 font-display text-lg font-black text-basalto">{t.etiqueta}</span>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="distritos-titulo" class="border-y-2 border-basalto bg-cielo">
    <div class="revelar mx-auto max-w-page px-4 py-16 md:px-6 lg:py-24">
      <SeccionTitulo id="distritos-titulo" antetitulo="Tu zona" titulo="Distritos de Arequipa" bajada={introSecciones.distritos} />
      <ul class="mt-10 flex flex-wrap justify-center gap-2.5">
        {distritosTop.map((d) => (
          <li><a href={`/canchas?distrito=${encodeURIComponent(d)}`} class="chip-tactil">{d}</a></li>
        ))}
      </ul>
      <div class="mt-8 flex justify-center">
        <a href="/canchas" class={BOTON.secundario}>Ver los {DISTRITOS.length} distritos <Icon nombre="flecha" class="h-4 w-4" /></a>
      </div>
    </div>
  </section>

  <section aria-labelledby="extras-titulo" class="revelar mx-auto max-w-page px-4 py-16 md:px-6 lg:py-24">
    <SeccionTitulo id="extras-titulo" antetitulo="Después de reservar" titulo="Para el resto del partido" bajada={introSecciones.extras} />
    <div class="mt-12 space-y-16 lg:mt-16 lg:space-y-24">
      {extras.map(({ Maqueta, ...e }, i) => (
        <FilaFuncion {...e} invertir={i % 2 === 1}><Maqueta /></FilaFuncion>
      ))}
    </div>
  </section>

  <section aria-labelledby="preguntas-titulo" class="border-t-2 border-basalto bg-tiza">
    <div class="revelar mx-auto max-w-page px-4 py-16 md:px-6 lg:py-24">
      <SeccionTitulo id="preguntas-titulo" antetitulo="Ayuda" titulo="Preguntas frecuentes" bajada={introSecciones.preguntas} />
      <PreguntasTactiles preguntas={PREGUNTAS_JUGADOR} />
    </div>
  </section>

  <BandaCierre
    id="duenos-titulo"
    antetitulo="Para dueños"
    titulo="¿Tienes canchas en Arequipa?"
    bajada="Publica tus horarios y recibe reservas sin contestar llamadas. Gestiona agenda, precios, caja y trabajadores desde un solo panel en el navegador; las confirmas cuando quieras."
    primario={{ href: "/duenos", texto: "Publicar mis canchas" }}
    secundario={{ href: "/duenos#planes", texto: "Ver planes" }}
  />
</BaseLayout>
