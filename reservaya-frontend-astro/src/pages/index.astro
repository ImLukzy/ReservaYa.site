<style is:global>
  .marquee { animation: scrollX 28s linear infinite; }
  .marquee-right { animation: scrollXR 34s linear infinite; }
  .marquee:hover { animation-play-state: paused; }
  @keyframes scrollX { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes scrollXR { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  .hero-bg { transition: opacity 1.2s ease; }
  .map-pin { transition: transform .2s ease, opacity .25s ease; }
  .map-pin:hover { transform: translate(-50%,-50%) scale(1.08); }
  .map-pin.is-hidden { display: none; }
  .sonar-ring {
    position: absolute; inset: 0; border-radius: 9999px;
    border: 2px solid rgba(74,222,128,.75);
    animation: sonar 2.4s ease-out infinite;
    pointer-events: none;
  }
  @keyframes sonar {
    0% { transform: scale(.5); opacity: .9; }
    100% { transform: scale(3.2); opacity: 0; }
  }
  #how-track > div { min-height: 100%; }
  @media (prefers-reduced-motion: reduce) {
    .marquee, .marquee-right { animation: none; }
    #how-track { transition: none; }
  }
</style>

<script>
  // ---------- Marquesinas infinitas (motor JS: movimiento garantizado y suave) ----------
  // Un solo mecanismo (rAF + translate3d): no depende de keyframes CSS,
  // velocidad constante en px/s, pausa al hover, loop perfecto.
  document.querySelectorAll("[data-marquee]").forEach((track) => {
    const speed = parseFloat(track.dataset.speed || "90");
    const dir = track.dataset.dir === "-1" ? -1 : 1;
    let x = 0, half = 0, calibrated = false, paused = false;
    const measure = () => {
      half = track.scrollWidth / 2;
      if (dir === -1 && !calibrated && half > 0) { x = -half; calibrated = true; }
    };
    measure();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
    window.addEventListener("load", measure);
    window.addEventListener("resize", measure);
    const host = track.parentElement;
    if (track.dataset.hover !== "never") {
      host?.addEventListener("mouseenter", () => { paused = true; });
      host?.addEventListener("mouseleave", () => { paused = false; });
    }
    let last = performance.now();
    const step = (now) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      if (!paused && !document.hidden && half > 0) {
        x -= dir * speed * dt;
        if (dir === 1 && -x >= half) x += half;
        if (dir === -1 && x >= 0) x -= half;
        track.style.transform = `translate3d(${x}px,0,0)`;
      }
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  });

  // ---------- Announcement rotativo ----------
  const announcements = [
    "⚽ Crea tu carné de jugador estilo FIFA y compártelo con tus causas",
    "✦ Arma equipos parejos — ¿nadie quiere elegir? Sórtealos gratis",
    "▶ ReservaYa ya está en Google Play — Descarga la app gratis",
    "📸 Ayúdanos a crecer — Síguenos en Instagram @reservaya.pe",
  ];
  let annIdx = 0;
  const annBar = document.getElementById("announcement-bar");
  const annText = (() => {
    const span = annBar?.querySelector("span.mx-auto");
    if (!span) return null;
    // Nodo de texto real (ignora espacios y el pill "Nuevo")
    for (const node of Array.from(span.childNodes)) {
      if (node.nodeType === Node.TEXT_NODE && node.textContent && node.textContent.trim().length > 0) return node as Text;
    }
    return null;
  })();
  setInterval(() => {
    if (!annText || document.hidden) return;
    annIdx = (annIdx + 1) % announcements.length;
    annText.textContent = announcements[annIdx] + " ";
  }, 5000);

  // ---------- Hero carrusel ----------
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const heroImgs = Array.from(document.querySelectorAll(".hero-bg"));
  const heroDots = Array.from(document.querySelectorAll("[data-hero-dot]"));
  const heroSection = heroImgs[0]?.closest("section");
  let heroIdx = 0, heroTimer;
  const heroCounter = document.getElementById("hero-counter");
  const heroProgress = document.getElementById("hero-progress");
  const showHero = (i) => {
    heroIdx = (i + heroImgs.length) % heroImgs.length;
    heroImgs.forEach((img, k) => {
      const on = k === heroIdx;
      img.classList.toggle("opacity-100", on);
      img.classList.toggle("opacity-0", !on);
      img.classList.toggle("is-active", on);
      if (on && !reduceMotion) { img.style.animation = "none"; void img.offsetWidth; img.style.animation = ""; }
    });
    heroDots.forEach((d, k) => {
      d.className = `h-1.5 rounded-full transition-all duration-500 ${k === heroIdx ? "w-9 bg-[#4ADE80]" : "w-2 bg-white/30 hover:bg-white/70"}`;
    });
    if (heroCounter) heroCounter.textContent = `0${heroIdx + 1} / 0${heroImgs.length}`;
    if (heroProgress && !reduceMotion) { heroProgress.classList.remove("hero-progress"); void heroProgress.offsetWidth; heroProgress.classList.add("hero-progress"); }
  };
  const autoHero = () => { clearInterval(heroTimer); if (reduceMotion) return; heroTimer = setInterval(() => showHero(heroIdx + 1), 6000); };
  heroDots.forEach(d => d.addEventListener("click", () => { showHero(parseInt(d.dataset.heroDot || "0", 10)); autoHero(); }));
  heroSection?.addEventListener("mouseenter", () => clearInterval(heroTimer));
  heroSection?.addEventListener("mouseleave", autoHero);
  autoHero();

  // ---------- Cómo funciona: carrusel 01-03 ----------
  const track = document.getElementById("how-track");
  const dots = Array.from(document.querySelectorAll("[data-how-dot]"));
  const label = document.getElementById("how-label");
  const giant = document.getElementById("how-giant");
  const names = ["Busca · 01/03", "Reserva · 02/03", "Juega · 03/03"];
  let howIdx = 0, howTimer;
  const showHow = (i) => {
    howIdx = (i + 3) % 3;
    if (track) track.style.transform = `translateX(-${howIdx * 100}%)`;
    dots.forEach((d, k) => {
      d.className = `h-1.5 rounded-full transition-all ${k === howIdx ? "w-6 bg-[#4ADE80]" : "w-1.5 bg-white/25 hover:bg-white/60"}`;
      d.setAttribute("aria-selected", String(k === howIdx));
    });
    if (label) label.textContent = names[howIdx];
    if (giant) giant.textContent = `0${howIdx + 1}`;
  };
  const autoHow = () => { clearInterval(howTimer); if (reduceMotion) return; howTimer = setInterval(() => { if (!document.hidden) showHow(howIdx + 1); }, 7000); };
  dots.forEach(d => d.addEventListener("click", () => { showHow(parseInt(d.dataset.howDot || "0", 10)); autoHow(); }));
  document.querySelectorAll("[data-how-next]").forEach(b => b.addEventListener("click", () => { showHow(howIdx + 1); autoHow(); }));
  document.querySelectorAll("[data-how-prev]").forEach(b => b.addEventListener("click", () => { showHow(howIdx - 1); autoHow(); }));
  // swipe
  const viewport = document.getElementById("how-viewport");
  let sx = null;
  viewport?.addEventListener("touchstart", e => { sx = e.touches[0].clientX; }, { passive: true });
  viewport?.addEventListener("touchend", e => {
    if (sx === null) return;
    const dx = e.changedTouches[0].clientX - sx;
    if (Math.abs(dx) > 45) { showHow(howIdx + (dx < 0 ? 1 : -1)); autoHow(); }
    sx = null;
  }, { passive: true });
  // pausa al interactuar
  document.getElementById("como-funciona")?.addEventListener("mouseenter", () => clearInterval(howTimer));
  document.getElementById("como-funciona")?.addEventListener("mouseleave", autoHow);
  autoHow();

  // ---------- Mini mapa: buscador + filtro formato ----------
  const search = document.getElementById("map-search");
  const count = document.getElementById("map-count");
  const pinsEls = Array.from(document.querySelectorAll(".map-pin"));
  let fmtFilter = null;
  const applyMap = () => {
    const q = (search?.value || "").toLowerCase().trim();
    let visible = 0;
    pinsEls.forEach(p => {
      const name = (p.dataset.pin || "").toLowerCase();
      const okQ = !q || name.includes(q);
      const okF = !fmtFilter || p.dataset.fmt === fmtFilter;
      const show = okQ && okF;
      p.classList.toggle("is-hidden", !show);
      if (show) visible++;
    });
    if (count) count.textContent = `${visible} cancha${visible === 1 ? "" : "s"} cerca de ti`;
  };
  search?.addEventListener("input", applyMap);
  document.querySelectorAll(".fmt-btn").forEach(b => b.addEventListener("click", () => {
    const f = b.dataset.fmtFilter;
    fmtFilter = fmtFilter === f ? null : f;
    document.querySelectorAll(".fmt-btn").forEach(x => {
      const active = x.dataset.fmtFilter === fmtFilter;
      x.className = `fmt-btn rounded-md px-2.5 py-1 text-[11px] font-bold ${active ? "bg-[#22C55E]/30 text-[#4ADE80]" : "bg-white/10 text-white/70"}`;
    });
    applyMap();
  }));
  pinsEls.forEach(p => p.addEventListener("click", () => {
    if (search) { search.value = p.dataset.pin || ""; applyMap(); }
  }));

  // ---------- Reserva: slots + confirmación ----------
  let slot = "08:00";
  const slotBtns = Array.from(document.querySelectorAll(".slot-btn"));
  const summary = document.getElementById("book-summary");
  const ticketRange = document.getElementById("ticket-range");
  const ticketHour = document.getElementById("ticket-hour");
  const ticketCode = document.getElementById("ticket-code");
  const bookMsg = document.getElementById("book-msg");
  const fmtHour = (h) => {
    const [hh, mm] = h.split(":").map(Number);
    const end = hh + 1;
    return { range: `${h} - ${String(end).padStart(2, "0")}:00`, ampm: `${hh > 12 ? hh - 12 : hh}:${String(mm).padStart(2, "0")} ${hh >= 12 ? "PM" : "AM"}` };
  };
  slotBtns.forEach(b => b.addEventListener("click", () => {
    if (b.classList.contains("line-through")) return;
    slot = b.dataset.slot || slot;
    slotBtns.forEach(x => {
      const active = x === b;
      x.className = `slot-btn rounded-xl px-3 py-3 text-sm font-bold transition ${active ? "bg-[#4ADE80] text-black shadow-[0_0_20px_rgba(74,222,128,0.4)]" : "bg-white/[0.07] text-white hover:bg-white/[0.14]"}`;
      x.setAttribute("aria-checked", String(active));
    });
    const f = fmtHour(slot);
    if (summary) summary.textContent = `Sáb 14 Jun · ${f.range}`;
    if (ticketRange) ticketRange.textContent = f.range;
    if (ticketHour) ticketHour.textContent = f.ampm;
  }));
  document.getElementById("confirm-book")?.addEventListener("click", () => {
    const code = "RY - " + Array.from({ length: 6 }, () => "ABCDEFGHJKMNPQRSTUVWXYZ23456789"[Math.floor(Math.random() * 32)]).join("");
    if (ticketCode) ticketCode.textContent = code;
    if (bookMsg) bookMsg.classList.remove("hidden");
    setTimeout(() => showHow(2), 900);
  });

  // ---------- Estrellas ----------
  document.querySelectorAll("#stars [data-star]").forEach(s => s.addEventListener("click", () => {
    const v = parseInt(s.dataset.star || "5", 10);
    document.querySelectorAll("#stars [data-star]").forEach(x => {
      x.style.opacity = parseInt(x.dataset.star || "0", 10) <= v ? "1" : "0.3";
    });
  }));

  // ---------- Contadores dueños ----------
  const counters = document.querySelectorAll("[data-count]");
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target;
      const target = parseInt(el.dataset.count || "0", 10);
      const suffix = el.dataset.suffix || "";
      const t0 = performance.now();
      const tick = (t) => {
        const p = Math.min(1, (t - t0) / 1200);
        el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      io.unobserve(el);
    });
  }, { threshold: 0.5 });
  counters.forEach(c => io.observe(c));

  // ---------- Reservas en vivo: rotación ----------
  const live = document.getElementById("live-books");
  setInterval(() => {
    if (!live || document.hidden) return;
    const first = live.firstElementChild;
    if (first) { live.appendChild(first); }
  }, 3500);
</script>
