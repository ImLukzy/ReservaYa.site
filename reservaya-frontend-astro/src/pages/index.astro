---
import BaseLayout from "../layouts/BaseLayout.astro";
import SlotBoard from "../components/ui/SlotBoard.astro";
import PatronCancha from "../components/ui/PatronCancha.astro";
import CintaPitazo from "../components/CintaPitazo.astro";
import CroquisCancha from "../components/ui/CroquisCancha.astro";
import Select from "../components/ui/Select.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import { DISTRITOS, TIPOS } from "../lib/arequipa";
import { BOTON } from "../lib/estilos";

const distritos = [{ valor: "", etiqueta: "Todo Arequipa" }, ...DISTRITOS.map((d) => ({ valor: d, etiqueta: d }))];
const distritosTop = [
  "Arequipa", "Cayma", "Cerro Colorado", "Yanahuara",
  "José Luis Bustamante y Rivero", "Paucarpata", "Miraflores", "Sachaca"
];
const tipos = [{ valor: "", etiqueta: "Todo deporte" }, ...TIPOS];
const dias = [{ valor: "hoy", etiqueta: "Hoy" }, { valor: "manana", etiqueta: "Mañana" }];
const tintasDeporte: Record<string, { tarjeta: string; franja: string }> = {
  FUTBOL: { tarjeta: "bg-cesped-suave", franja: "bg-cesped" },
  FUTBOL5: { tarjeta: "bg-cesped-suave", franja: "bg-cesped" },
  FUTBOL7: { tarjeta: "bg-cesped-suave", franja: "bg-cesped" },
  VOLLEYBALL: { tarjeta: "bg-mar-suave", franja: "bg-mar" },
  BASQUET: { tarjeta: "bg-miel-suave", franja: "bg-miel" },
  PADEL: { tarjeta: "bg-lima-suave", franja: "bg-lima" },
  TENIS: { tarjeta: "bg-arcilla-suave", franja: "bg-arcilla" },
  LOZA: { tarjeta: "bg-losa-suave", franja: "bg-losa" },
};

const pasos = [
  { titulo: "Busca", texto: "Elige distrito, deporte y hora. Solo ves canchas libres, con su precio." },
  { titulo: "Reserva", texto: "Envía la reserva desde tu cuenta. El complejo la confirma en su panel." },
  { titulo: "Juega", texto: "Con la reserva confirmada tienes un código. Lo muestras al llegar y entras a jugar." },
];

const introSecciones = {
  comoFunciona: "Tres pasos: busca la cancha que te falta, envía la reserva y ve el código cuando te confirman. Así entras a jugar.",
  deportes: "Fútbol, básquet, vóley, pádel, tenis y más. Cada deporte tiene sus canchas libres en los 29 distritos.",
  distritos: "29 distritos: Arequipa, Cayma, Cerro Colorado, Yanahuara, José Luis Bustamante y Rivero, Paucarpata y más. Busca por tu zona.",
  extras: "Después de reservar: completa cuadro si falta alguien, sortea equipos sin discusiones o mira torneos en tu complejo.",
  preguntas: "Respuestas directas sobre cómo reservar, qué pasa si queda pendiente, cuándo te confirman, cómo entras y más.",
};

const extras = [
  { href: "/completar-cuadro", titulo: "Te faltan jugadores", texto: "Publica tu partido o súmate a uno abierto en tu distrito.", accion: "Ver partidos abiertos" },
  { href: "/sortear", titulo: "Arma equipos parejos", texto: "Escribe los nombres y reparte los equipos al azar, sin discusiones.", accion: "Armar equipos" },
  { href: "/torneos", titulo: "Torneos en complejos", texto: "Los complejos organizan sus torneos con inscripciones, partidos y resultados.", accion: "Ver torneos" },
];

const preguntas = [
  ["¿Necesito cuenta?", "Sí, necesitas una cuenta para enviar una reserva y revisar su estado. Primero buscas por distrito, deporte y día; después eliges una cancha disponible e inicias sesión para continuar. Cuando el complejo confirma, encuentras el código de la reserva en Mi partido. La herramienta para sortear equipos sí se puede usar sin cuenta."],
  ["¿Puedo reservar para otro día?", "Puedes buscar una cancha para hoy o para mañana. En el buscador seleccionas el distrito, el deporte y uno de esos dos días; en los resultados eliges la hora disponible que te convenga. Después envías la solicitud de reserva y el complejo decide si la confirma. La disponibilidad depende de los horarios publicados por cada complejo."],
  ["¿Qué es el código de reserva?", "Es el código que identifica una reserva confirmada. Envías la solicitud, esperas la confirmación del complejo y luego abres Mi partido para verlo. Al llegar, muestras ese código en la cancha como referencia de tu reserva. Mientras la solicitud siga pendiente, todavía no aparece un código confirmado."],
  ["¿Qué pasa si mi reserva queda pendiente?", "Significa que el complejo todavía debe aceptar o rechazar tu solicitud. Después de elegir la cancha y enviar la reserva, puedes revisar su estado en Mi partido. Si el complejo la confirma, allí verás el código que presentarás al llegar. La decisión y el momento de la confirmación dependen del complejo."],
  ["¿Necesito pagar en la página?", "No, ReservaYa no te pide pagar la reserva en esta página. Primero buscas una hora, envías la solicitud y esperas que el complejo la confirme. El pago se coordina directamente con el complejo, porque cada uno define cómo cobra. Revisa los datos de tu reserva y consulta al complejo si necesitas conocer sus condiciones."],
  ["¿En qué distritos hay canchas?", "El buscador incluye los 29 distritos de Arequipa. Abre el campo Distrito, elige uno y combina ese filtro con el deporte y el día que buscas. Después verás las canchas que coinciden con tu selección y sus horas disponibles. La lista puede variar según los complejos que estén publicados."],
  ["¿Cómo encuentro una cancha libre?", "Usa el buscador de la portada para filtrar las opciones disponibles. Elige distrito, deporte y día, pulsa Buscar canchas y revisa los resultados con sus horas y precios publicados. Desde una opción disponible puedes continuar con la solicitud de reserva. El resultado depende de la información y los horarios que haya cargado cada complejo."],
  ["¿Qué hago si me faltan jugadores?", "Puedes revisar los partidos abiertos o publicar el tuyo para buscar jugadores. Entra a la sección de partidos, mira las convocatorias disponibles y abre la que te interese; si ninguna encaja, crea una con los datos de tu partido. Después otros jugadores pueden encontrar esa publicación. La organización final la coordinan quienes participan."],
];
---

<BaseLayout
  title="ReservaYa | Canchas libres en Arequipa"
  description="Mira qué canchas de fútbol, vóley, básquet, pádel y tenis están libres hoy en Arequipa y resérvalas en un minuto."
>
  <section class="relative overflow-hidden bg-noche">
    <PatronCancha />
    <div class="relative z-10 mx-auto grid max-w-page gap-8 px-4 pb-14 pt-8 md:px-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-start lg:gap-8 xl:gap-12 lg:pb-20 lg:pt-12">
      <div class="hero-entra">
        <h1 class="text-4xl text-tiza md:text-5xl lg:text-6xl">Canchas libres en Arequipa</h1>
        <p class="mt-3 max-w-md text-lg text-tiza/75">Elige la hora, mira el precio y reserva en un minuto.</p>

        <form action="/canchas" method="get" class="card-tactil mt-6 grid grid-cols-1 gap-3 p-4 shadow-dura sm:grid-cols-2 lg:grid-cols-1 lg:p-5" role="search" aria-label="Buscar canchas">
          <Select id="buscar-distrito" name="distrito" etiqueta="Distrito" opciones={distritos} />
          <Select id="buscar-tipo" name="tipo" etiqueta="Deporte" opciones={tipos} />
          <Select id="buscar-dia" name="fecha" etiqueta="Día" opciones={dias} />
          <input id="buscar-hora" type="hidden" name="hora" value="" />
          <Button type="submit" class="lg:mt-1">Buscar canchas</Button>
        </form>
      </div>

      <SlotBoard />
    </div>
    <div
      class="h-3 w-full border-t-2 border-basalto"
      style="background-image: repeating-linear-gradient(45deg, var(--color-cesped) 0 0.875rem, var(--color-cesped-hondo) 0.875rem 1.75rem);"
      aria-hidden="true"
    ></div>
  </section>

  <CintaPitazo />

  <style>
    @media (prefers-reduced-motion: no-preference) {
      .hero-entra {
        animation: hero-entra 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
    }
    @keyframes hero-entra {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <section id="como-funciona" aria-labelledby="como-titulo" class="border-y-2 border-basalto bg-tiza seccion-entra">
    <div class="mx-auto max-w-page px-4 py-12 md:px-6 lg:py-16">
      <h2 id="como-titulo" class="text-2xl font-bold lg:text-3xl">Cómo funciona</h2>
      <p class="mt-3 max-w-2xl text-base text-pizarra">{introSecciones.comoFunciona}</p>
      <div class="mt-6 grid gap-6 lg:grid-cols-2 lg:gap-10">
        <div class="card-tactil flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:gap-6">
          <CroquisCancha class="h-20 w-20 shrink-0 sm:h-24 sm:w-24" />
          <div>
            <p class="font-display text-3xl font-extrabold tabular-nums tracking-tight text-cesped-hondo">1</p>
            <h3 class="mt-1 text-xl font-bold">{pasos[0].titulo}</h3>
            <p class="mt-1 text-pizarra">{pasos[0].texto}</p>
          </div>
        </div>
        <ol class="border-l-2 border-cal pl-6">
          {pasos.slice(1).map((p, i) => (
            <li class="relative border-b border-cal py-4 last:border-b-0 last:pb-0">
              <span class="absolute -left-[1.9rem] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-basalto bg-cesped"></span>
              <p class="font-display text-2xl font-extrabold tabular-nums tracking-tight text-cesped-hondo">{i + 2}</p>
              <h3 class="mt-1 text-lg font-bold">{p.titulo}</h3>
              <p class="mt-1 text-pizarra">{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section aria-labelledby="deportes-titulo" class="mx-auto max-w-page px-4 py-12 md:px-6 lg:py-16 seccion-entra">
    <h2 id="deportes-titulo" class="font-display text-2xl font-black text-basalto lg:text-3xl">Todos los deportes</h2>
    <p class="mt-3 max-w-2xl text-base text-pizarra">{introSecciones.deportes}</p>

    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {TIPOS.map((t) => (
        <a
          href={`/canchas?tipo=${t.valor}`}
          data-deporte={t.valor}
          class={`card-tactil group relative flex min-h-28 flex-col justify-between overflow-hidden p-4 text-basalto shadow-dura-sm transition-transform hover:-translate-y-0.5 hover:shadow-dura motion-reduce:hover:translate-y-0 ${tintasDeporte[t.valor].tarjeta}`}
        >
          <span class={`absolute inset-x-0 top-0 h-2 ${tintasDeporte[t.valor].franja}`} aria-hidden="true"></span>
          <div class="flex items-center justify-between">
            <span class="font-display text-[0.6875rem] font-bold uppercase tracking-wider">Canchas</span>
            <span aria-hidden="true" class="text-sm transition-transform group-hover:translate-x-1 motion-reduce:group-hover:translate-x-0">→</span>
          </div>
          <span class="mt-3 font-display text-lg font-black text-basalto">{t.etiqueta}</span>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="distritos-titulo" class="border-y-2 border-basalto bg-cielo seccion-entra">
    <div class="mx-auto max-w-page px-4 py-12 md:px-6 lg:py-16">
      <h2 id="distritos-titulo" class="font-display text-2xl font-black text-basalto lg:text-3xl">Distritos de Arequipa</h2>
      <p class="mt-3 max-w-2xl text-base text-pizarra">{introSecciones.distritos}</p>
      <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
        <a href="/canchas" class="btn-tactil min-h-11 inline-flex items-center gap-2 rounded-full border-2 border-basalto bg-tiza px-5 py-2.5 font-display text-sm font-bold text-basalto shadow-dura-sm transition-all hover:bg-piedra hover:shadow-dura">
          Ver los {DISTRITOS.length} distritos <span aria-hidden="true">→</span>
        </a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-2.5">
        {distritosTop.map((d) => (
          <li>
            <a
              href={`/canchas?distrito=${encodeURIComponent(d)}`}
              class="chip-tactil"
            >
              {d}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="extras-titulo" class="mx-auto max-w-page px-4 py-12 md:px-6 lg:py-16 seccion-entra">
    <h2 id="extras-titulo" class="text-2xl lg:text-3xl">Para el resto del partido</h2>
    <p class="mt-3 max-w-2xl text-base text-pizarra">{introSecciones.extras}</p>
    <ul class="mt-6 border-t border-cal">
      {extras.map((e) => (
        <li class="grid gap-2 border-b border-cal py-5 md:grid-cols-[16rem_minmax(0,1fr)_auto] md:items-center md:gap-6">
          <h3 class="text-xl">{e.titulo}</h3>
          <p class="text-pizarra">{e.texto}</p>
          <a href={e.href} class={BOTON.texto}>{e.accion}</a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="preguntas-titulo" class="border-t-2 border-basalto bg-tiza seccion-entra">
    <div class="mx-auto max-w-texto px-4 py-12 md:px-6 lg:py-16">
      <h2 id="preguntas-titulo" class="text-2xl font-bold lg:text-3xl">Preguntas frecuentes</h2>
      <p class="mt-3 max-w-2xl text-base text-pizarra">{introSecciones.preguntas}</p>
      <div class="mt-6 border-t border-cal">
        {preguntas.map(([p, r]) => (
          <details class="group border-b border-cal">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold text-basalto [&::-webkit-details-marker]:hidden">
              {p}
              <Icon nombre="mas" class="h-5 w-5 shrink-0 text-pizarra transition-transform group-open:rotate-45" />
            </summary>
            <p class="pb-4 text-pizarra">{r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="duenos-titulo" class="border-t-2 border-basalto bg-cielo seccion-entra">
    <div class="mx-auto flex max-w-page flex-col gap-6 px-4 py-12 md:flex-row md:items-center md:justify-between md:px-6">
      <div>
        <h2 id="duenos-titulo" class="text-2xl font-bold lg:text-3xl">¿Tienes canchas en Arequipa?</h2>
        <p class="mt-2 max-w-xl text-pizarra">Publica tus horarios y recibe reservas sin contestar llamadas. Gestiona agenda, precios, caja y trabajadores desde un solo panel en el navegador; las confirmas cuando quieras.</p>
      </div>
      <Button href="/duenos" class="shrink-0">Publicar mis canchas</Button>
    </div>
  </section>
</BaseLayout>
