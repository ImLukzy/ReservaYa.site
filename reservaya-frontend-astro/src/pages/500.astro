---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Error del servidor | ReservaYa" robots="noindex, follow">
  <section class="relative left-1/2 w-screen -translate-x-1/2 bg-[#F5F5F3] px-4 py-16 md:px-8 md:py-24 text-center">
    <div class="mx-auto max-w-md">
      <p class="text-9xl font-black text-[#E7E5E4] md:text-12xl">500</p>
      <h1 class="mt-4 text-3xl font-black text-[#101613] md:text-4xl">Error interno del servidor</h1>
      <p class="mt-3 text-[#5B6660]">Algo salió mal en nuestro servidor. Nuestro equipo ya está trabajando en ello.</p>
      <a href="/" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-[#22C55E] px-6 py-3 font-bold text-white transition hover:bg-[#16A34A]">
        <span aria-hidden="true">←</span> Volver al inicio
      </a>
    </div>
  </section>
</BaseLayout>