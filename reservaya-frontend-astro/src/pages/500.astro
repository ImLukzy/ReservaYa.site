---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import { EMAIL } from "../lib/contacto";
---

<BaseLayout title="Error del servidor | ReservaYa" robots="noindex, follow">
  <section class="mx-auto max-w-texto px-4 py-16 md:px-6 lg:py-24">
    <p class="font-display text-4xl font-bold tabular-nums text-pizarra">500</p>
    <h1 class="mt-2 text-3xl lg:text-4xl">Algo falló de nuestro lado</h1>
    <p class="mt-3 text-lg text-pizarra">Vuelve a intentarlo en unos minutos. Si sigue pasando, escríbenos a {EMAIL}.</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <Button href="/">Ir al inicio</Button>
      <Button href={`mailto:${EMAIL}`} variante="secundario">Escribirnos</Button>
    </div>
  </section>
</BaseLayout>
