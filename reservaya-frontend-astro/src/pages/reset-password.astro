---
import BaseLayout from "../layouts/BaseLayout.astro";
const apiUrl = import.meta.env.PUBLIC_RESERVAYA_API_URL || "http://localhost:5000";
---

<BaseLayout
  title="Crea una nueva contraseña | ReservaYa"
  description="Elige una contraseña nueva para tu cuenta de ReservaYa."
  robots="noindex, nofollow"
  analytics={false}
>
  <section class="relative left-1/2 flex min-h-[calc(100vh-7rem)] w-screen -translate-x-1/2 items-center justify-center bg-[#060A08] px-4 py-16">
    <div class="w-full max-w-md text-center">
      <p class="text-2xl font-black tracking-tight text-white">Reserva<span class="text-[#22C55E]">Ya</span></p>
      <h1 class="mt-6 text-2xl font-extrabold text-white">Crea una nueva contraseña</h1>
      <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-white/50">El enlace vence 30 minutos después de pedirlo y sirve una sola vez.</p>

      <form id="rp-form" class="mt-8 hidden text-left" novalidate>
        <label for="rp-pass" class="mb-1.5 block text-[11px] font-bold tracking-wider text-white/50">NUEVA CONTRASEÑA</label>
        <input id="rp-pass" name="password" type="password" required minlength="6" autocomplete="new-password" aria-describedby="rp-hint"
          class="w-full rounded-xl border border-white/10 bg-white/[0.06] px-4 py-3 text-sm text-white placeholder:text-white/30 focus:border-[#22C55E] focus:outline-none focus:ring-2 focus:ring-[#22C55E]/30" />
        <p id="rp-hint" class="mt-1.5 text-xs text-white/50">Mínimo 6 caracteres.</p>

        <label for="rp-pass2" class="mt-4 mb-1.5 block text-[11px] font-bold tracking-wider text-white/50">REPITE LA CONTRASEÑA</label>
        <input id="rp-pass2" name="password2" type="password" required minlength="6" autocomplete="new-password"
          class="w-full rounded-xl border border-white/10 bg-white/[0.06] px-4 py-3 text-sm text-white placeholder:text-white/30 focus:border-[#22C55E] focus:outline-none focus:ring-2 focus:ring-[#22C55E]/30" />

        <p id="rp-status" class="hidden" role="alert"></p>
        <button id="rp-submit" type="submit" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-[#16A34A] py-3.5 font-bold text-[#060C08] transition hover:bg-[#22C55E] disabled:opacity-60">
          <span aria-hidden="true">→</span> <span id="rp-label">Guardar contraseña</span>
        </button>
      </form>

      <div id="rp-done" class="hidden">
        <div class="mx-auto mt-8 flex h-14 w-14 items-center justify-center rounded-full bg-[#22C55E]/15 text-2xl text-[#4ADE80]" aria-hidden="true">✓</div>
        <h2 class="mt-4 text-xl font-extrabold text-white">Contraseña actualizada</h2>
        <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-white/50">Por seguridad cerramos todas tus sesiones abiertas. Entra con tu nueva contraseña.</p>
        <a href="/login" class="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-[#16A34A] px-6 py-3 font-bold text-[#060C08] transition hover:bg-[#22C55E]"><span aria-hidden="true">→</span> Iniciar sesión</a>
      </div>

      <div id="rp-invalid" class="hidden">
        <div class="mx-auto mt-8 flex h-14 w-14 items-center justify-center rounded-full bg-red-500/10 text-2xl text-red-300" aria-hidden="true">!</div>
        <h2 id="rp-invalid-title" class="mt-4 text-xl font-extrabold text-white">Enlace inválido o vencido</h2>
        <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-white/50">Pide un enlace nuevo: vence a los 30 minutos y solo sirve una vez.</p>
        <a href="/forgot-password" class="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-[#16A34A] px-6 py-3 font-bold text-[#060C08] transition hover:bg-[#22C55E]"><span aria-hidden="true">→</span> Pedir un enlace nuevo</a>
      </div>

      <p class="mt-5 text-center"><a href="/login" class="text-xs font-bold text-[#4ADE80] hover:underline"><span aria-hidden="true">←</span> Volver a iniciar sesión</a></p>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ apiUrl }}>
  // El token llega en el fragmento (#t=…): no viaja a ningún servidor. Se lee y se
  // borra de la URL al instante para que no quede en el historial ni en capturas.
  const token = new URLSearchParams(location.hash.slice(1)).get("t") || "";
  if (location.hash) history.replaceState(null, "", location.pathname + location.search);
  // Abrir otro enlace estando ya en esta página solo cambia el fragmento: recargar para leerlo.
  window.addEventListener("hashchange", () => location.reload());

  const form = document.getElementById("rp-form");
  const done = document.getElementById("rp-done");
  const invalid = document.getElementById("rp-invalid");
  const invalidTitle = document.getElementById("rp-invalid-title");
  const status = document.getElementById("rp-status");
  const submit = document.getElementById("rp-submit");
  const label = document.getElementById("rp-label");
  const pass = document.getElementById("rp-pass");
  const pass2 = document.getElementById("rp-pass2");
  const ERROR_CLASS = "mt-3 rounded-xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-300";

  const mostrarError = (texto) => {
    if (!status) return;
    status.textContent = texto;
    status.className = ERROR_CLASS;
  };
  const mostrarInvalido = (titulo) => {
    form?.classList.add("hidden");
    if (invalidTitle) invalidTitle.textContent = titulo;
    invalid?.classList.remove("hidden");
  };

  if (!token) mostrarInvalido("Enlace incompleto");
  else form?.classList.remove("hidden");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(submit instanceof HTMLButtonElement) || !(pass instanceof HTMLInputElement) || !(pass2 instanceof HTMLInputElement)) return;
    if (pass.value.length < 6) {
      mostrarError("La contraseña debe tener al menos 6 caracteres.");
      pass.focus();
      return;
    }
    if (pass.value !== pass2.value) {
      mostrarError("Las contraseñas no coinciden.");
      pass2.focus();
      return;
    }
    submit.disabled = true;
    if (label) label.textContent = "Guardando...";
    if (status) status.className = "hidden";
    let res = null;
    let body = null;
    try {
      res = await fetch(`${apiUrl.replace(/\/$/, "")}/api/auth/reset-password`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token, password: pass.value }),
      });
      body = await res.json().catch(() => null);
    } catch {
      res = null;
    }
    if (res && res.ok) {
      form.classList.add("hidden");
      done?.classList.remove("hidden");
      return;
    }
    submit.disabled = false;
    if (label) label.textContent = "Guardar contraseña";
    const error = body && typeof body.error === "string" ? body.error : "";
    if (res && res.status === 400 && /enlace/i.test(error)) mostrarInvalido("Enlace inválido o vencido");
    else if (res && res.status === 400 && error) mostrarError(error);
    else if (res && res.status === 429) mostrarError("Demasiados intentos. Espera unos minutos y vuelve a intentarlo.");
    else mostrarError("No pudimos guardar la contraseña ahora. Inténtalo más tarde.");
  });
</script>
