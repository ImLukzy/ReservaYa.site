---
// Section: BookingSection
const items = [
  "Registro sencillo desde cualquier dispositivo",
  "Pagos seguros y confirmaciones automaticas",
  "Experiencia clara desde la visita hasta la reserva",
  "Proceso rapido con datos guardados"
];
---

<section class="py-20" id="booking">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] items-center">
      <div class="space-y-6">
        <p class="text-xs uppercase tracking-[0.24em]" style="color: var(--text-soft);">
          Reserva optimizada
        </p>
        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight" style="color: var(--text-main);">
          Reservas de alto nivel para clientes felices
        </h2>
        <p class="text-lg leading-relaxed" style="color: var(--text-muted);">
          ReservaYa simplifica el recorrido de tus jugadores para que elijan la cancha,
          reserven su horario y confíen en tu administración.
        </p>
        <ul class="space-y-3 text-base" style="color: var(--text-muted);">
          {items.map((item) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-1 inline-flex h-5 w-5 items-center justify-center rounded-full text-[10px] font-bold"
                style="background: rgba(239, 68, 68, 0.14); color: var(--accent-main);"
                aria-hidden="true"
              >
                &check;
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <a
          href="/recursos/actualizaciones"
          class="inline-flex items-center gap-2 text-sm font-semibold"
          style="color: var(--accent-main);"
        >
          Ver mas detalles <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="relative">
        <div class="rounded-3xl border border-gray-200/70 dark:border-gray-800/70 overflow-hidden bg-white shadow-xl">
          <img
            src="/images/unsplash/photo-1524504388940-b1c1722653e1.jpg"
            alt="Clientes reservando desde el movil"
            class="w-full aspect-[5/4] object-cover"
            loading="lazy" decoding="async"
            width="1200"
            height="960"
          />
        </div>
      </div>
    </div>
  </div>
</section>

