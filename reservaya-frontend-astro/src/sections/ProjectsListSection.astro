---
// Section: ProjectsListSection
// Seccion de proyectos destacados para la pagina de proyectos
import { Image } from "astro:assets";
import project1 from "../assets/images/project-1.jpg";
import project2 from "../assets/images/project-2.jpg";
import project3 from "../assets/images/project-3.jpg";

const projects = [
  {
    title: "Sistema editorial",
    tech: "Astro + Tailwind",
    description:
      "Arquitectura editorial escalable optimizada para SEO, performance y navegacion clara.",
    image: project1,
    scope:
      "Incluye jerarquia editorial, componentes reutilizables y estructura preparada para crecer."
  },
  {
    title: "Landing optimizada",
    tech: "SEO & Performance",
    description:
      "Landing con performance sobresaliente, contenido estructurado y metricas Lighthouse altas.",
    image: project2,
    scope:
      "Mensajes claros, llamadas a la accion visibles y experiencia ligera en mobile."
  },
  {
    title: "Design system",
    tech: "UX / UI",
    description:
      "Sistema visual coherente con componentes reutilizables y experiencia accesible.",
    image: project3,
    scope:
      "Tokens, estados y variantes para escalar producto y marketing sin friccion."
  }
];
---
<section class="py-20" id="projects-list">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-3xl mb-12 space-y-4">
      <p class="text-xs uppercase tracking-[0.24em] mb-4" style="color: var(--text-soft);">Portafolio</p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight" style="color: var(--text-main);">Proyectos</h2>
      <p class="text-lg leading-relaxed" style="color: var(--text-muted);">
        Selecciono proyectos con impacto real en negocio: sitios veloces, experiencias claras y arquitectura
        lista para crecer. Cada pieza esta pensada para comunicar valor y convertir.
      </p>
      <p class="text-base leading-relaxed" style="color: var(--text-secondary);">
        Aqui veras ejemplos de trabajo con enfoque en performance, SEO tecnico y diseno editorial.
      </p>
    </div>
    <div class="grid gap-10">
      {projects.map((project) => (
        <article class="grid gap-6 lg:grid-cols-[320px_minmax(0,1fr)] items-start">
          <div class="rounded-2xl overflow-hidden border border-gray-200/70 dark:border-gray-800/70 bg-white shadow-sm">
            <Image
              src={project.image}
              alt={`Vista previa del proyecto ${project.title}`}
              width={900}
              format="webp"
              quality={85}
              loading="lazy" decoding="async"
              class="w-full aspect-[4/3] object-cover"
            />
          </div>
          <div class="space-y-3">
            <p class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">
              {project.tech}
            </p>
            <h3 class="text-2xl font-semibold tracking-tight" style="color: var(--text-main);">
              {project.title}
            </h3>
            <p class="text-base leading-relaxed" style="color: var(--text-muted);">
              {project.description}
            </p>
            <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">
              {project.scope}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>




