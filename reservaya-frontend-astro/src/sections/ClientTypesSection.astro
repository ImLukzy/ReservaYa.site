---
// Section: ClientTypesSection
const clientTypes = [
  { icon: "JU", label: "Jugadores", href: "/ayuda" },
  { icon: "AD", label: "Administradores", href: "/ayuda" },
  { icon: "CL", label: "Complejos deportivos", href: "/canchas" },
  { icon: "FU", label: "Fútbol", href: "/canchas" },
  { icon: "TE", label: "Tenis", href: "/canchas" },
  { icon: "BA", label: "Básquet", href: "/canchas" },
  { icon: "VO", label: "Vóley", href: "/canchas" },
  { icon: "EQ", label: "Equipos", href: "/ayuda" },
  { icon: "RE", label: "Reservas frecuentes", href: "/ayuda" },
  { icon: "HO", label: "Horarios flexibles", href: "/canchas" },
  { icon: "CO", label: "Confirmación rápida", href: "/ayuda" },
  { icon: "SO", label: "Soporte", href: "/ayuda" }
];
---

<section class="py-20" id="clientes">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-3xl mx-auto mb-12 text-center">
      <p class="text-xs uppercase tracking-[0.24em] mb-4" style="color: var(--text-soft);">
        Para qui&eacute;n es
      </p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight" style="color: var(--text-main);">
        Hecho para jugadores y administradores
      </h2>
      <p class="text-lg leading-relaxed mt-4" style="color: var(--text-muted);">
        Experiencias pensadas para quienes reservan canchas y para quienes las administran,
        con claridad, velocidad y resultados que se notan en cada partido.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
      {clientTypes.map((item) => (
        <a
          href={item.href}
          class="group flex items-center gap-3 rounded-2xl border border-gray-200/60 dark:border-gray-800/70 px-4 py-4 shadow-sm transition hover:-translate-y-1 hover:shadow-md"
          style="background: var(--bg-card); text-decoration: none;"
        >
          <span
            class="flex h-10 w-10 items-center justify-center rounded-xl text-xs font-semibold uppercase"
            style="background: rgba(239, 68, 68, 0.14); color: var(--accent-main);"
            aria-hidden="true"
          >
            {item.icon}
          </span>
          <span class="text-sm font-semibold" style="color: var(--text-main);">
            {item.label}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
