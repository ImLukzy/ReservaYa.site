{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "JWT_SECRET",
        "BACKEND_URL",
        "NEXT_PUBLIC_GA_ID",
        "NEXT_PUBLIC_INBOXMEJIKAI_ENDPOINT",
        "NEXT_PUBLIC_MEDIA_URL",
        "NEXT_PUBLIC_WHATSAPP_NUMBER"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
