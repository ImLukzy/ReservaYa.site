{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "generate",
        "^build",
        "^generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "JWT_SECRET",
        "BACKEND_URL",
        "NEST_URL",
        "NEST_ROUTES",
        "COOKIE_SECURE",
        "FRONTEND_ORIGIN",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_ENDPOINT",
        "R2_BUCKET_NAME",
        "NEXT_PUBLIC_*"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "generate",
        "^build",
        "^generate"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "generate",
        "^build",
        "^generate"
      ],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
