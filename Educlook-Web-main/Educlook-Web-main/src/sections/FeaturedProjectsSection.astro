---
// Section: FeaturedProjectsSection
// Seccion de proyectos destacados para la home
import ProjectCard from "../components/ProjectCard.astro";
import project1 from "../assets/images/project-1.jpg";
import project2 from "../assets/images/project-2.jpg";
import project3 from "../assets/images/project-3.jpg";
---

<section class="py-20 bg-gray-50 dark:bg-gray-900" id="work">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-3xl mb-12">
      <p class="text-xs uppercase tracking-[0.24em] mb-4" style="color: var(--text-soft);">Casos</p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight" style="color: var(--text-main);">Proyectos destacados</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <ProjectCard
        title="Sistema editorial"
        tech="Astro + Tailwind CSS"
        description="Arquitectura editorial escalable optimizada para SEO y performance."
        image={project1}
        url="/projects#projects-list"
      />
      <ProjectCard
        title="Landing optimizada"
        tech="SEO & Core Web Vitals"
        description="Landing con performance sobresaliente y metricas Lighthouse 100."
        image={project2}
        url="/projects#projects-list"
      />
      <ProjectCard
        title="Dashboard UX"
        tech="Astro + Integraciones"
        description="Panel de control con experiencia de usuario avanzada y accesibilidad."
        image={project3}
        url="/projects#projects-list"
      />
    </div>
  </div>
</section>




