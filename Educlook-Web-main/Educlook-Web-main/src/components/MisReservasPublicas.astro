---
const apiUrl = import.meta.env.PUBLIC_RESERVAYA_API_URL || "http://localhost:5000";
const appUrl = import.meta.env.PUBLIC_RESERVAYA_APP_URL || "http://localhost:3000";
---

<section class="py-16" aria-labelledby="mis-reservas-title">
  <div class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-violet-300">Tu actividad</p>
    <h1 id="mis-reservas-title" class="mt-2 text-3xl font-black text-white md:text-4xl">Mis reservas</h1>
    <p class="mt-2 text-indigo-100">Consulta el estado y los detalles de cada solicitud.</p>
  </div>

  <div id="mis-reservas-status" class="rounded-2xl border border-indigo-200/20 bg-indigo-950/60 p-8 text-center text-indigo-100">
    Cargando tus reservas...
  </div>
  <div id="mis-reservas-grid" class="hidden space-y-4"></div>
</section>

<script define:vars={{ apiUrl, appUrl }}>
  type Reserva = {
    id: string;
    fecha: string;
    horaInicio: number;
    horaFin: number;
    estado: "PENDIENTE" | "CONFIRMADA" | "CANCELADA" | "COMPLETADA";
    total: string;
    notas: string | null;
    cancha: { nombre: string; tipo: string };
  };

  const status = document.getElementById("mis-reservas-status");
  const grid = document.getElementById("mis-reservas-grid");

  const formatDate = (value: string) => {
    const [year, month, day] = value.slice(0, 10).split("-").map(Number);
    return new Intl.DateTimeFormat("es-PE", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(new Date(year, month - 1, day));
  };

  const formatTime = (minutes: number) =>
    `${String(Math.floor(minutes / 60)).padStart(2, "0")}:${String(minutes % 60).padStart(2, "0")}`;

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    })[character] || character);

  const stateStyles: Record<Reserva["estado"], string> = {
    PENDIENTE: "border-amber-300/30 bg-amber-400/10 text-amber-200",
    CONFIRMADA: "border-emerald-300/30 bg-emerald-400/10 text-emerald-200",
    CANCELADA: "border-rose-300/30 bg-rose-400/10 text-rose-200",
    COMPLETADA: "border-sky-300/30 bg-sky-400/10 text-sky-200",
  };

  const showStatus = (message: string, isError = false) => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove("hidden");
    status.className = isError
      ? "rounded-2xl border border-rose-400/30 bg-rose-500/10 p-8 text-center text-rose-200"
      : "rounded-2xl border border-indigo-200/20 bg-indigo-950/60 p-8 text-center text-indigo-100";
  };

  const renderReservation = (reserva: Reserva) => {
    const card = document.createElement("article");
    card.className = "rounded-2xl border border-indigo-200/20 bg-indigo-950/70 p-5 shadow-lg md:p-6";
    const canchaTipo = escapeHtml(reserva.cancha.tipo);
    const canchaNombre = escapeHtml(reserva.cancha.nombre);
    const total = escapeHtml(reserva.total);
    const notas = reserva.notas ? escapeHtml(reserva.notas) : "";
    card.innerHTML = `
      <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-300">${canchaTipo}</p>
          <h2 class="mt-1 text-xl font-bold text-white">${canchaNombre}</h2>
          <p class="mt-2 text-sm capitalize text-indigo-200">${formatDate(reserva.fecha)}</p>
        </div>
        <span class="w-fit rounded-full border px-3 py-1 text-xs font-bold ${stateStyles[reserva.estado]}">${reserva.estado}</span>
      </div>
      <div class="mt-5 grid gap-3 border-t border-indigo-200/15 pt-4 text-sm sm:grid-cols-3">
        <div><p class="text-xs uppercase tracking-wide text-indigo-300">Horario</p><p class="mt-1 font-semibold text-white">${formatTime(reserva.horaInicio)} - ${formatTime(reserva.horaFin)}</p></div>
        <div><p class="text-xs uppercase tracking-wide text-indigo-300">Total</p><p class="mt-1 font-semibold text-white">S/ ${total}</p></div>
        <div><p class="text-xs uppercase tracking-wide text-indigo-300">Código</p><p class="mt-1 font-semibold text-white">${reserva.estado === "CONFIRMADA" ? reserva.id.slice(-6).toUpperCase() : "Pendiente de confirmación"}</p></div>
      </div>
      ${notas ? `<p class="mt-4 rounded-xl bg-indigo-900/60 px-4 py-3 text-sm text-indigo-100"><strong class="text-white">Nota:</strong> ${notas}</p>` : ""}
      ${reserva.estado === "PENDIENTE" ? `<button type="button" data-cancel-id="${escapeHtml(reserva.id)}" class="mt-5 rounded-lg border border-rose-300/30 px-3 py-2 text-sm font-semibold text-rose-200 transition hover:bg-rose-400/10">Cancelar solicitud</button>` : ""}
    `;
    return card;
  };

  const loadReservations = async () => {
    const response = await fetch(`${apiUrl}/api/reservas`, { credentials: "include" });
    const body = await response.json().catch(() => null);
    if (response.status === 401 || response.status === 403) {
      window.location.href = `${appUrl}/login?returnUrl=/mis-reservas`;
      return null;
    }
    if (!response.ok) throw new Error(body?.error || "No se pudieron cargar tus reservas.");
    return body?.reservas as Reserva[];
  };

  const renderReservations = (reservas: Reserva[]) => {
    if (!status || !grid) return;
    reservas.sort((a, b) => `${b.fecha}-${String(b.horaInicio).padStart(4, "0")}`.localeCompare(`${a.fecha}-${String(a.horaInicio).padStart(4, "0")}`));
    status.classList.add("hidden");
    if (reservas.length === 0) {
      grid.replaceChildren();
      grid.classList.add("hidden");
      showStatus("Todavía no tienes reservas. Explora las canchas disponibles para solicitar un horario.");
      return;
    }
    grid.replaceChildren(...reservas.map(renderReservation));
    grid.classList.remove("hidden");
  };

  grid?.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    const reservationId = target.dataset.cancelId;
    if (!reservationId || !window.confirm("¿Quieres cancelar esta solicitud?")) return;

    target.disabled = true;
    target.textContent = "Cancelando...";
    try {
      const response = await fetch(`${apiUrl}/api/reservas/${encodeURIComponent(reservationId)}`, {
        method: "PATCH",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ estado: "CANCELADA" }),
      });
      const body = await response.json().catch(() => null);
      if (response.status === 401 || response.status === 403) {
        window.location.href = `${appUrl}/login?returnUrl=/mis-reservas`;
        return;
      }
      if (!response.ok) throw new Error(body?.error || "No se pudo cancelar la solicitud.");
      const reservas = await loadReservations();
      if (reservas) renderReservations(reservas);
    } catch (error) {
      target.disabled = false;
      target.textContent = "Cancelar solicitud";
      showStatus(error instanceof Error ? error.message : "No se pudo cancelar la solicitud.", true);
    }
  });

  loadReservations()
    .then((reservas) => {
      if (!reservas) return;
      renderReservations(reservas);
    })
    .catch((error: Error) => showStatus(error.message, true));
</script>
