---
// Component: StickyDemoForm
---

<div class="demo-form rounded-2xl border bg-transparent shadow-none">
  <form class="grid gap-5 p-8 md:p-10" autocomplete="off" data-inbox="inboxMejikai">
    <div class="grid gap-5 md:grid-cols-2">
      <div>
        <label class="demo-label block text-lg font-medium mb-2">
          Nombre <span class="req-asterisk">*</span>
        </label>
        <input
          type="text"
          name="firstName"
          placeholder="Tu nombre"
          required
          class="demo-input w-full h-12 rounded-md border bg-transparent px-4 text-sm"
        />
      </div>
      <div>
        <label class="demo-label block text-lg font-medium mb-2">
          Apellido <span class="req-asterisk">*</span>
        </label>
        <input
          type="text"
          name="lastName"
          placeholder="Tu apellido"
          required
          class="demo-input w-full h-12 rounded-md border bg-transparent px-4 text-sm"
        />
      </div>
    </div>

    <div>
      <label class="demo-label block text-lg font-medium mb-2">
        Nombre de empresa <span class="req-asterisk">*</span>
      </label>
      <input
        type="text"
        name="company"
        placeholder="Nombre de empresa"
        required
        class="demo-input w-full h-12 rounded-md border bg-transparent px-4 text-sm"
      />
    </div>

    <div>
      <label class="demo-label block text-lg font-medium mb-2">
        Correo electr&oacute;nico <span class="req-asterisk">*</span>
      </label>
      <input
        type="email"
        name="email"
        placeholder="Correo electr&oacute;nico"
        required
        class="demo-input w-full h-12 rounded-md border bg-transparent px-4 text-sm"
      />
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <div>
        <label class="demo-label block text-lg font-medium mb-2">
          Sitio web <span class="req-asterisk">*</span>
        </label>
        <input
          type="url"
          name="website"
          placeholder="Sitio web"
          required
          class="demo-input w-full h-12 rounded-md border bg-transparent px-4 text-sm"
        />
      </div>
      <div>
        <label class="demo-label block text-lg font-medium mb-2">
          Tel&eacute;fono <span class="req-asterisk">*</span>
        </label>
        <div class="flex gap-3">
          <select
            name="countryCode"
            class="demo-select country-select h-12 shrink-0 rounded-md border bg-transparent text-xs"
          >
            <option value="+51">+51</option>
            <option value="+1">+1</option>
            <option value="+34">+34</option>
            <option value="+52">+52</option>
            <option value="+54">+54</option>
            <option value="+57">+57</option>
            <option value="+56">+56</option>
            <option value="+55">+55</option>
          </select>
          <input
            type="tel"
            name="phone"
            placeholder="N&uacute;mero de tel&eacute;fono"
            required
            class="demo-input h-12 flex-1 min-w-0 rounded-md border bg-transparent px-4 text-sm"
          />
        </div>
      </div>
    </div>

    <div class="pt-3">
      <button
        type="submit"
        data-submit
        class="inline-flex items-center justify-center rounded-md px-6 py-2.5 text-sm font-semibold text-white shadow-lg transition focus:outline-none focus:ring-2"
        style="background: var(--accent-main); box-shadow: 0 12px 28px -18px color-mix(in srgb, var(--accent-main) 55%, transparent); font-family: 'Poppins', 'Segoe UI', Arial, sans-serif; letter-spacing: 0.02em;"
      >
        Solicitar demo
      </button>
      <p class="mt-3 text-xs" data-status style="color: var(--text-secondary);"></p>
    </div>
  </form>
</div>

<style>
  .demo-form {
    border-color: var(--border-main);
  }

  .demo-label {
    color: var(--text-main);
  }

  .demo-input,
  .demo-select {
    color: var(--input-text);
    border-color: var(--border-main);
  }

  .demo-input::placeholder {
    color: var(--input-placeholder);
  }

  .demo-input:focus,
  .demo-select:focus {
    outline: none;
    border-color: var(--accent-main);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-main) 28%, transparent);
  }

  .req-asterisk {
    color: var(--accent-main) !important;
  }

  .country-select {
    width: fit-content;
    min-width: 0;
    padding: 0 1.2rem 0 0.5rem;
    letter-spacing: 0.02em;
  }

  .demo-form button:hover {
    background: var(--accent-hover);
  }

  .demo-form button:focus-visible {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-main) 35%, transparent);
  }
</style>


