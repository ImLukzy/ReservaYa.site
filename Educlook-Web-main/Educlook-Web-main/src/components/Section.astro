---
// Component: Section
interface Props {
  title?: string;
  subtitle?: string;
  variant?: "default" | "muted";
}

const {
  title,
  subtitle,
  variant = "default"
} = Astro.props;

const variantStyles = {
  default: "",
  muted: "bg-gray-50 dark:bg-gray-900"
};
---

<section
  class={`relative py-20 md:py-28 ${variantStyles[variant]}`}
>
  <div
    class="max-w-5xl mx-auto px-6 space-y-8"
  >

    {(title || subtitle) && (
      <header class="space-y-4 max-w-2xl">
        {title && (
          <h2
            class="text-3xl md:text-4xl font-semibold tracking-tight
                   text-gray-900 dark:text-white"
          >
            {title}
          </h2>
        )}

        {subtitle && (
          <p
            class="text-base md:text-lg text-gray-600 dark:text-gray-400
                   leading-relaxed"
          >
            {subtitle}
          </p>
        )}
      </header>
    )}

    
    <div class="relative">
      <slot />
    </div>

  </div>
</section>


