---
// Page: forgot-password
import BaseLayout from "../layouts/BaseLayout.astro";

---

<BaseLayout title="Olvid&eacute; mi contrase&ntilde;a" robots="noindex, follow">
  <section class="min-h-[80vh] flex items-center justify-center px-4" style="background: linear-gradient(135deg, var(--bg-muted), var(--bg-main));">
    <div class="w-full max-w-md rounded-2xl shadow-xl p-8 md:p-10 space-y-8" style="background: var(--bg-card); border: 1px solid var(--border-main);">
      <h1 class="text-2xl md:text-3xl font-bold text-center mb-2 tracking-tight" style="color: var(--text-main);">
        &iquest;Olvidaste tu contrase&ntilde;a?
      </h1>
      <p class="text-center mb-6" style="color: var(--text-muted);">
        Ingresa el correo electr&oacute;nico asociado a tu cuenta y te enviaremos un enlace para restablecer tu contrase&ntilde;a.
      </p>
      <form class="space-y-6">
        <div>
          <label class="block text-sm font-medium mb-2" style="color: var(--text-main);">
            Correo electr&oacute;nico
          </label>
          <input
            type="email"
            required
            placeholder="tucorreo@email.com"
            class="w-full border rounded-md px-4 py-3 focus:outline-none focus:ring-2"
            style="border-color: var(--border-main); background: var(--input-bg); color: var(--input-text);"
          />
        </div>
        <button
          type="submit"
          class="w-full py-3 rounded-lg font-semibold shadow-md transition-all duration-200"
          style="background: var(--accent-main); color: #ffffff;"
        >
          Enviar enlace de restablecimiento
        </button>
      </form>
      <div class="relative flex items-center py-2">
        <div class="flex-grow" style="border-top: 1px solid var(--border-main);"></div>
        <span class="mx-4 text-xs" style="color: var(--text-soft);">o</span>
        <div class="flex-grow" style="border-top: 1px solid var(--border-main);"></div>
      </div>
      <div class="text-center text-sm pt-2" style="color: var(--text-muted);">
        <a href="/login" class="font-medium hover:underline" style="color: var(--accent-main);">Volver a iniciar sesi&oacute;n</a>
      </div>
    </div>
  </section>
</BaseLayout>


