---
import BaseLayout from "../../layouts/BaseLayout.astro";

const opportunities = [
  {
    title: "Cancha de fútbol - demanda nocturna",
    budget: "S/ 80",
    priority: "Alta",
    match: "96% fit",
    summary: "Jugadores buscan canchas disponibles por las noches para partidos entre semana."
  },
  {
    title: "Cancha de tenis - horarios de mañana",
    budget: "S/ 50",
    priority: "Media",
    match: "92% fit",
    summary: "Buscan canchas de tenis disponibles en horarios matutinos para entrenar."
  },
  {
    title: "Cancha de básquet - fin de semana",
    budget: "S/ 90",
    priority: "Alta",
    match: "94% fit",
    summary: "Equipos necesitan canchas de básquet los fines de semana para sus partidos."
  }
];
---

<BaseLayout
  title="Administra tus canchas | ReservaYa"
  description="Publica tu oferta de canchas y conecta con jugadores listos para reservar."
>
  <main id="main-content" class="py-16">
    <section class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.24em]" style="color: var(--text-soft);">Marketplace</p>
        <h1 class="mt-3 text-3xl md:text-5xl font-semibold tracking-tight" style="color: var(--text-main);">
          Para proveedores: publica tu oferta y recibe oportunidades
        </h1>
        <p class="mt-4 text-lg leading-relaxed" style="color: var(--text-muted);">
          Este flujo esta diseñado para administradores y complejos que ofrecen canchas deportivas.
          Registras tu espacio y el sistema te conecta con jugadores que buscan reservar.
        </p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <article class="rounded-2xl border p-6" style="border-color: var(--border-main); background: var(--bg-card);">
        <h2 class="text-xl font-semibold" style="color: var(--text-main);">Publicar cancha</h2>
        <p class="mt-2 text-sm" style="color: var(--text-muted);">Completa tu propuesta y habla directo con la coordinación de complejos deportivos.</p>

        <form id="mp-provider-form" class="mt-5 grid gap-4">
          <div>
            <label for="mp-name" class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">Complejo / Cancha</label>
            <input id="mp-name" type="text" class="mt-2 w-full rounded-xl border px-4 py-2.5 text-sm" placeholder="Ej. Complejo Deportivo Norte" style="border-color: var(--border-main); background: var(--bg-main); color: var(--text-main);" />
          </div>
          <div>
            <label for="mp-specialty" class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">Deporte / tipo</label>
            <select id="mp-specialty" class="mt-2 w-full rounded-xl border px-4 py-2.5 text-sm" style="border-color: var(--border-main); background: var(--bg-main); color: var(--text-main);">
              <option>Fútbol</option>
              <option>Tenis</option>
              <option>Básquet</option>
              <option>Vóley</option>
            </select>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="mp-ticket-min" class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">Precio hora mín.</label>
              <input id="mp-ticket-min" type="text" class="mt-2 w-full rounded-xl border px-4 py-2.5 text-sm" placeholder="S/ 40" style="border-color: var(--border-main); background: var(--bg-main); color: var(--text-main);" />
            </div>
            <div>
              <label for="mp-ticket-max" class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">Precio hora máx.</label>
              <input id="mp-ticket-max" type="text" class="mt-2 w-full rounded-xl border px-4 py-2.5 text-sm" placeholder="S/ 120" style="border-color: var(--border-main); background: var(--bg-main); color: var(--text-main);" />
            </div>
          </div>
          <div>
            <label for="mp-detail" class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">Descripción de la cancha</label>
            <textarea id="mp-detail" rows="4" class="mt-2 w-full rounded-xl border px-4 py-2.5 text-sm" placeholder="Explica las características, horarios y capacidad de tu cancha..." style="border-color: var(--border-main); background: var(--bg-main); color: var(--text-main);"></textarea>
          </div>
          <button type="submit" class="inline-flex items-center justify-center rounded-xl px-4 py-2.5 text-sm font-semibold" style="background: var(--accent-main); color: var(--accent-contrast);">
            Hablar con coordinación de complejos
          </button>
          <p class="text-xs" style="color: var(--text-soft);">Se abrira un correo con tu cancha resumida.</p>
        </form>

        <div id="hablar-coordinador" class="mt-6 rounded-xl border p-4" style="border-color: var(--border-main);">
          <p class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">Contacto directo</p>
          <h3 class="mt-2 text-base font-semibold" style="color: var(--text-main);">Luis Herrera - Coordinación de complejos</h3>
          <div class="mt-3 flex flex-wrap gap-2 text-sm">
            <a href="mailto:soporte@reservaya.com?subject=Publicar%20cancha%20-%20Registro%20de%20complejo" class="inline-flex items-center rounded-lg border px-3 py-2 font-semibold" style="border-color: var(--border-main); color: var(--text-main);">
              soporte@reservaya.com
            </a>
            <a href="/empresa/colaboraciones" class="inline-flex items-center rounded-lg px-3 py-2 font-semibold" style="background: var(--accent-main); color: var(--accent-contrast);">
              Ver detalle de colaboracion
            </a>
          </div>
        </div>
      </article>

      <article class="rounded-2xl border p-6" style="border-color: var(--border-main); background: color-mix(in srgb, var(--accent-main) 5%, var(--bg-card) 95%);">
        <h2 class="text-xl font-semibold" style="color: var(--text-main);">Solicitudes sugeridas</h2>
        <p class="mt-2 text-sm" style="color: var(--text-muted);">Horarios que encajan con el tipo de cancha que ofreces.</p>
        <div class="mt-5 grid gap-3">
          {opportunities.map((opportunity) => (
            <article class="rounded-xl border p-4" style="border-color: var(--border-main);">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-sm font-semibold" style="color: var(--text-main);">{opportunity.title}</h3>
                <span class="text-xs px-2 py-1 rounded-full" style="background: color-mix(in srgb, var(--accent-main) 18%, transparent); color: var(--accent-main);">{opportunity.match}</span>
              </div>
              <p class="mt-2 text-sm" style="color: var(--text-muted);">{opportunity.summary}</p>
              <div class="mt-3 flex flex-wrap gap-2 text-xs" style="color: var(--text-soft);">
                <span>Presupuesto: {opportunity.budget}</span>
                <span>Prioridad: {opportunity.priority}</span>
              </div>
            </article>
          ))}
        </div>
      </article>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  const form = document.getElementById("mp-provider-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const studio = document.getElementById("mp-name")?.value || "Proveedor sin nombre";
    const specialty = document.getElementById("mp-specialty")?.value || "Especialidad no definida";
    const min = document.getElementById("mp-ticket-min")?.value || "No indicado";
    const max = document.getElementById("mp-ticket-max")?.value || "No indicado";
    const detail = document.getElementById("mp-detail")?.value || "Sin detalle adicional";
    const subject = encodeURIComponent(`Cancha a publicar - ${studio}`);
    const body = encodeURIComponent(
      `Hola Luis,\n\nQuiero publicar mi cancha en ReservaYa.\n\nComplejo: ${studio}\nDeporte: ${specialty}\nPrecio hora mínimo: ${min}\nPrecio hora máximo: ${max}\nDescripción: ${detail}\n\nQuedo atento(a).`
    );
    window.location.href = `mailto:soporte@reservaya.com?subject=${subject}&body=${body}`;
  });
</script>
