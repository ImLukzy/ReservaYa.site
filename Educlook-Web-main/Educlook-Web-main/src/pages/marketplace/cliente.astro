---
import BaseLayout from "../../layouts/BaseLayout.astro";

const requests = [
  {
    title: "Cancha de fútbol - sábado 18:00",
    budget: "S/ 80 - S/ 120",
    timeline: "2 horas",
    profile: "Fútbol",
    need: "Buscamos reservar una cancha de fútbol para nuestro partido del sábado por la noche."
  },
  {
    title: "Cancha de tenis - mañana",
    budget: "S/ 40 - S/ 70",
    timeline: "1 hora",
    profile: "Tenis",
    need: "Necesitamos una cancha de tenis disponible por las mañanas para entrenar."
  },
  {
    title: "Cancha de básquet - entre semana",
    budget: "S/ 60 - S/ 100",
    timeline: "2 horas",
    profile: "Básquet",
    need: "Buscamos reservar una cancha de básquet entre semana para jugar con el equipo."
  }
];
---

<BaseLayout
  title="Reserva tu cancha | ReservaYa"
  description="Publica tu solicitud de horario y conecta con los administradores de canchas en ReservaYa."
>
  <main id="main-content" class="py-16">
    <section class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.24em]" style="color: var(--text-soft);">Marketplace</p>
        <h1 class="mt-3 text-3xl md:text-5xl font-semibold tracking-tight" style="color: var(--text-main);">
          Para clientes: publica tu necesidad y recibe propuestas
        </h1>
        <p class="mt-4 text-lg leading-relaxed" style="color: var(--text-muted);">
          Este espacio esta pensado para jugadores y equipos que buscan una cancha.
          Publicas tu solicitud de horario y el administrador la revisa para confirmarte tu reserva.
        </p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <article class="rounded-2xl border p-6" style="border-color: var(--border-main); background: var(--bg-card);">
        <h2 class="text-xl font-semibold" style="color: var(--text-main);">Solicitar horario</h2>
        <p class="mt-2 text-sm" style="color: var(--text-muted);">Completa los datos y abre contacto directo con el administrador de la cancha.</p>

        <form id="mp-client-form" class="mt-5 grid gap-4">
          <div>
            <label for="mc-company" class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">Nombre del equipo</label>
            <input id="mc-company" type="text" class="mt-2 w-full rounded-xl border px-4 py-2.5 text-sm" placeholder="Nombre de tu equipo" style="border-color: var(--border-main); background: var(--bg-main); color: var(--text-main);" />
          </div>
          <div>
            <label for="mc-goal" class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">Deporte</label>
            <select id="mc-goal" class="mt-2 w-full rounded-xl border px-4 py-2.5 text-sm" style="border-color: var(--border-main); background: var(--bg-main); color: var(--text-main);">
              <option>Fútbol</option>
              <option>Tenis</option>
              <option>Básquet</option>
              <option>Vóley</option>
            </select>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="mc-budget" class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">Hora de inicio</label>
              <input id="mc-budget" type="text" class="mt-2 w-full rounded-xl border px-4 py-2.5 text-sm" placeholder="Ej. 18:00" style="border-color: var(--border-main); background: var(--bg-main); color: var(--text-main);" />
            </div>
            <div>
              <label for="mc-time" class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">Duración</label>
              <select id="mc-time" class="mt-2 w-full rounded-xl border px-4 py-2.5 text-sm" style="border-color: var(--border-main); background: var(--bg-main); color: var(--text-main);">
                <option>1 hora</option>
                <option>2 horas</option>
                <option>3 horas</option>
              </select>
            </div>
          </div>
          <div>
            <label for="mc-detail" class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">Detalle</label>
            <textarea id="mc-detail" rows="4" class="mt-2 w-full rounded-xl border px-4 py-2.5 text-sm" placeholder="Describe la fecha, horario preferido y cualquier indicación para el administrador..." style="border-color: var(--border-main); background: var(--bg-main); color: var(--text-main);"></textarea>
          </div>
          <button type="submit" class="inline-flex items-center justify-center rounded-xl px-4 py-2.5 text-sm font-semibold" style="background: var(--accent-main); color: var(--accent-contrast);">
            Hablar con el administrador
          </button>
          <p class="text-xs" style="color: var(--text-soft);">Se abrira un correo con el resumen para respuesta directa.</p>
        </form>

        <div id="hablar-asesor" class="mt-6 rounded-xl border p-4" style="border-color: var(--border-main);">
          <p class="text-xs uppercase tracking-[0.2em]" style="color: var(--text-soft);">Contacto directo</p>
          <h3 class="mt-2 text-base font-semibold" style="color: var(--text-main);">Andrea Ruiz - Administradora de canchas</h3>
          <div class="mt-3 flex flex-wrap gap-2 text-sm">
            <a href="mailto:contacto@reservaya.com?subject=Reserva%20de%20cancha%20-%20Solicitud%20de%20horario" class="inline-flex items-center rounded-lg border px-3 py-2 font-semibold" style="border-color: var(--border-main); color: var(--text-main);">
              contacto@reservaya.com
            </a>
            <a href="/empresa/contacto" class="inline-flex items-center rounded-lg px-3 py-2 font-semibold" style="background: var(--accent-main); color: var(--accent-contrast);">
              Ver canal de contacto
            </a>
          </div>
        </div>
      </article>

      <article class="rounded-2xl border p-6" style="border-color: var(--border-main); background: color-mix(in srgb, var(--accent-main) 5%, var(--bg-card) 95%);">
        <h2 class="text-xl font-semibold" style="color: var(--text-main);">Solicitudes activas</h2>
        <p class="mt-2 text-sm" style="color: var(--text-muted);">Ejemplos de solicitudes de horario publicadas por otros equipos.</p>
        <div class="mt-5 grid gap-3">
          {requests.map((request) => (
            <article class="rounded-xl border p-4" style="border-color: var(--border-main);">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-sm font-semibold" style="color: var(--text-main);">{request.title}</h3>
                <span class="text-xs px-2 py-1 rounded-full" style="background: color-mix(in srgb, var(--accent-main) 18%, transparent); color: var(--accent-main);">{request.profile}</span>
              </div>
              <p class="mt-2 text-sm" style="color: var(--text-muted);">{request.need}</p>
              <div class="mt-3 flex flex-wrap gap-2 text-xs" style="color: var(--text-soft);">
                <span>Presupuesto: {request.budget}</span>
                <span>Plazo: {request.timeline}</span>
              </div>
            </article>
          ))}
        </div>
      </article>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  const form = document.getElementById("mp-client-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const company = document.getElementById("mc-company")?.value || "Empresa sin nombre";
    const goal = document.getElementById("mc-goal")?.value || "Objetivo no definido";
    const budget = document.getElementById("mc-budget")?.value || "No indicado";
    const time = document.getElementById("mc-time")?.value || "No indicado";
    const detail = document.getElementById("mc-detail")?.value || "Sin detalle adicional";
    const subject = encodeURIComponent(`Solicitud de cancha - ${company}`);
    const body = encodeURIComponent(
      `Hola Andrea,\n\nQuiero solicitar una cancha desde ReservaYa.\n\nEquipo: ${company}\nDeporte: ${goal}\nHora de inicio: ${budget}\nDuración: ${time}\nDetalle: ${detail}\n\nQuedo atento(a).`
    );
    window.location.href = `mailto:contacto@reservaya.com?subject=${subject}&body=${body}`;
  });
</script>
