---
// Page: [slug]
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Section from "../../components/Section.astro";

/* ================= STATIC PATHS ================= */
export async function getStaticPaths() {
  const posts = (await getCollection("blog")) as CollectionEntry<"blog">[];

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const postUrl = new URL(`/blog/${post.slug}`, Astro.site?.toString() || "https://reservaya.com");
const postImage = post.data.image || "/og-default.png";
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  image: new URL(postImage, Astro.site?.toString() || "https://reservaya.com").toString(),
  datePublished: post.data.date.toISOString(),
  author: {
    "@type": "Person",
    name: "ReservaYa"
  },
  publisher: {
    "@type": "Organization",
    name: "ReservaYa",
    logo: {
      "@type": "ImageObject",
      url: `${Astro.site?.toString() || "https://reservaya.com"}/favicon.svg`
    }
  },
  mainEntityOfPage: postUrl.toString()
};
---

<BaseLayout
  title={`${post.data.title} - ReservaYa`}
  description={post.data.description}
  image={postImage}
>
  <script slot="head" type="application/ld+json">
    {JSON.stringify(articleSchema)}
  </script>

  
  <Section>

    <article
      class="max-w-3xl mx-auto
             space-y-10
             pt-4 md:pt-8"
    >

      
      <header class="space-y-4">

        <time
          datetime={post.data.date.toISOString()}
          class="text-sm text-gray-500 tracking-wide"
        >
          {post.data.date.toLocaleDateString("es-ES", {
            year: "numeric",
            month: "long",
            day: "numeric"
          })}
        </time>

        <h1
          class="text-4xl md:text-5xl lg:text-6xl
                 font-semibold tracking-tight leading-[1.15]"
        >
          {post.data.title}
        </h1>

        {post.data.description && (
          <p
            class="text-lg text-gray-600 dark:text-gray-400
                   max-w-2xl leading-relaxed"
          >
            {post.data.description}
          </p>
        )}

      </header>

      
      <hr class="border-gray-200 dark:border-gray-800" />

      
      <div
        class="prose prose-lg
               prose-headings:tracking-tight
               prose-headings:font-semibold
               prose-p:text-gray-700
               dark:prose-invert
               dark:prose-p:text-gray-300
               prose-img:rounded-2xl
               prose-img:shadow-lg
               max-w-none"
      >
        <slot />
      </div>

      
      <footer
        class="pt-12 mt-12
               border-t border-gray-200 dark:border-gray-800
               flex flex-col sm:flex-row
               justify-between gap-6 text-sm text-gray-500"
      >

        <div>
          Publicado en <span class="font-medium text-gray-700 dark:text-gray-300">ReservaYa</span>
        </div>

        <a
          href="/blog"
          class="inline-flex items-center gap-2
                 font-medium text-gray-900 dark:text-gray-200
                 hover:underline"
        >
          &larr; Volver al blog
        </a>

      </footer>

    </article>

  </Section>


</BaseLayout>
